+/* Host quota counters, read only when userspace requests a profile snapshot. */
+int uml_fp_host_cpu(unsigned long long *periods, unsigned long long *throttled)
+{
+	char line[128];
+	int found = 0;
+	FILE *f = fopen("/sys/fs/cgroup/cpu.stat", "r");
+	if (!f)
+		return -errno;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "nr_periods %llu", periods) == 1)
+			found |= 1;
+		if (sscanf(line, "nr_throttled %llu", throttled) == 1)
+			found |= 2;
+	}
+	fclose(f);
+	return found == 3 ? 0 : -EINVAL;
+}
