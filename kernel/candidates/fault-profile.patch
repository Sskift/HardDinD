+// SPDX-License-Identifier: GPL-2.0
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/kstrtox.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <asm/page.h>
+#include <init.h>
+#include <fault-profile.h>
+
+int uml_fault_profile;
+EXPORT_SYMBOL(uml_fault_profile);
+unsigned long long uml_fp_values[UML_FP_COUNT];
+unsigned long long uml_fp_clock(void)
+{
+	return unlikely(uml_fault_profile) ? ktime_get_ns() : 0;
+}
+void uml_fp_zero_done(unsigned long long started)
+{
+	uml_fp_add(UML_FP_zero_ns, uml_fp_clock() - started);
+	uml_fp_add(UML_FP_zero_pages, 1);
+}
+void uml_fault_profile_clear(void *page)
+{
+	unsigned long long start = uml_fp_clock();
+	memset(page, 0, PAGE_SIZE);
+	uml_fp_zero_done(start);
+}
+EXPORT_SYMBOL(uml_fault_profile_clear);
+static int fault_profile_show(struct seq_file *m, void *v)
+{
+	unsigned long long periods = 0, throttled = 0;
+	seq_puts(m, "# machine-wide; nested wall times are not additive; includes background tasks\n"
+		 "# batch_ns includes broker handoff; host_* counts submitted commands\n");
+	seq_printf(m, "enabled %d\n", uml_fault_profile);
+#define UML_FP_SHOW(name) seq_printf(m, #name " %llu\n", \
+	__atomic_load_n(&uml_fp_values[UML_FP_##name], __ATOMIC_RELAXED));
+	UML_FP_FIELDS(UML_FP_SHOW)
+#undef UML_FP_SHOW
+	if (!uml_fp_host_cpu(&periods, &throttled)) {
+		seq_printf(m, "host_periods %llu\nhost_throttled %llu\n", periods, throttled);
+	}
+	return 0;
+}
+DEFINE_PROC_SHOW_ATTRIBUTE(fault_profile);
+static int __init fault_profile_init(void)
+{
+	return proc_create("uml_fault_profile", 0444, NULL, &fault_profile_proc_ops) ? 0 : -ENOMEM;
+}
+__initcall(fault_profile_init);
+static int __init fault_profile_setup(char *line, int *add)
+{
+	unsigned int enable;
+	*add = 0;
+	if (kstrtouint(line, 10, &enable) || enable > 1) {
+		pr_warn("uml_fault_profile requires 0 or 1\n");
+		return 0;
+	}
+	uml_fault_profile = enable;
+	return 0;
+}
+__uml_setup("uml_fault_profile=", fault_profile_setup,
+"uml_fault_profile=<0|1>\n"
+"    Default 0. Time fault handling, page clearing and mapping batches.\n"
+"    Read /proc/uml_fault_profile. Timers include scheduling delays.\n\n");
