From: HardDinD developers
Subject: [DIAGNOSTIC] um: time faults, clearing and coalesced mapping batches

Default off: uml_fault_profile=1. No syscall entry or runner handoff changes.
Wall times include preemption; zero and batch times nest inside other totals.
Counters are machine-wide and include background work. The MMAP stub records
TSC cycles around the host syscall; convert with the probe's measured tsc_hz.
Its two fields fit the existing padding before the aligned GPU payload.

--- /dev/null
+++ b/arch/um/include/shared/fault-profile.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef UML_FAULT_PROFILE_H
+#define UML_FAULT_PROFILE_H
+#define UML_FP_FIELDS(X) \
+	X(user_faults) X(user_fault_ns) X(zero_pages) X(zero_ns) \
+	X(syncs) X(sync_ns) X(batches) X(batch_ns) X(failed_batches) \
+	X(map_requests) X(map_pages) X(map_coalesced) \
+	X(host_mmap) X(host_mmap_pages) X(host_mmap_cycles) X(host_munmap)
+#define UML_FP_ENUM(name) UML_FP_##name,
+enum { UML_FP_FIELDS(UML_FP_ENUM) UML_FP_COUNT };
+#undef UML_FP_ENUM
+extern int uml_fault_profile;
+extern unsigned long long uml_fp_values[UML_FP_COUNT];
+extern unsigned long long uml_fp_clock(void);
+extern void uml_fp_zero_done(unsigned long long started);
+extern int uml_fp_host_cpu(unsigned long long *, unsigned long long *);
+static inline void uml_fp_add(unsigned int id, unsigned long long value)
+{
+	if (__builtin_expect(uml_fault_profile, 0))
+		__atomic_fetch_add(&uml_fp_values[id], value, __ATOMIC_RELAXED);
+}
+#endif
