+// SPDX-License-Identifier: GPL-2.0
+/*
+ * HARDDIND optional seccomp clock/getcpu fast path (round20).
+ *
+ * The seccomp SIGSYS handler in arch/um/kernel/skas/stub.c can answer
+ * getcpu() and clock_gettime(CLOCK_MONOTONIC) inside the trapped task
+ * itself, without the futex rendezvous with a vCPU host thread and the full
+ * guest syscall entry path.  This file only decides whether that is
+ * semantically safe for @current and publishes the data the stub handler
+ * consumes.
+ *
+ * It is enabled with harddind_clock_fastpath=1 (default 0) and every
+ * published word is revalidated every time the kernel returns to
+ * userspace, so changing conditions (a newly installed seccomp filter,
+ * ptrace, a time-namespace join, guest time steering) degrade to the
+ * unchanged full-emulation path on the next dispatch.
+ *
+ * Semantics preserved:
+ *  - getcpu returns the GUEST cpu/node id (raw_smp_processor_id(), per vCPU
+ *    runner); a host getcpu syscall is never issued.
+ *  - clock_gettime returns a guest value derived from the same host
+ *    CLOCK_MONOTONIC that backs the UML "timer" clocksource, with a kernel
+ *    computed epoch offset; see arch/um/kernel/time.c.
+ *  - guest seccomp filters are honored using the kernel's own constant-allow
+ *    action cache (seccomp_const_allow_nr()): a syscall is fast-pathed only
+ *    when every installed filter provably returns SECCOMP_RET_ALLOW for it
+ *    regardless of arguments and instruction pointer.  Filters returning
+ *    TRAP/ERRNO/TRACE/LOG/USER_NOTIF/KILL keep the slow path.
+ *  - ptrace syscall tracing keeps the slow path.
+ *  - tasks in time namespaces with non-zero offsets keep the slow path
+ *    (zero-offset namespaces are indistinguishable from the init ns).
+ *  - any guest time steering (settimeofday/adjtimex/offset injection)
+ *    permanently disables the clock fast path until reboot.
+ *
+ * Copyright (C) 2026 HardDinD
+ */
+
+#include <linux/sched.h>
+#include <linux/ptrace.h>
+#include <linux/seccomp.h>
+#include <linux/time_namespace.h>
+#include <linux/topology.h>
+#include <asm/unistd.h>
+#include <stub-data.h>
+
+/* arch/um/kernel/time.c */
+extern unsigned int harddind_clock_fastpath;
+extern bool um_fastpath_clock_valid(void);
+extern s64 um_fastpath_mono_delta(void);
+
+#ifndef CONFIG_SECCOMP
+void um_fastpath_publish(void *data)
+{
+	/* No guest seccomp support in this configuration: keep the stub
+	 * conservative (its data is zero-allocated, nothing to clear). */
+}
+#else
+
+static bool um_fastpath_timens_zero(void)
+{
+	const struct time_namespace *ns;
+
+	if (!current->nsproxy)
+		return false;
+	ns = current->nsproxy->time_ns;
+	if (ns == &init_time_ns)
+		return true;
+
+	return ns->offsets.monotonic.tv_sec == 0 &&
+	       ns->offsets.monotonic.tv_nsec == 0 &&
+	       ns->offsets.boottime.tv_sec == 0 &&
+	       ns->offsets.boottime.tv_nsec == 0;
+}
+
+/*
+ * Publish (or clear) the per-runner fast path state.  Called on every
+ * userspace dispatch by the seccomp code in os-Linux/skas/process.c, while
+ * the runner is parked.  @data points at that runner's struct stub_data.
+ */
+void um_fastpath_publish(void *data)
+{
+	struct stub_data *d = data;
+	const int cpu = raw_smp_processor_id();
+	unsigned int feat = 0;
+	bool filtered;
+
+	if (!harddind_clock_fastpath)
+		/* Immutable boot parameter; runner data is zero-allocated and
+		 * never otherwise written, so the default hot path stays
+		 * identical to a kernel without this patch. */
+		return;
+
+	/* Any debugger attachment: emulate every syscall. */
+	if (current->ptrace & PT_PTRACED)
+		goto out;
+
+	filtered = current->seccomp.mode == SECCOMP_MODE_FILTER;
+	if (!filtered && current->seccomp.mode != SECCOMP_MODE_DISABLED)
+		goto out;
+
+	if (filtered ? seccomp_const_allow_nr(__NR_getcpu) : true)
+		feat |= UM_FAST_FEAT_GETCPU;
+
+	if (um_fastpath_clock_valid() && um_fastpath_timens_zero() &&
+	    (filtered ? seccomp_const_allow_nr(__NR_clock_gettime) : true)) {
+		feat |= UM_FAST_FEAT_MONO;
+		WRITE_ONCE(d->fast_mono_delta, um_fastpath_mono_delta());
+	}
+
+	WRITE_ONCE(d->fast_guest_cpu, cpu);
+	WRITE_ONCE(d->fast_guest_node, cpu_to_node(cpu));
+	/* Publish data first, features last: the handler runs in another
+	 * host thread and pairs this with an acquire (futex rendezvous is a
+	 * release/acquire boundary on top). */
+	smp_store_release(&d->fast_features, feat);
+	return;
+
+out:
+	WRITE_ONCE(d->fast_features, 0);
+}
+#endif /* CONFIG_SECCOMP */
