+++ b/arch/um/include/shared/core-profile.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_CORE_PROFILE_H
+#define __UM_CORE_PROFILE_H
+
+#define UML_SP_STAGES(X) \
+	X(prepare) X(get_state) X(receive) X(exit_work) X(clock_pair) X(trace_enter) X(seccomp) X(body) X(trace_leave) \
+	X(forward) X(reply) X(return_gap) \
+	X(kernel_ready) X(kernel_spin) X(kernel_futex) X(kernel_eagain) \
+	X(runner_ready) X(runner_spin) X(runner_futex) X(runner_eagain) \
+	X(idle) X(mapping_batch) X(syscall) X(clone_ok) X(exec_ok) X(task_exit)
+#define UML_SP_ENUM(n) UML_SP_##n,
+enum { UML_SP_STAGES(UML_SP_ENUM) UML_SP_COUNT };
+#undef UML_SP_ENUM
+extern int uml_sp_enabled;
+unsigned long long uml_sp_begin(unsigned int stage);
+void uml_sp_add(unsigned int stage, unsigned long long cycles);
+void uml_sp_count(unsigned int stage, unsigned int count);
+void uml_sp_syscall(unsigned long nr);
+void uml_sp_mark(unsigned int stage, unsigned long long *stamp);
+
+/* The stub cannot call functions outside its relocated code mapping. */
+static inline __attribute__((always_inline)) unsigned long long uml_sp_clock(void)
+{
+#ifdef __x86_64__
+	unsigned int lo, hi;
+	asm volatile("lfence; rdtsc; lfence" : "=a"(lo), "=d"(hi) : : "memory");
+	return ((unsigned long long)hi << 32) | lo;
+#else
+	return 0;
+#endif
+}
+
+/* Spread samples across periodic syscall patterns (e.g. read/write pairs). */
+static inline int uml_sp_sample(unsigned long long sequence)
+{
+    return (sequence * 0x9e3779b97f4a7c15ULL) >> 56 == 0;
+}
+
+struct uml_sp_stub {
+	unsigned int enabled, sequence, active, valid;
+	unsigned long long ready, release, resume, reply, gap;
+	unsigned int ready_hits, spin_hits, sleeps, races;
+};
+
+/* Publish on the existing release/acquire rendezvous; never reset a futex. */
+static inline __attribute__((always_inline)) void uml_sp_enter(struct uml_sp_stub *p, int eligible)
+{
+	if (!p->enabled)
+		return;
+	if (p->resume && eligible) {
+		p->gap = uml_sp_clock() - p->resume;
+		p->valid |= 2;
+	}
+	p->resume = 0;
+	p->active = eligible && uml_sp_sample(++p->sequence);
+}
+
+static inline __attribute__((always_inline)) void uml_sp_replied(struct uml_sp_stub *p)
+{
+	if (p->active) {
+		p->reply = uml_sp_clock() - p->release;
+		p->valid |= 1;
+	}
+}
+#endif
