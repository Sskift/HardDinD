+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kstrtox.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/smp.h>
+#include <init.h>
+#include <os.h>
+#include <core-profile.h>
+
+int uml_sp_enabled;
+static unsigned long tsc_khz;
+static unsigned long long syscall_counts[512];
+static unsigned long long histogram[UML_SP_COUNT][32];
+static struct {
+	unsigned long long sequence[UML_SP_COUNT];
+	unsigned long long count[UML_SP_COUNT], cycles[UML_SP_COUNT];
+} __aligned(64) stats[CONFIG_NR_CPUS];
+
+unsigned long long uml_sp_begin(unsigned int stage)
+{
+	unsigned int cpu;
+	unsigned long long first, second;
+	if (!uml_sp_enabled)
+		return 0;
+	cpu = raw_smp_processor_id();
+	if (!uml_sp_sample(__atomic_add_fetch(&stats[cpu].sequence[stage], 1, __ATOMIC_RELAXED)))
+		return 0;
+	first = uml_sp_clock();
+	second = uml_sp_clock();
+	uml_sp_add(UML_SP_clock_pair, second - first);
+	return uml_sp_clock();
+}
+
+void uml_sp_add(unsigned int stage, unsigned long long cycles)
+{
+	unsigned int cpu = raw_smp_processor_id();
+	__atomic_fetch_add(&stats[cpu].count[stage], 1, __ATOMIC_RELAXED);
+	if (cycles) {
+		unsigned int bin = min_t(unsigned int, 63 - __builtin_clzll(cycles), 31);
+		__atomic_fetch_add(&stats[cpu].cycles[stage], cycles, __ATOMIC_RELAXED);
+		__atomic_fetch_add(&histogram[stage][bin], 1, __ATOMIC_RELAXED);
+	}
+}
+
+void uml_sp_count(unsigned int stage, unsigned int count)
+{
+	unsigned int cpu = raw_smp_processor_id();
+	if (count)
+		__atomic_fetch_add(&stats[cpu].count[stage], count, __ATOMIC_RELAXED);
+}
+
+void uml_sp_mark(unsigned int stage, unsigned long long *stamp)
+{
+	unsigned long long now;
+	if (!*stamp)
+		return;
+	now = uml_sp_clock();
+	uml_sp_add(stage, now - *stamp);
+	/* Keep accounting and histogram updates outside the next interval. */
+	*stamp = uml_sp_clock();
+}
+
+void uml_sp_syscall(unsigned long nr)
+{
+	if (!uml_sp_enabled)
+		return;
+	uml_sp_count(UML_SP_syscall, 1);
+	if (nr < ARRAY_SIZE(syscall_counts))
+		__atomic_fetch_add(&syscall_counts[nr], 1, __ATOMIC_RELAXED);
+}
+
+static int profile_show(struct seq_file *m, void *unused)
+{
+	unsigned int cpu, bin;
+	seq_printf(m, "enabled %d\ntsc_khz %lu\nsample_period 256\n", uml_sp_enabled, tsc_khz);
+	for (cpu = 0; cpu < CONFIG_NR_CPUS; cpu++) {
+		seq_printf(m, "cpu%u_profiled_syscalls %llu\n", cpu,
+			__atomic_load_n(&stats[cpu].sequence[UML_SP_trace_enter], __ATOMIC_RELAXED));
+#define SHOW(n) seq_printf(m, "cpu%u_" #n "_count %llu\ncpu%u_" #n "_cycles %llu\n", \
+	cpu, __atomic_load_n(&stats[cpu].count[UML_SP_##n], __ATOMIC_RELAXED), \
+	cpu, __atomic_load_n(&stats[cpu].cycles[UML_SP_##n], __ATOMIC_RELAXED));
+		UML_SP_STAGES(SHOW)
+#undef SHOW
+	}
+	for (bin = 0; bin < ARRAY_SIZE(syscall_counts); bin++)
+		seq_printf(m, "syscall_nr%u %llu\n", bin,
+			__atomic_load_n(&syscall_counts[bin], __ATOMIC_RELAXED));
+	for (bin = 0; bin < 32; bin++) {
+#define HIST(n) seq_printf(m, #n "_bin%u %llu\n", bin, \
+	__atomic_load_n(&histogram[UML_SP_##n][bin], __ATOMIC_RELAXED));
+		UML_SP_STAGES(HIST)
+#undef HIST
+	}
+	return 0;
+}
+DEFINE_PROC_SHOW_ATTRIBUTE(profile);
+
+static int __init profile_init(void)
+{
+	tsc_khz = os_vdso_tsc_khz();
+	if (uml_sp_enabled && !tsc_khz)
+		panic("uml_syscall_profile requires invariant host TSC with known frequency");
+	return proc_create("uml_syscall_profile", 0400, NULL, &profile_proc_ops) ? 0 : -ENOMEM;
+}
+__initcall(profile_init);
+
+static int __init profile_setup(char *line, int *add)
+{
+	unsigned int enable;
+	*add = 0;
+	if (kstrtouint(line, 10, &enable) || enable > 1) {
+		pr_warn("uml_syscall_profile requires 0 or 1\n");
+		return 0;
+	}
+	uml_sp_enabled = enable;
+	return 0;
+}
+__uml_setup("uml_syscall_profile=", profile_setup,
+"uml_syscall_profile=<0|1>\n"
+"    Default off. Sample syscall phases every 256 calls; per-CPU TSC totals\n"
+"    and spin/futex counts in /proc/uml_syscall_profile. Diagnostic only.\n");
