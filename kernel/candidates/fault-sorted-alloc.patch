--- /dev/null
+++ b/arch/um/include/shared/fault-sorted.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef UML_FAULT_SORTED_H
+#define UML_FAULT_SORTED_H
+struct page;
+struct task_struct;
+struct vm_area_struct;
+struct uml_fault_pool {
+	struct task_struct *owner;
+	struct vm_area_struct *vma;
+	struct page **pages;
+	struct page *local_pages[32];
+	unsigned long start, end;
+	unsigned int count, used;
+};
+void uml_fault_pool_begin(struct uml_fault_pool *, struct vm_area_struct *,
+			  unsigned long, unsigned long);
+void uml_fault_pool_end(struct uml_fault_pool *);
+#endif
--- /dev/null
+++ b/arch/um/kernel/fault-sorted.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/export.h>
+#include <linux/gfp.h>
+#include <linux/highmem.h>
+#include <linux/init.h>
+#include <linux/kstrtox.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <asm/pgtable.h>
+#include <fault-sorted.h>
+#include <init.h>
+
+static unsigned int uml_fault_sorted;
+
+static bool uml_fault_pool_matches(const struct uml_fault_pool *pool,
+		const struct vm_area_struct *vma, unsigned long address,
+		const struct task_struct *task)
+{
+	return pool->owner == task && pool->vma == vma &&
+	       address >= pool->start && address < pool->end &&
+	       pool->used < pool->count;
+}
+
+static int uml_fault_pfn_compare(const void *left, const void *right)
+{
+	unsigned long a = page_to_pfn(*(struct page * const *)left);
+	unsigned long b = page_to_pfn(*(struct page * const *)right);
+
+	return (a > b) - (a < b);
+}
+
+void uml_fault_pool_begin(struct uml_fault_pool *pool, struct vm_area_struct *vma,
+			  unsigned long start, unsigned long end)
+{
+	unsigned long address;
+	unsigned int count = 0;
+	pmd_t *pmd;
+	pte_t *pte, *entry;
+	spinlock_t *ptl;
+	gfp_t gfp = (GFP_HIGHUSER_MOVABLE & ~__GFP_RECLAIM) |
+		    __GFP_NOWARN | __GFP_NOMEMALLOC;
+
+	pool->pages = NULL;
+	/* Keep VMA/task NUMA policy in the original allocator. */
+	if (!uml_fault_sorted || current->thread.fault_pool ||
+	    IS_ENABLED(CONFIG_NUMA) || end <= start ||
+	    end - start > 512 * PAGE_SIZE ||
+	    (start & PMD_MASK) != ((end - PAGE_SIZE) & PMD_MASK))
+		return;
+	pmd = pmd_off(vma->vm_mm, start);
+	if (!pmd_present(READ_ONCE(*pmd)))
+		return;
+	pte = pte_offset_map_lock(vma->vm_mm, pmd, start, &ptl);
+	if (!pte)
+		return;
+	for (address = start, entry = pte; address < end; address += PAGE_SIZE, entry++)
+		count += pte_none(READ_ONCE(*entry));
+	pte_unmap_unlock(pte, ptl);
+	if (count < 4)
+		return;
+	if (count <= ARRAY_SIZE(pool->local_pages)) {
+		pool->pages = pool->local_pages;
+		memset(pool->pages, 0, count * sizeof(*pool->pages));
+	} else {
+		pool->pages = kcalloc(count, sizeof(*pool->pages), GFP_NOWAIT | __GFP_NOWARN);
+	}
+	if (!pool->pages)
+		return;
+	pool->count = alloc_pages_bulk(gfp, count, pool->pages);
+	pool->used = 0;
+	sort(pool->pages, pool->count, sizeof(*pool->pages), uml_fault_pfn_compare, NULL);
+	pool->owner = current;
+	pool->vma = vma;
+	pool->start = start;
+	pool->end = end;
+	/* Only this task consumes the pool. Scheduling preserves the owner;
+	 * copy_thread resets the child's thread through INIT_THREAD. */
+	current->thread.fault_pool = pool;
+}
+
+static struct folio *uml_fault_pool_take(struct vm_area_struct *vma, unsigned long address)
+{
+	struct uml_fault_pool *pool;
+
+	if (!uml_fault_sorted)
+		return NULL;
+	pool = current->thread.fault_pool;
+	if (!pool || !uml_fault_pool_matches(pool, vma, address, current))
+		return NULL;
+	return page_folio(pool->pages[pool->used++]);
+}
+
+struct folio *uml_vma_alloc_zeroed_movable_folio(struct vm_area_struct *vma,
+					      unsigned long address)
+{
+	struct folio *folio = uml_fault_pool_take(vma, address);
+
+	if (!folio)
+		folio = vma_alloc_folio(GFP_HIGHUSER_MOVABLE, 0, vma, address);
+	if (folio && user_alloc_needs_zeroing())
+		clear_user_highpage(&folio->page, address);
+	return folio;
+}
+EXPORT_SYMBOL(uml_vma_alloc_zeroed_movable_folio);
+
+void uml_fault_pool_end(struct uml_fault_pool *pool)
+{
+	if (!pool->pages)
+		return;
+	/* Unpublish before freeing, including a partially consumed pool on OOM. */
+	current->thread.fault_pool = NULL;
+	while (pool->used < pool->count)
+		__free_page(pool->pages[pool->used++]);
+	if (pool->pages != pool->local_pages)
+		kfree(pool->pages);
+	pool->pages = NULL;
+}
+
+static int __init uml_fault_sorted_setup(char *line, int *add)
+{
+	unsigned int enable;
+
+	*add = 0;
+	if (kstrtouint(line, 10, &enable) || enable > 1) {
+		pr_warn("uml_fault_sorted requires 0 or 1\n");
+		return 0;
+	}
+	uml_fault_sorted = enable;
+	return 0;
+}
+__uml_setup("uml_fault_sorted=", uml_fault_sorted_setup,
+"uml_fault_sorted=<0|1>\n"
+"    Default 0. Sort a bounded order-0 page pool by PFN for one anonymous\n"
+"    prefault window, improving host mmap coalescing after reuse.\n"
+"    No reclaim or high-order allocation. Pages are normally cleared and\n"
+"    charged by the anonymous fault path; unused pages are released on\n"
+"    window exit. The temporary pool holds at most 512 pages before charge.\n"
+"    Each task owns its current window; the default 32-page window uses\n"
+"    an inline pointer array. Guest NUMA uses the original allocation policy.\n\n");
