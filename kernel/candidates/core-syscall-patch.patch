+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/highmem.h>
+#include <linux/sched/mm.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/atomic.h>
+#include <linux/percpu.h>
+#include <asm/cacheflush.h>
+#include <asm/unistd.h>
+#include <as-layout.h>
+#include <core-patch.h>
+#include <os.h>
+#include <skas.h>
+#include <stub-data.h>
+#include <sysdep/ptrace.h>
+
+int uml_syscall_patch;
+static atomic64_t patched;
+static DEFINE_PER_CPU(unsigned long, patch_calls);
+extern char __syscall_stub_start[], stub_fast_entry[];
+
+static int __init patch_setup(char *s)
+{
+	int value;
+	if (kstrtoint(s, 0, &value) || (value != 0 && value != 1))
+		return 0;
+	uml_syscall_patch = value;
+	return 1;
+}
+__setup("uml_syscall_patch=", patch_setup);
+
+void uml_patch_enter(struct mm_struct *mm)
+{
+	if (!uml_syscall_patch)
+		return;
+	for (;;) {
+		wait_event(mm->context.patch_wait, !READ_ONCE(mm->context.patch_stopping));
+		down_read(&mm->context.patch_run);
+		if (!READ_ONCE(mm->context.patch_stopping))
+			break;
+		up_read(&mm->context.patch_run);
+	}
+}
+
+void uml_patch_exit(struct mm_struct *mm)
+{
+	if (uml_syscall_patch)
+		up_read(&mm->context.patch_run);
+}
+
+void uml_patch_forget(struct mm_struct *mm, unsigned long start, unsigned long end)
+{
+    if (!uml_syscall_patch)
+        return;
+    for (unsigned int i = 0; i < ARRAY_SIZE(mm->context.patch_miss); i++) {
+        unsigned long ip = READ_ONCE(mm->context.patch_miss[i]);
+        if (ip && ip - 1 >= start && ip - 1 < end)
+            WRITE_ONCE(mm->context.patch_miss[i], 0);
+    }
+}
+
+static void stop_mm(struct mm_struct *mm)
+{
+	WRITE_ONCE(mm->context.patch_stopping, 1);
+	smp_mb();
+	for (int cpu = 0; cpu < NR_CPUS; cpu++) {
+		int pid = READ_ONCE(mm->context.cpu_ids[cpu].pid);
+		if (pid > 1)
+			os_alarm_process(pid);
+	}
+	down_write(&mm->context.patch_run);
+}
+
+static void resume_mm(struct mm_struct *mm)
+{
+	up_write(&mm->context.patch_run);
+	WRITE_ONCE(mm->context.patch_stopping, 0);
+	wake_up_all(&mm->context.patch_wait);
+}
+
+#define PATCH_MAGIC 0x554d4c5041544348ULL
+struct patch_header { u64 magic; u64 next; };
+
+int uml_patch_setup(void)
+{
+	struct patch_header h = { PATCH_MAGIC, 1 };
+	unsigned long addr;
+
+	if (!uml_syscall_patch || !parallel_userspace)
+		return 0;
+	addr = vm_mmap(NULL, UML_PATCH_BASE, UML_PATCH_END - UML_PATCH_BASE,
+		       PROT_READ | PROT_EXEC,
+		       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, 0);
+	if (addr != UML_PATCH_BASE)
+		return 0;
+	if (access_process_vm(current, addr, &h, sizeof(h), FOLL_FORCE | FOLL_WRITE) != sizeof(h))
+		vm_munmap(addr, UML_PATCH_END - UML_PATCH_BASE);
+	return 0;
+}
+
+static bool eligible(unsigned long nr)
+{
+	switch (nr) {
+	case __NR_clone: case __NR_clone3: case __NR_fork: case __NR_vfork:
+	case __NR_execve: case __NR_execveat: case __NR_rt_sigreturn:
+	case __NR_exit: case __NR_exit_group: case __NR_restart_syscall:
+		return false;
+	default:
+		return nr < __NR_syscalls;
+	}
+}
+
+/* All writes hold mmap_lock and a FOLL_FORCE|FOLL_WRITE reference. This is
+ * the access_process_vm COW path, with one lock covering the whole rewrite. */
+static struct page *write_page(struct mm_struct *mm, unsigned long addr)
+{
+	struct vm_area_struct *vma = find_vma(mm, addr);
+	struct page *page;
+	if (!vma || vma->vm_start > addr || (vma->vm_flags & (VM_SHARED | VM_WRITE)) ||
+	    !(vma->vm_flags & VM_EXEC) || !(vma->vm_flags & VM_MAYWRITE))
+		return NULL;
+	if (get_user_pages_remote(mm, addr & PAGE_MASK, 1,
+				  FOLL_FORCE | FOLL_WRITE, &page, NULL) != 1)
+		return NULL;
+	return page;
+}
+
+static void write_bytes(struct mm_struct *mm, struct page *page, unsigned long addr,
+			const void *src, unsigned int len)
+{
+	void *dst = kmap_local_page(page);
+	copy_to_user_page(find_vma(mm, addr), page, addr, dst + offset_in_page(addr), src, len);
+	kunmap_local(dst);
+	set_page_dirty_lock(page);
+}
+
+void uml_patch_syscall(struct uml_pt_regs *r)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long end = UPT_IP(r), addr, slot, nr = PT_SYSCALL_NR(r->gp);
+	unsigned char old[9], jump[9] = { 0xff, 0x24, 0x25, 0, 0, 0, 0, 0x06, 0x06 };
+	/* gettid; scale/add lookup base; load runner; jump to common save code. */
+	unsigned char code[UML_PATCH_SLOT] = {
+		[8] = 0xb8, 186, 0, 0, 0, 0x0f, 0x05,
+		0x48, 0x03, 0x41, 49, 0x0f, 0xb6, 0x00,
+		0x48, 0xc1, 0xe0, 14, 0x48, 0x03, 0x41, 57,
+		0xff, 0x61, 65,
+	};
+	struct patch_header h;
+	struct page *text = NULL, *entry = NULL, *header = NULL, *previous = NULL;
+	struct vm_area_struct *vma;
+	unsigned char window[23];
+	unsigned int before = 14, offset, split;
+	void *bytes;
+	u64 value;
+	u32 imm;
+	unsigned int len = 7;
+
+    if (!uml_syscall_patch || r->fast_syscall || !parallel_userspace || !mm || !eligible(nr) ||
+        end < UML_PATCH_END + sizeof(old) || end >= TASK_SIZE)
+        return;
+    if (READ_ONCE(mm->context.patch_miss[(end >> 3) & 63]) == end)
+        return;
+    WRITE_ONCE(mm->context.patch_miss[(end >> 3) & 63], end);
+    /* A seven-byte site may begin at a VMA boundary: do not read before it. */
+    if (access_process_vm(current, end - 7, old + 2, 7, FOLL_FORCE) != 7)
+        return;
+    if (!uml_patch_pattern(old + 2, 7, nr)) {
+        if (access_process_vm(current, end - 9, old, 9, FOLL_FORCE) != 9 ||
+            !uml_patch_pattern(old, 9, nr))
+            return;
+        len = 9;
+    }
+    imm = nr;
+	addr = end - len;
+	if (offset_in_page(addr) + len > PAGE_SIZE)
+		return;
+	mutex_lock(&mm->context.patch_lock);
+	if (mm->context.patch_debug)
+		goto unlock;
+	if (access_process_vm(current, UML_PATCH_BASE, &h, sizeof(h), FOLL_FORCE) != sizeof(h) ||
+	    h.magic != PATCH_MAGIC || h.next < 1 || h.next >= (UML_PATCH_END - UML_PATCH_BASE) / UML_PATCH_SLOT)
+		goto unlock;
+	slot = UML_PATCH_BASE + h.next * UML_PATCH_SLOT;
+	mmap_read_lock(mm);
+	text = write_page(mm, addr);
+	entry = write_page(mm, slot);
+	if (entry && (slot & PAGE_MASK) == UML_PATCH_BASE) {
+		header = entry;
+		get_page(header);
+	} else {
+		header = write_page(mm, UML_PATCH_BASE);
+	}
+	if (!text || !entry || !header)
+		goto out;
+	/* Pin any preceding page before parking runners; never trust writable or
+	 * shared bytes for instruction boundaries. An unmapped page is a boundary. */
+	offset = offset_in_page(addr);
+	split = offset < before ? before - offset : 0;
+	if (split) {
+		vma = find_vma(mm, addr - offset - 1);
+		if (!vma || vma->vm_start > addr - offset - 1) {
+			before = offset;
+			split = 0;
+		} else if ((vma->vm_flags & (VM_SHARED | VM_WRITE)) ||
+			   !(vma->vm_flags & VM_EXEC) ||
+			   get_user_pages_remote(mm, (addr & PAGE_MASK) - PAGE_SIZE, 1,
+					 FOLL_FORCE, &previous, NULL) != 1) {
+			goto out;
+		}
+	}
+	stop_mm(mm);
+	if (previous) {
+		bytes = kmap_local_page(previous);
+		memcpy(window, bytes + PAGE_SIZE - split, split);
+		kunmap_local(bytes);
+	}
+	bytes = kmap_local_page(text);
+	memcpy(window + split, bytes + (offset + split - before), before + len - split);
+	if (!uml_patch_boundary(window, before, len)) {
+		kunmap_local(bytes);
+		resume_mm(mm);
+		goto out;
+	}
+	if (memcmp(bytes + offset_in_page(addr), old + sizeof(old) - len, len)) {
+		kunmap_local(bytes);
+		resume_mm(mm);
+		goto out;
+	}
+	kunmap_local(bytes);
+	value = slot + 8; memcpy(code, &value, 8);
+	memcpy(code + 40, &imm, 4);
+	value = end; memcpy(code + 48, &value, 8);
+	code[88] = len; memcpy(code + 89, old + sizeof(old) - len, len);
+	value = STUB_TID_TABLE; memcpy(code + 64, &value, 8);
+	value = STUB_THREAD_DATA(0) - STUB_THREAD_PAGES * UM_KERN_PAGE_SIZE;
+	memcpy(code + 72, &value, 8);
+	value = STUB_CODE + (unsigned long)stub_fast_entry - (unsigned long)__syscall_stub_start;
+	memcpy(code + 80, &value, 8);
+	write_bytes(mm, entry, slot, code, sizeof(code));
+	h.next++;
+	write_bytes(mm, header, UML_PATCH_BASE, &h, sizeof(h));
+	imm = slot; memcpy(jump + 3, &imm, 4);
+	/* Stop-before-write also covers a runner already past the original MOV.
+	 * The byte at its old SYSCALL remains invalid in the final jump. */
+	old[0] = 0x06;
+	write_bytes(mm, text, addr, old, 1);
+	smp_wmb();
+	write_bytes(mm, text, addr + 1, jump + 1, len - 1);
+	smp_wmb();
+	write_bytes(mm, text, addr, jump, 1);
+	for (int cpu = 0; cpu < NR_CPUS; cpu++) {
+        struct stub_data *d = (void *)mm->context.cpu_ids[cpu].stack;
+        if (d)
+            WRITE_ONCE(d->fast_enabled, READ_ONCE(d->fast_enabled) | 2);
+    }
+    atomic64_inc(&patched);
+	resume_mm(mm);
+out:
+	if (previous) put_page(previous);
+	if (header) put_page(header);
+	if (entry) put_page(entry);
+	if (text) put_page(text);
+	mmap_read_unlock(mm);
+unlock:
+	mutex_unlock(&mm->context.patch_lock);
+}
+
+/* Return with patch_lock held, including when this mm has no patch table. */
+static int patch_restore(struct mm_struct *mm, unsigned long start, unsigned long end, bool all)
+{
+    struct patch_header h;
+    int error = 0;
+
+    mutex_lock(&mm->context.patch_lock);
+    if (access_remote_vm(mm, UML_PATCH_BASE, &h, sizeof(h), FOLL_FORCE) != sizeof(h) ||
+        h.magic != PATCH_MAGIC || h.next < 1 || h.next > (UML_PATCH_END - UML_PATCH_BASE) / UML_PATCH_SLOT)
+        return 1;
+    for (unsigned long i = 1; i < h.next; i++) {
+        unsigned char code[UML_PATCH_SLOT], jump[9] = {0xff,0x24,0x25,0,0,0,0,0x06,0x06};
+        unsigned long slot = UML_PATCH_BASE + i * UML_PATCH_SLOT, addr;
+        unsigned int len;
+        struct vm_area_struct *vma;
+        struct page *page = NULL;
+        u64 return_ip;
+        u32 imm = slot, nr;
+        void *bytes;
+
+        if (access_remote_vm(mm, slot, code, sizeof(code), FOLL_FORCE) != sizeof(code))
+            continue;
+        memcpy(&return_ip, code + 48, 8);
+        memcpy(&nr, code + 40, 4);
+        len = code[88];
+        if (!uml_patch_pattern(code + 89, len, nr) || return_ip < UML_PATCH_END + len ||
+            return_ip >= TASK_SIZE)
+            continue;
+        addr = return_ip - len;
+        if ((!all && (addr >= end || return_ip <= start)) || offset_in_page(addr) + len > PAGE_SIZE)
+            continue;
+        memcpy(jump + 3, &imm, 4);
+        mmap_read_lock(mm);
+        vma = find_vma(mm, addr);
+        if (!vma || vma->vm_start > addr || (vma->vm_flags & VM_SHARED) ||
+            !(vma->vm_flags & VM_MAYWRITE))
+            goto next;
+        if (get_user_pages_remote(mm, addr & PAGE_MASK, 1, FOLL_FORCE | FOLL_WRITE, &page, NULL) != 1) {
+            error = -ENOMEM;
+            goto next;
+        }
+        stop_mm(mm);
+        bytes = kmap_local_page(page);
+        if (!memcmp(bytes + offset_in_page(addr), jump, len)) {
+            unsigned char trap = 0x06;
+            kunmap_local(bytes);
+            write_bytes(mm, page, addr, &trap, 1);
+            smp_wmb();
+            write_bytes(mm, page, addr + 1, code + 90, len - 1);
+            smp_wmb();
+            write_bytes(mm, page, addr, code + 89, 1);
+            uml_patch_forget(mm, addr, return_ip);
+            for (int cpu = 0; cpu < NR_CPUS; cpu++) {
+                struct stub_data *d = (void *)mm->context.cpu_ids[cpu].stack;
+                if (d) WRITE_ONCE(d->fast_enabled, READ_ONCE(d->fast_enabled) | 2);
+            }
+        } else {
+            kunmap_local(bytes);
+        }
+        resume_mm(mm);
+next:
+        if (page) put_page(page);
+        mmap_read_unlock(mm);
+        if (error) {
+            mutex_unlock(&mm->context.patch_lock);
+            return error;
+        }
+    }
+    return 1;
+}
+
+/* Keep the patch mutex through a mapping syscall so another thread cannot
+ * install a new site after restoration but before the VMA is moved. */
+int uml_patch_prepare(int syscall, struct uml_pt_regs *r)
+{
+    struct mm_struct *mm = current->mm;
+    unsigned long start = UPT_SYSCALL_ARG1(r), size = UPT_SYSCALL_ARG2(r), end;
+    bool all = false;
+
+    if (!uml_syscall_patch || !parallel_userspace || !mm)
+        return 0;
+    size = PAGE_ALIGN(size);
+    end = size > ULONG_MAX - start ? ULONG_MAX : start + size;
+    switch (syscall) {
+    case __NR_mremap:
+        if ((UPT_SYSCALL_ARG4(r) & MREMAP_FIXED) &&
+            UPT_SYSCALL_ARG5(r) < UML_PATCH_END &&
+            UPT_SYSCALL_ARG3(r) > UML_PATCH_BASE - min(UPT_SYSCALL_ARG5(r), (unsigned long)UML_PATCH_BASE))
+            all = true;
+        break;
+    case __NR_mmap:
+        if (!(UPT_SYSCALL_ARG4(r) & MAP_FIXED))
+            return 0;
+        fallthrough;
+    case __NR_mprotect: case __NR_pkey_mprotect:
+        if (UPT_SYSCALL_ARG3(r) & PROT_WRITE)
+            break;
+        fallthrough;
+    case __NR_munmap: case __NR_madvise:
+        if (start >= UML_PATCH_END || end <= UML_PATCH_BASE)
+            return 0;
+        break;
+    default:
+        return 0;
+    }
+    all |= start < UML_PATCH_END && end > UML_PATCH_BASE;
+    return patch_restore(mm, start, end, all);
+}
+
+int uml_patch_write_begin(struct mm_struct *mm, unsigned long addr, int len)
+{
+    unsigned long end;
+
+    if (!uml_syscall_patch || !parallel_userspace || len <= 0)
+        return 0;
+    end = len > ULONG_MAX - addr ? ULONG_MAX : addr + len;
+    return patch_restore(mm, addr, end, addr < UML_PATCH_END && end > UML_PATCH_BASE);
+}
+
+void uml_patch_write_end(struct mm_struct *mm)
+{
+    mutex_unlock(&mm->context.patch_lock);
+}
+
+int uml_patch_step(struct task_struct *task)
+{
+    struct mm_struct *mm;
+    int held;
+
+    if (!uml_syscall_patch || !parallel_userspace)
+        return 0;
+    mm = get_task_mm(task);
+    if (!mm)
+        return 0;
+    held = patch_restore(mm, 0, ULONG_MAX, true);
+    if (held > 0) {
+        /* Sticky until exec: another thread must not repatch a stepped site. */
+        mm->context.patch_debug = true;
+        uml_patch_write_end(mm);
+    }
+    mmput(mm);
+    return held < 0 ? held : 0;
+}
+
+void uml_patch_done(void)
+{
+    mutex_unlock(&current->mm->context.patch_lock);
+}
+
+int uml_patch_fault(struct uml_pt_regs *r)
+{
+	unsigned char code[9];
+	unsigned long ip = UPT_IP(r);
+	u32 slot;
+	u64 end;
+
+	if (!uml_syscall_patch || !parallel_userspace || ip < UML_PATCH_END + 7)
+		return 0;
+	for (int offset = 5; offset <= 7; offset += 2) {
+		if (access_process_vm(current, ip - offset, code, offset + 2, FOLL_FORCE) != offset + 2 ||
+		    code[0] != 0xff || code[1] != 0x24 || code[2] != 0x25 || code[offset] != 0x06)
+			continue;
+		memcpy(&slot, code + 3, 4);
+		if (slot < UML_PATCH_BASE + UML_PATCH_SLOT || slot >= UML_PATCH_END || slot % UML_PATCH_SLOT)
+			continue;
+		if (access_process_vm(current, slot + 48, &end, sizeof(end), FOLL_FORCE) != sizeof(end) || end != ip + 2)
+			continue;
+		r->fast_syscall = 1;
+		UPT_IP(r) = end;
+		PT_SYSCALL_NR(r->gp) = UPT_AX(r);
+		return 1;
+	}
+	return 0;
+}
