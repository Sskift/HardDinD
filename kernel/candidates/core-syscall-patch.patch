+
+/* Reject any instruction stream crossing the proposed MOV boundary that
+ * can also reach the observed SYSCALL. False negatives keep SIGSYS. */
+int uml_patch_boundary(const unsigned char *p, unsigned int before, unsigned int len)
+{
+    unsigned int syscall = before + len - 2;
+    struct insn insn;
+    for (unsigned int start = 0; start < before; start++) {
+        unsigned int pos = start;
+        if (insn_decode(&insn, p + pos, before + len - pos, INSN_MODE_64))
+            continue;
+        pos += insn.length;
+        if (pos <= before)
+            continue;
+        while (pos < syscall) {
+            if (insn_decode(&insn, p + pos, before + len - pos, INSN_MODE_64))
+                break;
+            pos += insn.length;
+        }
+        if (pos == syscall)
+            return 0;
+    }
+    return 1;
+}
