+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef UML_CORE_PATCH_H
+#define UML_CORE_PATCH_H
+#define UML_PATCH_BASE 0x60000
+#define UML_PATCH_END 0x70000
+#define UML_PATCH_SLOT 128
+#define UML_FAST_UC 8200
+#define UML_FAST_MC 8240
+#define UML_FAST_FP 9216
+#define UML_FAST_TOP 16384
+#define UML_FAST_FP_MAX 4096
+#ifndef __ASSEMBLER__
+static inline int uml_patch_pattern(const unsigned char *p, unsigned int len, unsigned long nr)
+{
+    unsigned long imm;
+    if (len == 7) {
+        if (*p++ != 0xb8) return 0;
+    } else if (len == 9) {
+        if (p[0] != 0x48 || p[1] != 0xc7 || p[2] != 0xc0) return 0;
+        p += 3;
+    } else return 0;
+    imm = p[0] | ((unsigned long)p[1] << 8) | ((unsigned long)p[2] << 16) |
+          ((unsigned long)p[3] << 24);
+    return imm == nr && p[4] == 0x0f && p[5] == 0x05;
+}
+int uml_patch_boundary(const unsigned char *p, unsigned int before, unsigned int len);
+extern int uml_syscall_patch;
+struct uml_pt_regs;
+struct mm_struct;
+struct task_struct;
+void uml_patch_syscall(struct uml_pt_regs *r);
+int uml_patch_fault(struct uml_pt_regs *r);
+void uml_patch_enter(struct mm_struct *mm);
+void uml_patch_exit(struct mm_struct *mm);
+void uml_patch_count(void);
+int uml_patch_prepare(int syscall, struct uml_pt_regs *r);
+void uml_patch_done(void);
+int uml_patch_write_begin(struct mm_struct *mm, unsigned long addr, int len);
+void uml_patch_write_end(struct mm_struct *mm);
+int uml_patch_step(struct task_struct *task);
+void uml_patch_forget(struct mm_struct *mm, unsigned long start, unsigned long end);
+int uml_patch_setup(void);
+#endif
