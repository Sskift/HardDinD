+static int patch_show(struct seq_file *m, void *v)
+{
+	int cpu;
+	u64 calls = 0;
+	for_each_possible_cpu(cpu)
+		calls += READ_ONCE(per_cpu(patch_calls, cpu));
+	seq_printf(m, "enabled %d\npatched %lld\nfast_calls %llu\n", uml_syscall_patch,
+		   atomic64_read(&patched), calls);
+	return 0;
+}
+
+static int __init patch_init(void)
+{
+	proc_create_single("uml_syscall_patch", 0400, NULL, patch_show);
+	return 0;
+}
