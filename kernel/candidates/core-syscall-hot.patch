+
+/* patch_lock precedes mmap_lock, including the first lazy allocation. */
+static void patch_area(struct mm_struct *mm)
+{
+    struct patch_header h = { PATCH_MAGIC, 1 };
+    struct page *page;
+    unsigned long addr;
+
+    if (!patch_hot_threshold || mm->context.patch_area_attempted)
+        return;
+    mm->context.patch_area_attempted = true;
+    addr = vm_mmap(NULL, UML_PATCH_BASE, UML_PATCH_END - UML_PATCH_BASE,
+                   PROT_READ | PROT_EXEC,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, 0);
+    if (addr != UML_PATCH_BASE)
+        return;
+    mmap_read_lock(mm);
+    page = write_page(mm, addr);
+    if (page) {
+        write_bytes(mm, page, addr, &h, sizeof(h));
+        put_page(page);
+        this_cpu_inc(patch_stats.areas);
+    }
+    mmap_read_unlock(mm);
+    if (!page)
+        vm_munmap(addr, UML_PATCH_END - UML_PATCH_BASE);
 }
 
