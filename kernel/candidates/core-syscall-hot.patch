--- /dev/null
+++ b/arch/um/include/shared/core-hot.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_CORE_HOT_H
+#define __UM_CORE_HOT_H
+
+/* User IPs have at most 47 bits. Lost races and hash collisions only delay
+ * patching; counts are hints, never correctness or lifetime state. */
+static inline int uml_patch_hot(unsigned long *slot, unsigned long ip,
+                                 unsigned int threshold)
+{
+    unsigned long old = __atomic_load_n(slot, __ATOMIC_RELAXED), next;
+    unsigned int count = (old >> 16) == ip ? old & 65535 : 0;
+
+    if (count < threshold)
+        count++;
+    next = (ip << 16) | count;
+    if (!__atomic_compare_exchange_n(slot, &old, next, 0,
+                                     __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+        return 0;
+    return count >= threshold;
+}
+#endif
