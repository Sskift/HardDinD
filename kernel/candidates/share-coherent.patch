-			/* MAP_PRIVATE */
-			return generic_file_mmap(file, vma);
+			/* MAP_PRIVATE does not enter FUSE cached I/O mode. */
+			rc = generic_file_mmap(file, vma);
+			if (!rc && fc->share_mmap_poll)
+				vma->vm_ops = &fuse_share_private_vm_ops;
+			return rc;
 		}
 
 		/*
@@ -2451,7 +2535,7 @@
 		fuse_link_write_file(file);
 
 	file_accessed(file);
-	vma->vm_ops = &fuse_file_vm_ops;
+	vma->vm_ops = fc->share_mmap_poll ? &fuse_share_vm_ops : &fuse_file_vm_ops;
 	return 0;
 }
 
