+u64 fuse_share_entry_version(struct inode *dir)
+{
+	return get_fuse_conn(dir)->share_cache ?
+		atomic64_read(&get_fuse_inode(dir)->share_entry_version) : 0;
+}
+
+void fuse_share_entry_timeout(struct inode *dir, struct dentry *entry,
+			      struct fuse_entry_out *o, u64 version)
+{
+	fuse_change_entry_timeout(entry, o);
+	if (!get_fuse_conn(dir)->share_cache)
+		return;
+	/* Publish the timeout before checking for an intervening notification. */
+	smp_mb();
+	if (version != fuse_share_entry_version(dir))
+		fuse_invalidate_entry_cache(entry);
+}
