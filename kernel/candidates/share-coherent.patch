+static bool fuse_share_mapping_known(struct fuse_file *ff, struct vm_area_struct *vma)
+{
+	u64 offset = (u64)vma->vm_pgoff << PAGE_SHIFT;
+	u64 length = vma->vm_end - vma->vm_start;
+	bool known;
+
+	spin_lock(&ff->share_map_lock);
+	known = ff->share_map_length && offset >= ff->share_map_offset &&
+		length <= ff->share_map_length &&
+		offset - ff->share_map_offset <= ff->share_map_length - length;
+	spin_unlock(&ff->share_map_lock);
+	return known;
+}
+
+static int fuse_share_track_mapping(struct file *file, struct vm_area_struct *vma)
+{
+	struct fuse_file *ff = file->private_data;
+	FUSE_ARGS(args);
+	u64 range[4] = { ff->fh, (u64)vma->vm_pgoff << PAGE_SHIFT,
+			vma->vm_end - vma->vm_start, ff->fm->fc->share_mmap_poll };
+	int err;
+
+	if (!range[3] || fuse_share_mapping_known(ff, vma))
+		return 0;
+	args.opcode = 0x4844;
+	args.nodeid = get_node_id(file_inode(file));
+	args.in_numargs = 1;
+	args.in_args[0].size = sizeof(range);
+	args.in_args[0].value = range;
+	err = fuse_simple_request(ff->fm, &args);
+	if (!err) {
+		spin_lock(&ff->share_map_lock);
+		ff->share_map_offset = range[1];
+		ff->share_map_length = range[2];
+		spin_unlock(&ff->share_map_lock);
+	}
+	return err;
+}
+
+static vm_fault_t fuse_share_fault(struct vm_fault *vmf)
+{
+	/* In-place mremap growth does not call ->mremap(). */
+	if (fuse_share_track_mapping(vmf->vma->vm_file, vmf->vma))
+		return VM_FAULT_SIGBUS;
+	return filemap_fault(vmf);
+}
+
+static vm_fault_t fuse_share_map_pages(struct vm_fault *vmf, pgoff_t start, pgoff_t end)
+{
+	struct fuse_file *ff = vmf->vma->vm_file->private_data;
+
+	/* A cached page must not bypass registration of an expanded VMA. */
+	if (!fuse_share_mapping_known(ff, vmf->vma))
+		return 0;
+	return filemap_map_pages(vmf, start, end);
+}
+
+static int fuse_share_remap(struct vm_area_struct *vma)
+{
+	return fuse_share_track_mapping(vma->vm_file, vma);
+}
+
+static const struct vm_operations_struct fuse_share_private_vm_ops = {
+	.mremap		= fuse_share_remap,
+	.fault		= fuse_share_fault,
+	.map_pages	= fuse_share_map_pages,
+};
+
+static const struct vm_operations_struct fuse_share_vm_ops = {
+	.mremap		= fuse_share_remap,
+	.close		= fuse_vma_close,
+	.fault		= fuse_share_fault,
+	.map_pages	= fuse_share_map_pages,
+	.page_mkwrite	= fuse_page_mkwrite,
+};
+
 static const struct vm_operations_struct fuse_file_vm_ops = {
 	.close		= fuse_vma_close,
 	.fault		= filemap_fault,
@@ -2401,6 +2478,10 @@
