-		mask = vdev->config->get_vq_affinity(vdev, VQ_REQUEST + q);
+		mask = vdev->config->get_vq_affinity(vdev, fs->first_request + q);
 		if (!mask)
 			goto fallback;
 
 		for_each_cpu(cpu, mask)
-			fs->mq_map[cpu] = q + VQ_REQUEST;
+			fs->mq_map[cpu] = q + fs->first_request;
 	}
 
 	return;
@@ -949,13 +1155,13 @@
 	/* If even this fails we default to all CPUs use first request queue */
 	if (!masks) {
 		for_each_possible_cpu(cpu)
-			fs->mq_map[cpu] = VQ_REQUEST;
+			fs->mq_map[cpu] = fs->first_request;
 		return;
 	}
 
 	for (q = 0; q < fs->num_request_queues; q++) {
 		for_each_cpu(cpu, &masks[q % nr_masks])
-			fs->mq_map[cpu] = q + VQ_REQUEST;
+			fs->mq_map[cpu] = q + fs->first_request;
 	}
 	kfree(masks);
 }
@@ -1000,9 +1206,21 @@
 	 * request queues (e.g. hiprio) don't claim any of the CPUs in
 	 * the multi-queue mapping and interrupt affinities
 	 */
-	struct irq_affinity desc = { .pre_vectors = VQ_REQUEST };
+	struct irq_affinity desc = {};
 	unsigned int i;
 	int ret = 0;
+
+	fs->first_request = virtio_has_feature(vdev, SHARE_NOTIFY_FEATURE) ? 2 : 1;
+	if (fs->first_request == 2) {
+		__le32 size;
+
+		if (!virtio_has_feature(vdev, SHARE_EVENT_FEATURE))
+			return -EINVAL;
+		virtio_cread_bytes(vdev, 40, &size, sizeof(size));
+		if (le32_to_cpu(size) != SHARE_NOTIFY_SIZE)
+			return -EINVAL;
+	}
+	desc.pre_vectors = fs->first_request;
 
 	virtio_cread_le(vdev, struct virtio_fs_config, num_request_queues,
 			&fs->num_request_queues);
@@ -1012,7 +1230,7 @@
 	/* Truncate nr of request queues to nr_cpu_id */
 	fs->num_request_queues = min_t(unsigned int, fs->num_request_queues,
 					nr_cpu_ids);
-	fs->nvqs = VQ_REQUEST + fs->num_request_queues;
+	fs->nvqs = fs->first_request + fs->num_request_queues;
 	fs->vqs = kzalloc_objs(fs->vqs[VQ_HIPRIO], fs->nvqs);
 	if (!fs->vqs)
 		return -ENOMEM;
@@ -1031,11 +1249,18 @@
 	virtio_fs_init_vq(&fs->vqs[VQ_HIPRIO], "hiprio", VQ_HIPRIO);
 	vqs_info[VQ_HIPRIO].name = fs->vqs[VQ_HIPRIO].name;
 
+	if (fs->first_request == 2) {
+		virtio_fs_init_vq(&fs->vqs[1], "notifications", VQ_HIPRIO);
+		INIT_WORK(&fs->vqs[1].done_work, virtio_fs_notify_done);
+		vqs_info[1].callback = virtio_fs_vq_done;
+		vqs_info[1].name = fs->vqs[1].name;
+	}
+
 	/* Initialize the requests virtqueues */
-	for (i = VQ_REQUEST; i < fs->nvqs; i++) {
+	for (i = fs->first_request; i < fs->nvqs; i++) {
 		char vq_name[VQ_NAME_LEN];
 
-		snprintf(vq_name, VQ_NAME_LEN, "requests.%u", i - VQ_REQUEST);
+		snprintf(vq_name, VQ_NAME_LEN, "requests.%u", i - fs->first_request);
 		virtio_fs_init_vq(&fs->vqs[i], vq_name, VQ_REQUEST);
 		vqs_info[i].callback = virtio_fs_vq_done;
 		vqs_info[i].name = fs->vqs[i].name;
@@ -1064,7 +1289,15 @@
 /* Free virtqueues (device must already be reset) */
 static void virtio_fs_cleanup_vqs(struct virtio_device *vdev)
 {
+	struct virtio_fs *fs = vdev->priv;
+	unsigned int i;
+
 	vdev->config->del_vqs(vdev);
+	/* An IRQ can queue notification work after the earlier drain. */
+	if (fs->first_request == 2)
+		cancel_work_sync(&fs->vqs[1].done_work);
+	for (i = 0; i < SHARE_NOTIFY_COUNT; i++)
+		kfree(fs->notify_buffers[i]);
 }
 
