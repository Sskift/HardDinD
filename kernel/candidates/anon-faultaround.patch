+/*
+ * UML anonymous faultaround (EXPLORATORY, default off)
+ * ----------------------------------------------------
+ *
+ * In seccomp thread mode every not-present user page costs a full
+ * runner -> kernel -> broker -> runner rendezvous: SIGSEGV delivery,
+ * two futex handoffs and at least one host mmap() before the faulting
+ * instruction is restarted.  A sequential first-touch loop pays this
+ * fixed price once per 4 KiB page instead of once per VMA window.
+ *
+ * When enabled, a successful user WRITE fault on a plain private
+ * anonymous VMA synchronously resolves the other EMPTY PTEs of the
+ * aligned 2^order-page window through the ordinary fault path as well.
+ * Functional semantics (zeroed pages, COW, fork, mprotect, munmap,
+ * rmap, reclaim, swap, the content of every page) are those of normal
+ * anonymous faults, because every neighbour is produced by
+ * do_anonymous_page() and published through the same NEEDSYNC/broker
+ * flush as the faulting page.
+ *
+ * TIMING/OBSERVABLE SEMANTICS ARE NOT IDENTICAL, and this is why the
+ * feature is opt-in: up to 2^order pages become resident, mincore()
+ * visible, RSS/memcg charged and accounted as minor faults at the first
+ * touch of the window, before the process actually accesses them; a
+ * tight memcg limit (or host OOM) can therefore kill the process one
+ * window earlier than page-at-a-time behaviour would.  This is the same
+ * trade upstream makes for THP, not an unchanged semantic.
+ *
+ * Lock contract: the caller holds the mmap lock for reading.  Neighbour
+ * faults are invoked WITHOUT FAULT_FLAG_ALLOW_RETRY/KILLABLE/
+ * INTERRUPTIBLE and userfaultfd VMAs are excluded, so the VM cannot
+ * drop the lock across a neighbour fault (no VM_FAULT_RETRY/COMPLETED);
+ * any such return is a contract violation and BUGs instead of returning
+ * to the caller with an unbalanced lock.
+ */
+static unsigned int uml_faultaround_order;
+
+/* 32 pages * 4 KiB = 128 KiB, and always below the stub queue depth. */
+#define UM_FAULTAROUND_MAX_ORDER	5
+
+/*
+ * Expressly no FAULT_FLAG_ALLOW_RETRY/KILLABLE/INTERRUPTIBLE: the mmap
+ * read lock acquired by handle_page_fault() must still be held when the
+ * helper returns.  These flags also make the wait non-killable for the
+ * bounded duration of one small window.
+ */
+#define UM_FAULTAROUND_FLAGS	(FAULT_FLAG_USER | FAULT_FLAG_WRITE)
+
+static int __init uml_faultaround_setup(char *line, int *add)
+{
+	unsigned int order;
+
+	*add = 0;
+	if (kstrtouint(line, 10, &order) ||
+	    order > UM_FAULTAROUND_MAX_ORDER) {
+		pr_warn("uml_faultaround requires a value of 0..%u\n",
+			UM_FAULTAROUND_MAX_ORDER);
+		return 0;
+	}
+	uml_faultaround_order = order;
+	return 0;
+}
+__uml_setup("uml_faultaround=", uml_faultaround_setup,
+"uml_faultaround=<order>\n"
+"    Default 0 (off).  After a user write fault on plain private\n"
+"    anonymous memory, also resolve empty PTEs of the aligned\n"
+"    2^order-page window (max 32 pages) through the normal fault path\n"
+"    before returning to userspace.  Page contents, COW, fork,\n"
+"    mprotect and munmap keep their normal semantics, but residency,\n"
+"    RSS/memcg charging, mincore() and minor-fault accounting move up\n"
+"    to the first touch of the window, and OOM/SIGKILL under tight\n"
+"    memory limits can occur up to a window earlier (THP-like).\n\n");
+
+static bool um_faultaround_vma_ok(const struct vm_area_struct *vma)
+{
+	if (!(vma->vm_flags & VM_WRITE) || (vma->vm_flags & VM_SHARED))
+		return false;
+	/* Plain anonymous private memory only: no file, device or special
+	 * mappings, no stack (guard expansion side effects), and no
+	 * userfaultfd in any mode (it owns fault fidelity and can also
+	 * return VM_FAULT_COMPLETED). */
+	if (vma->vm_ops)
+		return false;
+	if (vma->vm_flags & (VM_PFNMAP | VM_MIXEDMAP | VM_IO | VM_HUGETLB |
+			     VM_GROWSDOWN | VM_UFFD_MISSING | VM_UFFD_WP |
+			     VM_UFFD_MINOR))
+		return false;
+	return true;
+}
+
+static void um_anon_faultaround(struct mm_struct *mm,
+				struct vm_area_struct *vma,
+				unsigned long address)
+{
+	unsigned int order = READ_ONCE(uml_faultaround_order);
+	unsigned long size, start, end, addr;
+	vm_fault_t fault;
+
+	if (!order)
+		return;
+	if (!um_faultaround_vma_ok(vma))
+		return;
+
+	size = (unsigned long)PAGE_SIZE << order;
+	start = ALIGN_DOWN(address, size);
+	end = start + size;
+
+	/*
+	 * Mirror filemap faultaround/THP containment rules: the whole
+	 * window must be aligned, live inside one VMA and one PMD and
+	 * never touch the stack guard region.  Staying inside the fault's
+	 * PMD also guarantees its PTE page already exists.
+	 */
+	if (start < vma->vm_start || end > vma->vm_end)
+		return;
+	if ((start & PMD_MASK) != ((end - PAGE_SIZE) & PMD_MASK))
+		return;
+
+	for (addr = start; addr < end; addr += PAGE_SIZE) {
+		pmd_t *pmd;
+		pte_t *ptep;
+		spinlock_t *ptl;
+		bool empty;
+
+		if (addr == address)
+			continue;
+		if (fatal_signal_pending(current))
+			return;
+
+		/*
+		 * The advisory emptiness check is done under the PTE lock
+		 * (mmap read lock keeps the page tables and this PMD alive;
+		 * the guest configuration has no THP PMD collapse).  A
+		 * zero-page read mapping, a racing fault, a migration/swap
+		 * entry or a COW target are all "not empty" and left for
+		 * their real access.  do_anonymous_page() re-checks under
+		 * the PTL anyway.
+		 */
+		pmd = pmd_off(mm, addr);
+		if (unlikely(!pmd_present(READ_ONCE(*pmd))))
+			return;
+		ptep = pte_offset_map_lock(mm, pmd, addr, &ptl);
+		if (unlikely(!ptep))
+			return;
+		empty = pte_none(READ_ONCE(*ptep));
+		pte_unmap_unlock(ptep, ptl);
+		if (!empty)
+			continue;
+
+		fault = handle_mm_fault(vma, addr, UM_FAULTAROUND_FLAGS, NULL);
+		/*
+		 * VM_FAULT_RETRY/COMPLETED cannot occur with the flags
+		 * above and uffd excluded: they mean the mmap lock was
+		 * released, which the caller would then unbalance.  Stop
+		 * hard rather than corrupt the lock state.  OOM/SIGBUS/
+		 * hwpoison simply end the window; the affected page is
+		 * faulted normally when actually touched.
+		 */
+		if (unlikely(fault & (VM_FAULT_RETRY | VM_FAULT_COMPLETED)))
+			BUG();
+		if (fault & (VM_FAULT_OOM | VM_FAULT_SIGBUS |
+			     VM_FAULT_SIGSEGV | VM_FAULT_HWPOISON |
+			     VM_FAULT_HWPOISON_LARGE))
+			return;
+	}
+}
+
