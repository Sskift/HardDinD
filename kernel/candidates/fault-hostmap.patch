 #define _PAGE_NEEDSYNC	0x002
+#define _PAGE_HOST	0x004 /* this PTE owns a queued/installed host mapping */
 #define _PAGE_RW	0x020
@@ -203,2 +205,25 @@
 
+static inline unsigned long uml_host_pte_value(unsigned long old, unsigned long value,
+					      int enabled)
+{
+	if (!enabled)
+		return value | _PAGE_NEEDSYNC;
+	value &= ~_PAGE_HOST;
+	if ((old & (_PAGE_PRESENT | _PAGE_PROTNONE)) &&
+	    (value & (_PAGE_PRESENT | _PAGE_PROTNONE)) &&
+	    !((old ^ value) & PAGE_MASK) && (old & _PAGE_HOST)) {
+		value |= _PAGE_HOST;
+		if (!(old & _PAGE_NEEDSYNC) &&
+		    !((old ^ value) & ~(_PAGE_HOST | _PAGE_NEEDSYNC)))
+			return value & ~_PAGE_NEEDSYNC;
+	}
+	return value | _PAGE_NEEDSYNC;
+}
+
+static inline int uml_host_lazy_pte(unsigned long old, unsigned long value, int fresh)
+{
+	return fresh && !old && (value & (_PAGE_PRESENT | _PAGE_PROTNONE)) &&
+		!(value & _PAGE_ACCESSED);
+}
