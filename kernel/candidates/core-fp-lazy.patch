+int uml_fp_can_borrow(struct stub_data *data)
+{
+#ifdef __x86_64__
+    siginfo_t *info;
+
+    if (!uml_fp_lazy || !parallel_userspace || data->signal != SIGSYS ||
+        data->si_offset > sizeof(data->sigstack) - sizeof(*info))
+        return 0;
+    info = (void *)&data->sigstack[data->si_offset];
+    /* These paths copy or destroy the mm before returning to userspace. */
+    switch (info->si_syscall) {
+    case __NR_clone: case __NR_clone3: case __NR_fork: case __NR_vfork:
+    case __NR_execve: case __NR_execveat: case __NR_exit: case __NR_exit_group:
+    case __NR_rt_sigreturn:
+        return 0;
+    default:
+        return 1;
+    }
+#else
+    return 0;
+#endif
 }
 
