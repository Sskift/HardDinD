--- /dev/null
+++ b/arch/x86/um/core-fp.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/percpu.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/smp.h>
+#include <linux/preempt.h>
+#include <linux/string.h>
+#include <sysdep/ptrace.h>
+
+extern int uml_fp_lazy;
+struct fp_stats { unsigned long long event[3]; };
+static DEFINE_PER_CPU(struct fp_stats, fp_stats);
+
+/* borrowed, reused, materialized; caller is pinned or the task is stopped. */
+void uml_fp_event(unsigned int event)
+{
+    __atomic_fetch_add(&per_cpu(fp_stats, raw_smp_processor_id()).event[event], 1,
+                       __ATOMIC_RELAXED);
+}
+
+static int fp_show(struct seq_file *m, void *unused)
+{
+    static const char * const names[] = { "borrowed", "reused", "materialized" };
+    int cpu;
+    seq_printf(m, "enabled %d\n", uml_fp_lazy);
+    for (unsigned int i = 0; i < 3; i++) {
+        unsigned long long total = 0;
+        for_each_possible_cpu(cpu)
+            total += __atomic_load_n(&per_cpu(fp_stats, cpu).event[i], __ATOMIC_RELAXED);
+        seq_printf(m, "%s %llu\n", names[i], total);
+    }
+    return 0;
+}
+static int __init fp_init(void)
+{
+    return proc_create_single("uml_fp_lazy", 0400, NULL, fp_show) ? 0 : -ENOMEM;
+}
+late_initcall(fp_init);
+
+/* A runner remains parked until its next set_stub_state. A switch may reuse
+ * it for another task, so never schedule in the middle of this copy. */
+void uml_fp_materialize(struct uml_pt_regs *regs)
+{
+    if (!regs->fp_pending)
+        return;
+    preempt_disable();
+    if (regs->fp_pending) {
+        memcpy(regs->fp, regs->fp_pending, regs->fp_pending_size);
+        regs->fp_pending = NULL;
+        uml_fp_event(2);
+    }
+    preempt_enable();
+}
