From: HardDinD developers
Subject: [EXPERIMENT] um: avoid rewriting an unchanged runner FP signal image

Default off: uml_fp_compare=1. Compare the complete validated xstate image
before copying it back to the runner. No ownership or dirty-state heuristic:
any changed byte still takes the existing full-copy path. Entry still saves
all FP state, and signal/ptrace/thread-switch restoration stays authoritative.
The comparison may cost more than the avoided store; measure before enabling.

--- a/arch/um/os-Linux/start_up.c
+++ b/arch/um/os-Linux/start_up.c
@@ -477,6 +477,23 @@
 "    Experimental latency/CPU tradeoff; does not change guest syscalls.\n"
 );
 
+int uml_fp_compare;
+static int __init uml_fp_compare_setup(char *line, int *add)
+{
+	*add = 0;
+	if (!strcmp(line, "1"))
+		uml_fp_compare = 1;
+	else if (!strcmp(line, "0"))
+		uml_fp_compare = 0;
+	else
+		fatal("uml_fp_compare requires 0 or 1\n");
+	return 0;
+}
+__uml_setup("uml_fp_compare=", uml_fp_compare_setup,
+"uml_fp_compare=<0|1>\n"
+"    Default off. Avoid rewriting an identical runner FP signal image.\n"
+);
+
 static int seccomp_config __initdata;
 
 static int __init uml_seccomp_config(char *line, int *add)
--- a/arch/x86/um/os-Linux/mcontext.c
+++ b/arch/x86/um/os-Linux/mcontext.c
@@ -15,6 +15,8 @@
 #include <sysdep/mcontext.h>
 #include <arch.h>
 
+extern int uml_fp_compare;
+
 void get_regs_from_mc(struct uml_pt_regs *regs, mcontext_t *mc)
 {
 #ifdef __i386__
@@ -237,7 +239,8 @@
 	xstate_size = fp_size;
 #endif
 
-	memcpy(xstate_stub, &regs->fp, xstate_size);
+	if (!uml_fp_compare || memcmp(xstate_stub, &regs->fp, xstate_size))
+		memcpy(xstate_stub, &regs->fp, xstate_size);
 
 #ifdef __i386__
 	/*
