From: HardDinD developers
Subject: [EXPERIMENT] um: batch a runner's stack mapping and clone

Apply before fault-rendezvous-counters when combined.
Default off: uml_clone_batch=1 removes the intermediate broker handoff.
The stub executes its queue in order, so the mapping completes before the
clone reads the new stack. A failed mapping stops the queue before clone;
queue/FD capacity may still flush early. Keep the final completion and
child startup waits, socket cleanup and all negative TLB synchronization.

--- a/arch/um/os-Linux/start_up.c
+++ b/arch/um/os-Linux/start_up.c
@@ -477,6 +477,23 @@
 "    Experimental latency/CPU tradeoff; does not change guest syscalls.\n"
 );
 
+int uml_clone_batch;
+static int __init uml_clone_batch_setup(char *line, int *add)
+{
+	if (!strcmp(line, "1"))
+		uml_clone_batch = 1;
+	else if (!strcmp(line, "0"))
+		uml_clone_batch = 0;
+	else
+		fatal("uml_clone_batch requires a value of 0 or 1\n");
+	*add = 0;
+	return 0;
+}
+__uml_setup("uml_clone_batch=", uml_clone_batch_setup,
+"uml_clone_batch=<0|1>\n"
+"    Default 0. Batch the runner stack mapping with its ordered clone.\n"
+"    Only applies with seccomp_threads=1.\n");
+
 static int seccomp_config __initdata;
 
 static int __init uml_seccomp_config(char *line, int *add)
--- a/arch/um/os-Linux/skas/mem.c
+++ b/arch/um/os-Linux/skas/mem.c
@@ -312,42 +312,45 @@
 int start_userspace_cpu(struct mm_id *broker, struct mm_id *child, unsigned long addr)
 {
 	struct stub_data *data = (void *)child->stack;
 	struct stub_data *parent = (void *)broker->stack;
 	struct stub_syscall *sc;
 	unsigned long long offset;
 	int sockets[2], fd, err;
 	extern unsigned int uml_seccomp_spin_limit;
+	extern int uml_clone_batch;
 
 	if (socketpair(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0, sockets))
 		return -errno;
 	child->sock = sockets[0];
 	data->spin_limit = uml_seccomp_spin_limit;
 	fd = phys_mapping(uml_to_phys((void *)child->stack), &offset);
 	map(broker, addr, STUB_THREAD_PAGES * UM_KERN_PAGE_SIZE,
 	    UM_PROT_READ | UM_PROT_WRITE, fd, offset);
-	err = syscall_stub_flush(broker);
-	if (err)
-		goto fail;
+	if (!uml_clone_batch) {
+		err = syscall_stub_flush(broker);
+		if (err)
+			goto fail;
+	}
 	fd = get_stub_fd(broker, sockets[1]);
 	sc = syscall_stub_alloc(broker);
 	sc->syscall = STUB_SYSCALL_CLONE;
 	sc->mem.addr = addr;
 	sc->mem.fd = fd;
 	parent->clone_pid = -1;
 	err = syscall_stub_flush(broker);
 	if (err)
 		goto fail;
 	child->pid = parent->clone_pid;
 	if (child->pid < 2) {
 		err = -ECHILD;
 		goto fail;
 	}
 	close(sockets[1]);
 	wait_stub_done_seccomp(child, 1, 1);
 	return child->pid > 0 && data->err == 0 ? 0 : -ECHILD;
 fail:
 	close(sockets[0]);
 	close(sockets[1]);
 	child->sock = 0;
 	return err;
 }
