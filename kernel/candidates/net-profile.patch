--- a/arch/um/include/shared/net-profile.h
+++ b/arch/um/include/shared/net-profile.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef UML_NET_PROFILE_H
+#define UML_NET_PROFILE_H
+
+#define UML_NET_EVENTS(X) \
+	X(SIGIO) \
+	X(SIGIO_DEFERRED) \
+	X(SIGIO_DISPATCH) \
+	X(TIMER) \
+	X(IPI) \
+	X(EPOLL_WAIT) \
+	X(EPOLL_EVENTS) \
+	X(EPOLL_CTL) \
+	X(RX_IRQ) \
+	X(TX_IRQ) \
+	X(TX_IRQ_IDLE) \
+	X(NAPI_POLL) \
+	X(NAPI_FULL) \
+	X(RX_CALLS) \
+	X(RX_EMPTY) \
+	X(RX_PACKETS) \
+	X(RX_BYTES) \
+	X(TX_CALLS) \
+	X(TX_BLOCKED) \
+	X(TX_PACKETS) \
+	X(TX_BYTES) \
+	X(TX_SKB) \
+	X(TX_GSO) \
+	X(TX_GSO_BYTES) \
+	X(RX_GSO)
+#define UML_NET_ENUM(name) UML_NET_##name,
+enum { UML_NET_EVENTS(UML_NET_ENUM) UML_NET_EVENTS_COUNT };
+#undef UML_NET_ENUM
+struct uml_net_profile {
+	unsigned long tid;
+	unsigned long count[UML_NET_EVENTS_COUNT];
+} __attribute__((aligned(128)));
+extern int uml_net_profile_enabled;
+extern struct uml_net_profile uml_net_profiles[CONFIG_NR_CPUS];
+void uml_net_count(unsigned int event, unsigned long amount);
+static inline void uml_net_add(unsigned int event, unsigned long amount)
+{
+	if (uml_net_profile_enabled)
+		uml_net_count(event, amount);
+}
+#endif
--- a/arch/um/kernel/irq.c
+++ b/arch/um/kernel/irq.c
@@ -21,6 +21,55 @@
 #include <irq_user.h>
 #include <irq_kern.h>
 #include <linux/time-internal.h>
+#include <linux/proc_fs.h>
+#include <linux/init.h>
+#include <net-profile.h>
+
+int uml_net_profile_enabled;
+struct uml_net_profile uml_net_profiles[CONFIG_NR_CPUS];
+
+static int __init net_profile_setup(char *str)
+{
+	unsigned int value;
+
+	if (kstrtouint(str, 0, &value) || value > 1)
+		return 0;
+	uml_net_profile_enabled = value;
+	return 1;
+}
+__setup("uml_net_profile=", net_profile_setup);
+
+static int net_profile_show(struct seq_file *m, void *unused)
+{
+	int cpu, event;
+
+	seq_puts(m, "cpu tid");
+#define UML_NET_NAME(name) seq_puts(m, " " #name);
+	UML_NET_EVENTS(UML_NET_NAME)
+#undef UML_NET_NAME
+	seq_putc(m, '\n');
+	for (cpu = 0; cpu < CONFIG_NR_CPUS; cpu++) {
+		struct uml_net_profile *p = &uml_net_profiles[cpu];
+		unsigned long tid = __atomic_load_n(&p->tid, __ATOMIC_RELAXED);
+
+		if (!tid)
+			continue;
+		seq_printf(m, "%d %lu", cpu, tid);
+		for (event = 0; event < UML_NET_EVENTS_COUNT; event++)
+			seq_printf(m, " %lu", __atomic_load_n(&p->count[event], __ATOMIC_RELAXED));
+		seq_putc(m, '\n');
+	}
+	return 0;
+}
+
+static int __init net_profile_init(void)
+{
+	if (uml_net_profile_enabled &&
+	    !proc_create_single("uml_net_profile", 0400, NULL, net_profile_show))
+		return -ENOMEM;
+	return 0;
+}
+late_initcall(net_profile_init);
 
