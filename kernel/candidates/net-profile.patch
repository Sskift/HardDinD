+void uml_net_count(unsigned int event, unsigned long amount)
+{
+	struct uml_net_profile *p = &uml_net_profiles[uml_curr_cpu()];
+
+	if (!__atomic_load_n(&p->tid, __ATOMIC_RELAXED))
+		__atomic_store_n(&p->tid, syscall(SYS_gettid), __ATOMIC_RELAXED);
+	__atomic_fetch_add(&p->count[event], amount, __ATOMIC_RELAXED);
+}
 
