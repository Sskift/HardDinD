From: HardDinD developers
Subject: [DIAGNOSTIC] um: count coalesced mapping batches and runner traps

Standalone, default off (uml_faultstat=1). No dependency on anon-faultaround.
Counts before and after map coalescing; counts real nonempty stub batches,
including queue-capacity flushes. These are submitted commands, not successful
host syscalls when stub_failed is nonzero. Machine-wide snapshots include
background tasks and the snapshot reader. No hot-path clock reads.

--- /dev/null
+++ b/arch/um/include/shared/faultstat.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_SHARED_FAULTSTAT_H
+#define __UM_SHARED_FAULTSTAT_H
+
+/* Shared by kernel and os-Linux objects; deliberately no Linux includes. */
+#define UML_FS_COUNTERS(X) \
+	X(trap) X(segv) X(sigsys) X(user_fault) X(write_fault) \
+	X(tlb_sync) X(map_requests) X(map_pages) X(map_coalesced) \
+	X(unmap_requests) X(stub_batches) X(stub_failed) \
+	X(stub_mmap) X(stub_mmap_pages) X(stub_munmap) X(stub_clone) \
+	X(stub_memfd) X(runner_start) X(broker_start) \
+	X(wait_poll_done) X(wait_futex)
+#define UML_FS_ENUM(name) UML_FS_##name,
+enum { UML_FS_COUNTERS(UML_FS_ENUM) UML_FS_COUNT };
+#undef UML_FS_ENUM
+extern int uml_faultstat_enabled;
+extern unsigned long long uml_fs_values[UML_FS_COUNT];
+
+/* No clocks at all; no atomic instructions when disabled. */
+static inline void uml_fs_add(unsigned int id, unsigned long long value)
+{
+	if (__builtin_expect(uml_faultstat_enabled, 0))
+		__atomic_fetch_add(&uml_fs_values[id], value, __ATOMIC_RELAXED);
+}
+
+static inline void uml_fs_inc(unsigned int id)
+{
+	uml_fs_add(id, 1);
+}
+#endif
--- /dev/null
+++ b/arch/um/kernel/faultstat.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Optional machine-wide counters. Snapshots are not multi-counter atomic. */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kstrtox.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <init.h>
+#include <faultstat.h>
+
+int uml_faultstat_enabled;
+unsigned long long uml_fs_values[UML_FS_COUNT];
+
+static int faultstat_show(struct seq_file *m, void *v)
+{
+	seq_puts(m, "# machine-wide counters; includes other guest tasks and snapshot overhead\n"
+		 "# map_requests/pages: before coalescing; stub_mmap/pages: submitted after coalescing\n"
+		 "# stub_*: do_syscall_stub batches, including auto-flushes; failed batches may be partial\n"
+		 "# wait_*: kernel side only; poll_done also includes already-ready peers\n");
+	seq_printf(m, "enabled %d\n", uml_faultstat_enabled);
+#define UML_FS_SHOW(name) seq_printf(m, #name " %llu\n", \
+	__atomic_load_n(&uml_fs_values[UML_FS_##name], __ATOMIC_RELAXED));
+	UML_FS_COUNTERS(UML_FS_SHOW)
+#undef UML_FS_SHOW
+	return 0;
+}
+DEFINE_PROC_SHOW_ATTRIBUTE(faultstat);
+
+static int __init faultstat_init(void)
+{
+	if (!proc_create("uml_faultstat", 0400, NULL, &faultstat_proc_ops))
+		return -ENOMEM;
+	return 0;
+}
+__initcall(faultstat_init);
+
+static int __init faultstat_setup(char *line, int *add)
+{
+	unsigned int enable;
+
+	*add = 0;
+	if (kstrtouint(line, 10, &enable) || enable > 1) {
+		pr_warn("uml_faultstat requires 0 or 1\n");
+		return 0;
+	}
+	uml_faultstat_enabled = enable;
+	return 0;
+}
+__uml_setup("uml_faultstat=", faultstat_setup,
+"uml_faultstat=<0|1>\n"
+"    Default 0. Count runner traps, PTE mappings, coalesced stub commands\n"
+"    and kernel-side waits. Read /proc/uml_faultstat; no clock probes.\n\n");
