From: HardDinD developers
Subject: [PATCH] um: ubd: execute FLUSH requests on the host

FLUSH requests are submitted with zero data descriptors, and the I/O thread
only called do_io() per descriptor, so os_sync_file() never ran: guest
fsync() returned success without the host COW file being synced, although
the device advertises a volatile write cache. Run FLUSH explicitly and count
host syncs in /sys/module/ubd/parameters/host_flushes{,_errors}.

--- a/arch/um/drivers/ubd_kern.c
+++ b/arch/um/drivers/ubd_kern.c
@@ -392,6 +392,11 @@
 /* Only changed by ubd_init, which is an initcall. */
 static int thread_fd = -1;
 
+/* Host fsyncs completed for guest FLUSH requests; checked by benchmarks. */
+static unsigned long host_flushes, host_flush_errors;
+module_param(host_flushes, ulong, 0444);
+module_param(host_flush_errors, ulong, 0444);
+
 /* Function to read several request pointers at a time
 * handling fractional reads if (and as) needed
 */
@@ -1416,6 +1421,7 @@
 	if (req_op(req->req) == REQ_OP_FLUSH) {
 		/* fds[0] is always either the rw image or our cow file */
 		req->error = map_error(-os_sync_file(req->fds[0]));
+		__atomic_add_fetch(req->error ? &host_flush_errors : &host_flushes, 1, __ATOMIC_RELAXED);
 		return;
 	}
 
@@ -1516,6 +1522,9 @@
 			int i;
 
 			io_count++;
+			/* FLUSH carries no data segments, so the loop below never ran it. */
+			if (req_op(req->req) == REQ_OP_FLUSH)
+				do_io(req, NULL);
 			for (i = 0; !req->error && i < req->desc_cnt; i++)
 				do_io(req, &(req->io_desc[i]));
 
