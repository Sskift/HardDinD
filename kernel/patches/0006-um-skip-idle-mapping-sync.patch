From: HardDinD developers
Subject: [EXPERIMENT] um: skip idle mapping synchronization and report child failures

Avoid broker-lock IRQ mask transitions when both the dirty range and
command queue are empty. Concurrent invalidations still synchronize
before returning. Preserve child exit status and stub failures for diagnosis.

--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -199,7 +199,7 @@
 extern void report_enomem(void);
 
 /* process.c */
-pid_t os_reap_child(void);
+pid_t os_reap_child(int *status);
 extern void os_alarm_process(int pid);
 extern void os_kill_process(int pid, int reap_child);
 extern void os_kill_ptraced_process(int pid, int reap_child);
--- a/arch/um/kernel/skas/mmu.c
+++ b/arch/um/kernel/skas/mmu.c
@@ -229,10 +229,11 @@
 {
 	struct mm_context *mm_context;
 	pid_t pid;
+	int status;
 
 	guard(spinlock)(&mm_list_lock);
 
-	while ((pid = os_reap_child()) > 0) {
+	while ((pid = os_reap_child(&status)) > 0) {
 		/*
 		* A child died, check if we have an MM with the PID. This is
 		* only relevant in SECCOMP mode (as ptrace will fail anyway).
@@ -251,7 +252,9 @@
 			}
 			if (id->pid == pid) {
 				struct stub_data *stub_data;
-				printk("Unexpectedly lost MM child! Affected tasks will segfault.");
+				printk("Unexpectedly lost MM child! pid=%d host_status=%#x broker=%d err=%ld. Affected tasks will segfault.\n",
+				       pid, status, id == &mm_context->id,
+				       ((struct stub_data *)id->stack)->err);
 
 				/* Marks the MM as dead */
 				id->pid = -1;
--- a/arch/um/kernel/skas/stub.c
+++ b/arch/um/kernel/skas/stub.c
@@ -203,8 +203,10 @@
 			break;
 	}
 
-	if (res < 0 && res != -EAGAIN && res != -EINTR)
-		stub_syscall1(__NR_exit_group, 1);
+	if (res < 0 && res != -EAGAIN && res != -EINTR) {
+		d->err = res;
+		stub_syscall1(__NR_exit, 70);
+	}
 
 	if (d->syscall_data_len) {
 		/* Read passed FDs (if any) */
@@ -213,8 +215,10 @@
 		} while (res == -EINTR);
 
 		/* We should never have a receive error (other than -EAGAIN) */
-		if (res < 0 && res != -EAGAIN)
-			stub_syscall1(__NR_exit_group, 1);
+		if (res < 0 && res != -EAGAIN) {
+			d->err = res;
+			stub_syscall1(__NR_exit, 71);
+		}
 
 		/* Receive the FDs */
 		num_fds = 0;
--- a/arch/um/kernel/tlb.c
+++ b/arch/um/kernel/tlb.c
@@ -220,6 +220,15 @@
 
 int um_tlb_sync(struct mm_struct *mm)
 {
+	/* No mapping work means no broker round trip or IRQ-mask transition.
+	 * A concurrent invalidation performs its own synchronous flush before
+	 * returning; this runner must not wait for an invalidation not yet begun.
+	 * Keep the queued-command check for a freshly created address space.
+	 */
+	if (parallel_userspace && mm != &init_mm &&
+	    !READ_ONCE(mm->context.sync_tlb_range_to) &&
+	    !READ_ONCE(mm->context.id.syscall_data_len))
+		return 0;
 	/* A flush can be called under the PTE lock. Parallel mode serializes
 	 * the broker and snapshots PTEs without recursively taking that lock.
 	 * Invalidation waits for this lock before page tables can be freed.
--- a/arch/um/os-Linux/process.c
+++ b/arch/um/os-Linux/process.c
@@ -67,12 +67,10 @@
 	unblock_signals();
 }
 
-pid_t os_reap_child(void)
-{
-	int status;
-
+pid_t os_reap_child(int *status)
+{
 	/* Try to reap a child */
-	return waitpid(-1, &status, WNOHANG);
+	return waitpid(-1, status, WNOHANG);
 }
 
