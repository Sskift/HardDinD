+
+extern bool uml_vdso_clock_enabled;
+extern s64 uml_host_wall_offset;
+static bool harddind_clock_sync = true;
+static long sync_ppb;
+static unsigned long sync_updates, sync_steps;
+
+static int __init clock_sync_setup(char *str)
+{
+	return !kstrtobool(str, &harddind_clock_sync);
+}
+__setup("harddind_clock_sync=", clock_sync_setup);
+
+struct clock_sample {
+	s64 host_mono, guest_mono, host_real, guest_real, raw;
+	u64 span;
+};
+
+/* Independent live host reads, never a copy of the servo's last observation.
+ * Reject preemption/host descheduling rather than treating it as clock error.
+ */
+static bool clock_sample(struct clock_sample *best)
+{
+	int i;
+
+	best->span = U64_MAX;
+	for (i = 0; i < 8; i++) {
+		struct clock_sample s;
+		s64 a, b, raw;
+		unsigned long flags;
+
+		local_irq_save(flags);
+		raw = ktime_get_raw_ns();
+		a = ktime_get_ns();
+		s.host_mono = os_nsecs();
+		b = ktime_get_ns();
+		s.guest_mono = a + (b - a) / 2;
+		s.raw = raw + (ktime_get_raw_ns() - raw) / 2;
+		a = ktime_get_real_ns();
+		s.host_real = os_persistent_clock_emulation();
+		b = ktime_get_real_ns();
+		s.guest_real = a + (b - a) / 2;
+		s.span = ktime_get_raw_ns() - raw;
+		local_irq_restore(flags);
+		if (b >= a && b - a <= s.span + 1000 && s.span < best->span)
+			*best = s;
+	}
+	return best->span <= 5000;
+}
+
+/* Read-only cross timestamps for ./hd probe, including with sync disabled. */
+static ssize_t harddind_clock_show(struct kobject *kobj,
+				  struct kobj_attribute *attr, char *buf)
+{
+	struct clock_sample s;
+
+	if (!clock_sample(&s))
+		return -EAGAIN;
+	return sysfs_emit(buf, "%lld %lld %lld %lld %lld %llu %d %ld %lu %lu\n",
+			  s.host_mono, s.guest_mono, s.host_real, s.guest_real,
+			  s.raw, s.span,
+			  uml_vdso_clock_enabled && harddind_clock_sync,
+			  READ_ONCE(sync_ppb), READ_ONCE(sync_updates),
+			  READ_ONCE(sync_steps));
+}
+static struct kobj_attribute clock_attr = __ATTR_RO(harddind_clock);
+
+static int clock_sync_thread(void *unused)
+{
+	struct clock_sample prev = {}, s;
+	s64 wall = 0;
+	bool sampled = false;
+
+	while (!kthread_should_stop()) {
+		struct __kernel_timex tx = {};
+		s64 elapsed, error, rate, phase, wall_now;
+
+		if (!clock_sample(&s))
+			goto sleep;
+		wall_now = s.host_real - s.host_mono;
+		if (!sampled) {
+			/* Include host steps between boot seeding and this thread. */
+			wall = uml_host_wall_offset;
+			prev = s;
+			sampled = true;
+			goto sleep;
+		}
+		/* Host REALTIME steps change wall-minus-mono; NTP slew does not.
+		 * Only propagate the host step, never step MONOTONIC or correct a
+		 * guest-only settimeofday by stepping it back behind the caller.
+		 */
+		if (abs(wall_now - wall) > 20000) {
+			struct timespec64 delta = ns_to_timespec64(wall_now - wall);
+
+			tx.modes = ADJ_SETOFFSET | ADJ_NANO;
+			tx.time.tv_sec = delta.tv_sec;
+			tx.time.tv_usec = delta.tv_nsec;
+			if (do_adjtimex(&tx) < 0)
+				goto sleep;
+			wall = wall_now;
+			WRITE_ONCE(sync_steps, sync_steps + 1);
+		}
+		elapsed = s.raw - prev.raw;
+		if (elapsed < 50 * NSEC_PER_MSEC || elapsed > 120LL * NSEC_PER_SEC) {
+			prev = s;
+			goto sleep;
+		}
+		/* RAW is independent of ADJ_FREQUENCY, so this measures host slew
+		 * plus TSC calibration error without feeding back our correction.
+		 */
+		error = (s.host_mono - prev.host_mono) - elapsed;
+		rate = div64_s64(error * 1000000, div_s64(elapsed, 1000));
+		rate = clamp(rate, -500000LL, 500000LL);
+		phase = s.host_mono - s.guest_mono;
+		memset(&tx, 0, sizeof(tx));
+		tx.modes = ADJ_FREQUENCY;
+		/* One-second phase time constant. Follow measured rate directly:
+		 * smoothing delays host NTP frequency changes and accumulates error.
+		 */
+		rate = clamp(rate + phase, -500000LL, 500000LL);
+		tx.freq = div_s64(rate * 65536, 1000);
+		if (do_adjtimex(&tx) < 0)
+			goto sleep;
+		WRITE_ONCE(sync_ppb, (long)rate);
+		WRITE_ONCE(sync_updates, sync_updates + 1);
+		prev = s;
+sleep:
+		/* A 32-second poll accumulated 575 us across a real 23 ppm host
+		 * frequency change. At 100 ms even a 500 ppm change adds only 50 us
+		 * before detection. Sampling uses host vDSO reads in kernel context.
+		 */
+		msleep_interruptible(100);
+	}
+	return 0;
+}
+
+static int __init clock_sync_init(void)
+{
+	struct task_struct *task;
+	int ret = sysfs_create_file(kernel_kobj, &clock_attr.attr);
+
+	if (ret || !uml_vdso_clock_enabled || !harddind_clock_sync)
+		return ret;
+	task = kthread_run(clock_sync_thread, NULL, "uml-clock-sync");
+	if (IS_ERR(task))
+		return PTR_ERR(task);
+	pr_info("HARDDIND_VDSO host clock discipline enabled\n");
+	return 0;
+}
+late_initcall(clock_sync_init);
