+/* Use only the frequency discovery used by native Intel TSC timekeeping.
+ * Do not fit a TSC/host-clock offset: it drifts when either clock is slewed.
+ */
+unsigned long os_vdso_tsc_khz(void)
+{
+#ifdef __x86_64__
+	unsigned int a, b, c, d, den, num, crystal;
+	char source[16];
+	FILE *f;
+
+	if (!__get_cpuid(0, &a, &b, &c, &d) || a < 0x15 ||
+	    b != 0x756e6547 || d != 0x49656e69 || c != 0x6c65746e)
+		return 0;
+	if (!__get_cpuid(0x80000007, &a, &b, &c, &d) || !(d & (1U << 8)))
+		return 0;
+	f = fopen("/sys/devices/system/clocksource/clocksource0/current_clocksource", "r");
+	if (!f)
+		return 0;
+	a = fscanf(f, "%15s", source) == 1 && !strcmp(source, "tsc");
+	fclose(f);
+	if (!a || !__get_cpuid_count(0x15, 0, &den, &num, &crystal, &d) ||
+	    !den || !num)
+		return 0;
+	crystal /= 1000;
+	if (!crystal && __get_cpuid(0x16, &a, &b, &c, &d))
+		crystal = (unsigned long long)a * 1000 * den / num;
+	return (unsigned long long)crystal * num / den;
+#else
+	return 0;
+#endif
+}
