+static __always_inline u64 uml_read_tsc(void)
+{
+	u32 lo, hi;
+
+	/* Intel LFENCE orders RDTSC after the vvar sequence/data loads. */
+	asm volatile("lfence; rdtsc" : "=a" (lo), "=d" (hi) : : "memory");
+	return ((u64)hi << 32) | lo;
+}
