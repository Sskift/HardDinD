+/* Containers share the host's monotonic epoch as well as its wall clock. */
+void __init read_persistent_wall_and_boot_offset(struct timespec64 *wall,
+					   struct timespec64 *boot)
+{
+#ifdef CONFIG_X86_64
+	if (harddind_vdso_clock && time_travel_mode == TT_MODE_OFF) {
+		s64 best = S64_MAX, mono = 0, real = 0;
+		int i;
+
+		for (i = 0; i < 16; i++) {
+			s64 before = os_nsecs();
+			s64 now = os_persistent_clock_emulation();
+			s64 span = os_nsecs() - before;
+
+			if (span < best) {
+				best = span;
+				mono = before + span / 2;
+				real = now;
+			}
+		}
+		*wall = ns_to_timespec64(real);
+		*boot = ns_to_timespec64(mono);
+		uml_host_wall_offset = real - mono;
+		return;
+	}
+#endif
+	read_persistent_clock64(wall);
+	*boot = ns_to_timespec64(local_clock());
+}
