+/* The generic datastore maps real time data one page after a timens page.
+ * Offsets are frozen before first use; vdso_join_timens zaps both mappings.
+ */
+static __always_inline const struct vdso_clock *real_clock(const struct vdso_clock *vc)
+{
+	if (READ_ONCE(vc->clock_mode) == VDSO_CLOCKMODE_TIMENS)
+		return (const void *)vc + VDSO_TIMENS_PAGE_OFFSET * PAGE_SIZE;
+	return vc;
+}
+static __always_inline int read_clock(clockid_t clock, struct __kernel_timespec *ts)
+{
+	const struct vdso_clock *vc, *vcns;
+	s64 sec;
+	u64 ns, cycles, delta;
+	u32 seq, mode;
+
+	if (clock != CLOCK_REALTIME && clock != CLOCK_MONOTONIC &&
+	    clock != CLOCK_BOOTTIME && clock != CLOCK_MONOTONIC_RAW)
+		return -1;
+	vcns = &vdso_u_time_data.clock_data[clock == CLOCK_MONOTONIC_RAW ? CS_RAW : CS_HRES_COARSE];
+	vc = real_clock(vcns);
+	for (;;) {
+		seq = READ_ONCE(vc->seq);
+		barrier();
+		mode = READ_ONCE(vc->clock_mode);
+		if (unlikely(mode != VDSO_CLOCKMODE_TSC))
+			return -1;
+		if (unlikely(seq & 1)) {
+			asm volatile("pause" : : : "memory");
+			continue;
+		}
+		sec = vc->basetime[clock].sec;
+		ns = vc->basetime[clock].nsec;
+		cycles = uml_read_tsc();
+		delta = (cycles - vc->cycle_last) & vc->mask;
+		/* Match timekeeping_cycles_to_ns(), including its overflow limit. */
+		if (unlikely(delta > vc->max_cycles))
+			return -1;
+		ns = (delta * vc->mult + ns) >> vc->shift;
+		barrier();
+		if (seq == READ_ONCE(vc->seq))
+			break;
+	}
+	if (vc != vcns) {
+		sec += vcns->offset[clock].sec;
+		ns += vcns->offset[clock].nsec;
+	}
+	ts->tv_sec = sec + ns / NSEC_PER_SEC;
+	ts->tv_nsec = ns % NSEC_PER_SEC;
+	return 0;
+}
+
+/* A tail-called leaf keeps TSC register saves out of coarse reads. */
+static noinline int clock_coarse(clockid_t clock, struct __kernel_timespec *ts)
+{
+	const struct vdso_clock *vcns = &vdso_u_time_data.clock_data[CS_HRES_COARSE];
+	const struct vdso_clock *vc = real_clock(vcns);
+	u32 seq;
+	s64 sec;
+	u64 ns;
+	long ret;
+
+	for (;;) {
+		seq = READ_ONCE(vc->seq);
+		barrier();
+		if (unlikely(READ_ONCE(vc->clock_mode) != VDSO_CLOCKMODE_TSC))
+			break;
+		if (unlikely(seq & 1)) {
+			asm volatile("pause" : : : "memory");
+			continue;
+		}
+		sec = vc->basetime[clock].sec;
+		ns = vc->basetime[clock].nsec;
+		barrier();
+		if (seq == READ_ONCE(vc->seq)) {
+			if (vc != vcns) {
+				sec += vcns->offset[clock].sec;
+				ns += vcns->offset[clock].nsec;
+				if (ns >= NSEC_PER_SEC) {
+					ns -= NSEC_PER_SEC;
+					sec++;
+				}
+			}
+			ts->tv_sec = sec;
+			ts->tv_nsec = ns;
+			return 0;
+		}
+	}
+	asm volatile("syscall" : "=a" (ret)
+		: "0" (__NR_clock_gettime), "D" (clock), "S" (ts)
+		: "rcx", "r11", "memory");
+	return ret;
+}
 
