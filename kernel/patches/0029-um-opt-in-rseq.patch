 #define instruction_pointer(regs) PT_REGS_IP(regs)
 
+static inline void instruction_pointer_set(struct pt_regs *regs,
+				   unsigned long val)
+{
+	PT_REGS_IP(regs) = val;
+}
+
 #define PTRACE_OLDSETOPTIONS 21
 
