--- a/arch/um/kernel/smp.c
+++ b/arch/um/kernel/smp.c
@@ -15,6 +15,7 @@
 #include <linux/threads.h>
 #include <linux/cpu.h>
 #include <linux/hardirq.h>
+#include <linux/irq_work.h>
 #include <linux/smp.h>
 #include <linux/smp-internal.h>
 #include <init.h>
@@ -27,7 +28,23 @@
 	UML_IPI_CALL_SINGLE,
 	UML_IPI_CALL,
 	UML_IPI_STOP,
+	UML_IPI_IRQ_WORK,
 };
+
+bool uml_irq_work_ready __ro_after_init;
+static bool harddind_irq_work __initdata = true;
+
+static int __init irq_work_setup(char *str)
+{
+	return !kstrtobool(str, &harddind_irq_work);
+}
+__setup("harddind_irq_work=", irq_work_setup);
+
+void arch_irq_work_raise(void)
+{
+	if (READ_ONCE(uml_irq_work_ready))
+		os_send_ipi(smp_processor_id(), UML_IPI_IRQ_WORK);
+}
 
 void arch_smp_send_reschedule(int cpu)
 {
@@ -82,6 +99,11 @@
 	case UML_IPI_CALL:
 		inc_irq_stat(irq_call_count);
 		generic_smp_call_function_interrupt();
+		break;
+
+	case UML_IPI_IRQ_WORK:
+		inc_irq_stat(irq_work_count);
+		irq_work_run();
 		break;
 
 	case UML_IPI_STOP:
@@ -168,6 +190,11 @@
 	unsigned long deadline;
 
 	os_init_smp();
+	if (harddind_irq_work) {
+		WRITE_ONCE(uml_irq_work_ready, true);
+		/* Drain work queued before the boot CPU could receive IPIs. */
+		arch_irq_work_raise();
+	}
 
 	for_each_possible_cpu(cpu) {
 		if (cpu == me)
