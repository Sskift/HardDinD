From: HardDinD developers
Subject: [EXPERIMENT] um: close deferred IPI idle wakeup race

Software IRQ masking no longer makes an IPI pending in the host signal
queue. Block it across the idle check/poll and also inspect software pending
work, then restore the exact incoming mask.

--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -353,9 +353,11 @@
 int os_send_ipi(int cpu, int vector);
 void os_local_ipi_enable(void);
 void os_local_ipi_disable(void);
+int os_local_ipi_pending(void);
 #else /* !CONFIG_SMP */
 static inline void os_local_ipi_enable(void) { }
 static inline void os_local_ipi_disable(void) { }
+static inline int os_local_ipi_pending(void) { return 0; }
 #endif /* CONFIG_SMP */
 
 #endif
--- a/arch/um/os-Linux/smp.c
+++ b/arch/um/os-Linux/smp.c
@@ -190,6 +190,11 @@
 	__local_ipi_set(1);
 }
 
+int os_local_ipi_pending(void)
+{
+	return defer_ipi && uml_ipi_defer_pending(&pending_ipis);
+}
+
 void os_local_ipi_disable(void)
 {
 	if (defer_ipi)
--- a/arch/um/os-Linux/time.c
+++ b/arch/um/os-Linux/time.c
@@ -134,24 +134,25 @@
  */
 void os_idle_sleep(void)
 {
-	sigset_t set;
+	sigset_t set, previous;
 
-	/*
-	 * Block SIGALRM while performing the need_resched check.
-	 * Note that, because IRQs are disabled, the IPI signal is
-	 * already blocked.
+	/* Software IRQ masking can consume an IPI into pending_ipis before
+	 * poll starts. Block host delivery across the pending check and sleep:
+	 * older work is detected in software, newer work makes signalfd ready.
 	 */
 	sigemptyset(&set);
 	sigaddset(&set, SIGALRM);
-	sigprocmask(SIG_BLOCK, &set, NULL);
+	sigaddset(&set, IPI_SIGNAL);
+	if (sigprocmask(SIG_BLOCK, &set, &previous) < 0)
+		panic("Failed to block idle wake signals, errno = %d", errno);
 
-	/*
-	 * Because disabling IRQs does not block SIGALRM, it is also
-	 * necessary to check for any pending timer alarms.
-	 */
-	if (!uml_need_resched() && !timer_alarm_pending())
+	if (!uml_need_resched() && !timer_alarm_pending() &&
+	    !os_local_ipi_pending())
 		os_poll(1, &wake_signals);
 
-	/* Restore the signal mask. */
-	sigprocmask(SIG_UNBLOCK, &set, NULL);
+	/* The default path keeps IPI blocked until local IRQ enable. The
+	 * deferred path restores host delivery, retaining guest IRQ masking.
+	 */
+	if (sigprocmask(SIG_SETMASK, &previous, NULL) < 0)
+		panic("Failed to restore idle wake signals, errno = %d", errno);
 }
