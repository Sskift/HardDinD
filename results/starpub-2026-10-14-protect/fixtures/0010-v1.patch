+
+int protect(struct mm_id *mm_idp, unsigned long addr, unsigned long len, int prot)
+{
+	struct stub_syscall *sc;
+
+	/* Permission updates need adjacent addresses, not adjacent PFNs. */
+	sc = syscall_stub_get_previous(mm_idp, STUB_SYSCALL_MPROTECT, addr);
+	if (sc && sc->mem.prot == prot) {
+		sc->mem.length += len;
+		return 0;
+	}
+	sc = syscall_stub_alloc(mm_idp);
+	sc->syscall = STUB_SYSCALL_MPROTECT;
+	sc->mem.addr = addr;
+	sc->mem.length = len;
+	sc->mem.prot = prot;
 	return 0;
 }
 
