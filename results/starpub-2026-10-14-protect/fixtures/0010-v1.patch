@@ -15,12 +17,37 @@
 #include <skas.h>
 #include <kern_util.h>
 
+int um_mprotect_sync;
+static atomic_long_t protect_pages = ATOMIC_LONG_INIT(0);
+
+static int __init setup_mprotect_sync(char *str, int *add)
+{
+	if (strcmp(str, "0") && strcmp(str, "1"))
+		return -EINVAL;
+	um_mprotect_sync = str[0] == '1';
+	*add = 0;
+	return 0;
+}
+__uml_setup("mprotect_sync=", setup_mprotect_sync,
+"mprotect_sync=<0|1>\n"
+"    Use host mprotect for known, unchanged guest mappings.\n");
+
+static void report_mprotect_sync(void)
+{
+	if (um_mprotect_sync)
+		os_info("HARDDIND_MPROTECT_SYNC enabled=1 pages=%ld\n",
+			atomic_long_read(&protect_pages));
+}
+__uml_exitcall(report_mprotect_sync);
+
 struct vm_ops {
 	struct mm_id *mm_idp;
 
 	int (*mmap)(struct mm_id *mm_idp,
 		    unsigned long virt, unsigned long len, int prot,
 		    int phys_fd, unsigned long long offset);
+	int (*protect)(struct mm_id *mm_idp,
+		       unsigned long virt, unsigned long len, int prot);
 	int (*unmap)(struct mm_id *mm_idp,
 		     unsigned long virt, unsigned long len);
 };
@@ -81,8 +108,13 @@
