From: HardDinD developers
Subject: [EXPERIMENT] um: synchronize permission-only changes with mprotect

Only tag PTEs whose host backing is already known and unchanged. New maps,
clears and PFN replacement retain mmap/munmap. Keep synchronous invalidation
and coalesce adjacent protection commands without requiring contiguous PFNs.

--- a/arch/um/include/asm/pgtable.h
+++ b/arch/um/include/asm/pgtable.h
@@ -13,6 +13,9 @@
 
 #define _PAGE_PRESENT	0x001
 #define _PAGE_NEEDSYNC	0x002
+/* Internal hint: host mapping exists with this PFN; only protection changed. */
+#define _PAGE_PROTECT_ONLY 0x004
+extern int um_mprotect_sync;
 #define _PAGE_RW	0x020
 #define _PAGE_USER	0x040
 #define _PAGE_ACCESSED	0x080
@@ -191,7 +194,7 @@
 
 static inline pte_t pte_mkuptodate(pte_t pte)
 {
-	pte_clear_bits(pte, _PAGE_NEEDSYNC);
+	pte_clear_bits(pte, _PAGE_NEEDSYNC | _PAGE_PROTECT_ONLY);
 	return pte;
 }
 
@@ -208,6 +211,18 @@
 	 * update_pte_range knows to unmap it.
 	 */
 
+	pte_clear_bits(pteval, _PAGE_PROTECT_ONLY);
+	if (um_mprotect_sync && pte_present(pteval)) {
+		pte_t old = READ_ONCE(*pteptr);
+
+		/* Never transfer the hint from another PTE or address space.
+		 * A dirty mapping without this hint may still be queued: use mmap.
+		 */
+		if (pte_present(old) &&
+		    !((pte_val(old) ^ pte_val(pteval)) & PAGE_MASK) &&
+		    (!pte_needsync(old) || pte_get_bits(old, _PAGE_PROTECT_ONLY)))
+			pte_set_bits(pteval, _PAGE_PROTECT_ONLY);
+	}
 	WRITE_ONCE(*pteptr, pte_mkneedsync(pteval));
 }
 
@@ -247,10 +262,33 @@
 	um_tlb_mark_sync(mm, addr, addr + length);
 }
 
+/* UML has no hardware A/D writer. The caller holds the PTE lock;
+ * retaining the PTE during this transaction preserves known host backing.
+ * The synchronizer only clears NEEDSYNC with cmpxchg, so it cannot discard
+ * a concurrent permission update. The default path retains the old clear.
+ */
+#define __HAVE_ARCH_PTEP_MODIFY_PROT_TRANSACTION
+static inline pte_t ptep_modify_prot_start(struct vm_area_struct *vma,
+					 unsigned long addr, pte_t *ptep)
+{
+	pte_t old = READ_ONCE(*ptep);
+
+	if (!um_mprotect_sync)
+		pte_clear(vma->vm_mm, addr, ptep);
+	return old;
+}
+
+static inline void ptep_modify_prot_commit(struct vm_area_struct *vma,
+					  unsigned long addr, pte_t *ptep,
+					  pte_t old_pte, pte_t pte)
+{
+	set_ptes(vma->vm_mm, addr, ptep, pte, 1);
+}
+
 #define __HAVE_ARCH_PTE_SAME
 static inline int pte_same(pte_t pte_a, pte_t pte_b)
 {
-	return !((pte_val(pte_a) ^ pte_val(pte_b)) & ~_PAGE_NEEDSYNC);
+	return !((pte_val(pte_a) ^ pte_val(pte_b)) & ~(_PAGE_NEEDSYNC | _PAGE_PROTECT_ONLY));
 }
 
 #define __virt_to_page(virt) phys_to_page(__pa(virt))
