+func TestHarddindManagedAliasMembership(t *testing.T) {
+	managed := []string{"10.0.2.16", "10.0.2.17", "10.0.2.254", "fd00::10", "fd00::100:1", "fd00::100:ffff"}
+	for _, s := range managed {
+		assert.Check(t, harddindManagedAlias(netip.MustParseAddr(s)), s)
+	}
+	unmanaged := []string{"10.0.2.15", "10.0.2.2", "10.0.2.255", "fd00::15", "fd00::2",
+		"fd00::100:0", "fd01::100:1", "127.0.0.1"}
+	for _, s := range unmanaged {
+		assert.Check(t, !harddindManagedAlias(netip.MustParseAddr(s)), s)
+	}
+}
