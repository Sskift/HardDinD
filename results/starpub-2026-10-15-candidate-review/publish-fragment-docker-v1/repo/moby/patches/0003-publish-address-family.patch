+package nat
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+
+	"github.com/moby/moby/v2/daemon/libnetwork/portmapperapi"
+	"github.com/moby/moby/v2/daemon/libnetwork/types"
+	"gotest.tools/v3/assert"
+)
+
+// fakeAliasPDC emulates HardDinD guest alias reservation with live
+// reference counting, using bindable loopback addresses so the real OS port
+// allocator in MapPorts works inside the test environment.
+type fakeAliasPDC struct {
+	mu        sync.Mutex
+	refs      map[netip.Addr]int
+	failAddOn map[netip.Addr]bool
+}
+
+func newFakeAliasPDC() *fakeAliasPDC {
+	return &fakeAliasPDC{refs: map[netip.Addr]int{}, failAddOn: map[netip.Addr]bool{}}
+}
+
+func (f *fakeAliasPDC) ChildHostIP(_ string, hostIP netip.Addr) (netip.Addr, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	hostIP = hostIP.Unmap()
+	f.refs[hostIP]++
+	// Distinct loopback addresses stand in for the guest aliases.
+	return hostIP, nil
+}
+
+func (f *fakeAliasPDC) ReleaseChildIP(hostIP netip.Addr) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.refs[hostIP.Unmap()]--
+	if f.refs[hostIP.Unmap()] == 0 {
+		delete(f.refs, hostIP.Unmap())
+	}
+	return nil
+}
+
+func (f *fakeAliasPDC) AddPort(_ context.Context, _ string, hostIP, _ netip.Addr, _ int) (func() error, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.failAddOn[hostIP.Unmap()] {
+		return nil, assertError("simulated hostfwd bind conflict")
+	}
+	return func() error { return nil }, nil
+}
+
+func (f *fakeAliasPDC) outstanding() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	total := 0
+	for _, n := range f.refs {
+		total += n
+	}
+	return total
+}
+
+type errString string
+
+func (e errString) Error() string { return string(e) }
+func assertError(s string) error  { return errString(s) }
+
+func reqFor(ip string) portmapperapi.PortBindingReq {
+	return portmapperapi.PortBindingReq{
+		PortBinding: types.PortBinding{
+			Proto:    types.TCP,
+			Port:     7777,
+			HostIP:   net.ParseIP(ip),
+			HostPort: 0,
+		},
+	}
+}
+
+func TestMapPortsReservesAndReleasesDistinctHostIPs(t *testing.T) {
+	pdc := newFakeAliasPDC()
+	pm := NewPortMapper(Config{RlkClient: pdc})
+	pbs, err := pm.MapPorts(context.Background(),
+		[]portmapperapi.PortBindingReq{reqFor("127.0.0.1"), reqFor("127.0.0.2")})
+	assert.NilError(t, err)
+	assert.Equal(t, len(pbs), 2)
+	assert.Equal(t, pdc.outstanding(), 2, "one guest alias reference per host IP")
+
+	assert.NilError(t, pm.UnmapPorts(context.Background(), pbs))
+	assert.Equal(t, pdc.outstanding(), 0, "all alias references released")
+}
+
+// A host-side bind conflict arriving while building one binding must roll
+// back every guest alias reserved for the failed MapPorts call.
+func TestMapPortsHostfwdConflictRollsBackAllReservations(t *testing.T) {
+	pdc := newFakeAliasPDC()
+	pdc.failAddOn[netip.MustParseAddr("127.0.0.2")] = true
+	pm := NewPortMapper(Config{RlkClient: pdc})
+	_, err := pm.MapPorts(context.Background(),
+		[]portmapperapi.PortBindingReq{reqFor("127.0.0.1"), reqFor("127.0.0.2")})
+	assert.Check(t, err != nil)
+	assert.Equal(t, pdc.outstanding(), 0, "conflict must leave no reserved guest aliases behind")
+}
+
+// A reservation conflict before bindings are built (here: port allocation
+// failure on a fixed privileged range is simulated via an already-bound
+// port) must also release every alias.
+func TestMapPortsBindFailureReleasesReservations(t *testing.T) {
+	pdc := newFakeAliasPDC()
+	pm := NewPortMapper(Config{RlkClient: pdc})
+
+	holder, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NilError(t, err)
+	defer holder.Close()
+	occupied := holder.Addr().(*net.TCPAddr).Port
+
+	cfg := []portmapperapi.PortBindingReq{{
+		PortBinding: types.PortBinding{
+			Proto: types.TCP, Port: 7777, HostIP: net.ParseIP("127.0.0.1"),
+			HostPort: uint16(occupied), HostPortEnd: uint16(occupied),
+		},
+	}}
+	_, err = pm.MapPorts(context.Background(), cfg)
+	assert.Check(t, err != nil)
+	assert.Equal(t, pdc.outstanding(), 0)
