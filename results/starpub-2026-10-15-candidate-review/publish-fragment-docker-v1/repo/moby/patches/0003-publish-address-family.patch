+func TestHarddindManagerIPv6PoolMatchesValidatedCIDR(t *testing.T) {
+	backend := newFakeAddrBackend()
+	m := newTestManager(t, backend)
+
+	first, err := m.Reserve(netip.MustParseAddr("2001:db8::1"))
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(first, netip.MustParseAddr("fd00::100:1")))
+	assert.Check(t, harddindDyn6Prefix.Contains(first))
+
+	last := harddindDynAlias(harddindDyn6Count-1, true)
+	assert.Check(t, is.Equal(last, netip.MustParseAddr("fd00::100:ffff")))
+	assert.Check(t, harddindDyn6Prefix.Contains(last))
+	assert.NilError(t, m.Release(netip.MustParseAddr("2001:db8::1")))
+}
+
+func TestHarddindManagerPoolExhaustionAndRecovery(t *testing.T) {
+	backend := newFakeAddrBackend()
+	m := newTestManager(t, backend)
+
+	// Shrink the pool by marking all but two v4 slots occupied (e.g. other
+	// live publications); allocation must fail loudly, never collapse.
+	allocated := 0
+	for i := 2; i < harddindDyn4Count; i++ {
+		a := harddindDynAlias(i, false)
+		m.used[a] = struct{}{}
+		allocated++
+	}
+	first, err := m.Reserve(netip.MustParseAddr("127.0.0.1"))
+	assert.NilError(t, err)
+	second, err := m.Reserve(netip.MustParseAddr("127.0.0.2"))
+	assert.NilError(t, err)
+	_, err = m.Reserve(netip.MustParseAddr("127.0.0.3"))
+	assert.Check(t, err != nil)
+	assert.Check(t, is.ErrorContains(err, "is exhausted"))
+	// Nothing was half-assigned for the failed reservation.
+	assert.Equal(t, len(m.aliases), 2)
+	assert.NilError(t, m.Release(netip.MustParseAddr("127.0.0.1")))
+	recovered, err := m.Reserve(netip.MustParseAddr("127.0.0.3"))
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(recovered, first))
+	assert.Check(t, recovered != second)
+}
+
+func TestHarddindManagerNetlinkFailureRollsBackNothing(t *testing.T) {
+	backend := newFakeAddrBackend()
+	target := harddindDynAlias(0, false)
+	backend.failNext[target] = true
+	m := newTestManager(t, backend)
+
+	_, err := m.Reserve(netip.MustParseAddr("127.0.0.1"))
+	assert.Check(t, is.ErrorContains(err, "simulated netlink EEXIST"))
+	assert.Equal(t, len(m.aliases), 0)
+	assert.Equal(t, len(m.refs), 0)
+	// The slot is still free: retry after the transient failure succeeds.
+	again, err := m.Reserve(netip.MustParseAddr("127.0.0.1"))
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(again, target))
+}
