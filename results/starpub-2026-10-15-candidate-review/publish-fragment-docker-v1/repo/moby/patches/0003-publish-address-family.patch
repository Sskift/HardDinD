+++ b/daemon/libnetwork/internal/rlkclient/harddind_aliases_linux.go
@@ -0,0 +1,304 @@
+// HardDinD exact-address alias manager.
+//
+// Every distinct host IP a container publishes on is represented inside the
+// guest by its own exact secondary address on the slirp uplink. Dockerd's
+// port allocator, firewall and userland proxy then see the same "same port on
+// distinct IPs / wildcard vs specific" semantics as on a normal host, while
+// the outer network-backend still binds the real requested parent IP.
+//
+// Secondary addresses are added and removed with netlink (RTM_NEWADDR /
+// RTM_DELADDR) inside the guest network namespace dockerd already administers.
+// No nonlocal_bind/freebind sysctls and no outer-host privileges are used.
+// Reservations are reference counted across protocols (TCP+UDP on one host IP
+// share one alias); the exact address is removed with the last mapping and
+// its slot becomes reusable.
+
+package rlkclient
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+
+	"github.com/vishvananda/netlink"
+	"golang.org/x/sys/unix"
+)
+
+const harddindPublishIfaceEnv = "HARDDIND_PUBLISH_IFACE"
+
+var (
+	harddindPrimary4  = netip.MustParseAddr("10.0.2.15") // never pruned/touched
+	harddindPrimary6  = netip.MustParseAddr("fd00::15")  // never pruned/touched
+	harddindWildcard4 = netip.MustParseAddr("10.0.2.16") // parent 0.0.0.0
+	harddindWildcard6 = netip.MustParseAddr("fd00::10")  // parent ::
+
+	harddindDyn4First = [4]byte{10, 0, 2, 17}
+	harddindDyn4Count = 238 // 10.0.2.17 .. 10.0.2.254 (/24 broadcast excluded)
+	harddindV4Prefix  = netip.MustParsePrefix("10.0.2.0/24")
+
+	// fd00::100:0/112; dynamic aliases fd00::100:1 .. fd00::100:ffff.
+	harddindV6Prefix    = netip.MustParsePrefix("fd00::/64")
+	harddindDyn6Prefix  = netip.MustParsePrefix("fd00::100:0/112")
+	harddindDyn6First32 = uint32(0x01000001)
+	harddindDyn6Count   = 0xffff
+)
+
+// harddindAddrBackend is the small netlink surface the manager needs. It
+// exists so reservation/rollback logic can be unit-tested without a network
+// namespace.
+type harddindAddrBackend interface {
+	AddAddress(ifindex int, addr netip.Addr) error
+	RemoveAddress(ifindex int, addr netip.Addr) error
+	ListAddresses(ifindex int) ([]netip.Addr, error)
+}
+
+type harddindAliasManager struct {
+	backend harddindAddrBackend
+	ifindex int
+
+	mu      sync.Mutex
+	refs    map[netip.Addr]int        // host IP -> live mapping count
+	aliases map[netip.Addr]netip.Addr // host IP -> guest alias
+	used    map[netip.Addr]struct{}   // guest aliases currently assigned
+}
+
+func newHarddindAliasManager() (*harddindAliasManager, error) {
+	iface := os.Getenv(harddindPublishIfaceEnv)
+	if iface == "" {
+		return nil, fmt.Errorf("%s is not set", harddindPublishIfaceEnv)
+	}
+	link, err := netlink.LinkByName(iface)
+	if err != nil {
+		return nil, fmt.Errorf("lookup uplink %q: %w", iface, err)
+	}
+	m := &harddindAliasManager{
+		backend: &harddindNetlinkBackend{},
+		ifindex: link.Attrs().Index,
+		refs:    make(map[netip.Addr]int),
+		aliases: make(map[netip.Addr]netip.Addr),
+		used:    make(map[netip.Addr]struct{}),
+	}
+	if err := m.reset(); err != nil {
+		return nil, err
+	}
+	return m, nil
+}
+
+// reset removes addresses a previous daemon instance left in the alias pools
+// (crash recovery) and assigns the permanent wildcard aliases. The primary
+// addresses are never touched.
+func (m *harddindAliasManager) reset() error {
+	existing, err := m.backend.ListAddresses(m.ifindex)
+	if err != nil {
+		return fmt.Errorf("list uplink addresses: %w", err)
+	}
+	for _, addr := range existing {
+		if harddindManagedAlias(addr) {
+			if err := m.backend.RemoveAddress(m.ifindex, addr); err != nil {
+				return fmt.Errorf("prune stale alias %s: %w", addr, err)
+			}
+		}
+	}
+	for _, wildcard := range []netip.Addr{harddindWildcard4, harddindWildcard6} {
+		if err := m.backend.AddAddress(m.ifindex, wildcard); err != nil {
+			return fmt.Errorf("assign wildcard alias %s: %w", wildcard, err)
+		}
+		m.used[wildcard] = struct{}{}
+	}
+	return nil
+}
+
+// Reserve returns the exact guest alias for hostIP, assigning it on the
+// uplink on first use and counting later references.
+func (m *harddindAliasManager) Reserve(hostIP netip.Addr) (netip.Addr, error) {
+	if hostIP.Is4() && hostIP.IsUnspecified() {
+		return harddindWildcard4, nil
+	}
+	if hostIP.Is6() && hostIP.IsUnspecified() {
+		return harddindWildcard6, nil
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if alias, ok := m.aliases[hostIP]; ok {
+		m.refs[hostIP]++
+		return alias, nil
+	}
+	alias, err := m.allocate(hostIP)
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	if err := m.backend.AddAddress(m.ifindex, alias); err != nil {
+		return netip.Addr{}, fmt.Errorf("assign guest alias %s for host IP %s: %w", alias, hostIP, err)
+	}
+	m.used[alias] = struct{}{}
+	m.aliases[hostIP] = alias
+	m.refs[hostIP] = 1
+	return alias, nil
+}
+
+// Release drops one reference; the exact alias address is removed when the
+// last mapping for the host IP is torn down.
+func (m *harddindAliasManager) Release(hostIP netip.Addr) error {
+	if hostIP.IsUnspecified() {
+		return nil // wildcard aliases are permanent for the daemon lifetime
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	count, ok := m.refs[hostIP]
+	if !ok {
+		// Balanced calls are guaranteed by the port mapper; report rather
+		// than silently corrupting the refcount.
+		return fmt.Errorf("unbalanced release for host IP %s", hostIP)
+	}
+	alias := m.aliases[hostIP]
+	if count > 1 {
+		m.refs[hostIP] = count - 1
+		return nil
+	}
+	if err := m.backend.RemoveAddress(m.ifindex, alias); err != nil {
+		return fmt.Errorf("remove guest alias %s for host IP %s: %w", alias, hostIP, err)
+	}
+	delete(m.used, alias)
+	delete(m.aliases, hostIP)
+	delete(m.refs, hostIP)
+	return nil
+}
+
+func (m *harddindAliasManager) allocate(hostIP netip.Addr) (netip.Addr, error) {
+	is6 := hostIP.Is6()
+	count := harddindDyn4Count
+	if is6 {
+		count = harddindDyn6Count
+	}
+	for i := 0; i < count; i++ {
+		candidate := harddindDynAlias(i, is6)
+		if _, taken := m.used[candidate]; taken {
+			continue
+		}
+		return candidate, nil
+	}
+	return netip.Addr{}, fmt.Errorf("harddind publish alias pool for %s is exhausted (%d addresses)",
+		hostIP, count)
+}
+
+func harddindDynAlias(index int, is6 bool) netip.Addr {
+	if !is6 {
+		b := harddindDyn4First
+		b[3] += byte(index)
+		addr := netip.AddrFrom4(b)
+		if !harddindV4Prefix.Contains(addr) || addr == harddindPrimary4 {
+			panic("harddind v4 alias outside its configured pool")
+		}
+		return addr
+	}
+	var b [16]byte
+	b[0] = 0xfd
+	v := harddindDyn6First32 + uint32(index)
+	b[12], b[13], b[14], b[15] = byte(v>>24), byte(v>>16), byte(v>>8), byte(v)
+	addr := netip.AddrFrom16(b)
+	if !harddindDyn6Prefix.Contains(addr) || addr == harddindDyn6Prefix.Addr() {
+		panic("harddind v6 alias outside its configured /112 pool")
+	}
+	return addr
+}
+
+// harddindManagedAlias reports whether an address found on the uplink comes
+// from a wildcard or dynamic alias pool and may be pruned/reassigned. The
+// primaries are excluded explicitly.
+func harddindManagedAlias(addr netip.Addr) bool {
+	addr = addr.Unmap()
+	if addr == harddindPrimary4 || addr == harddindPrimary6 {
+		return false
+	}
+	if addr.Is4() {
+		if addr == harddindWildcard4 {
+			return true
+		}
+		first := harddindDynAlias(0, false)
+		last := harddindDynAlias(harddindDyn4Count-1, false)
+		return harddindV4Prefix.Contains(addr) && addr.Compare(first) >= 0 && addr.Compare(last) <= 0
+	}
+	if addr == harddindWildcard6 {
+		return true
+	}
+	return harddindDyn6Prefix.Contains(addr) && addr != harddindDyn6Prefix.Addr()
+}
+
+// harddindNetlinkBackend performs the exact address changes. IPv4 aliases are
+// /32 secondaries; the primary 10.0.2.15/24 already supplies the connected
+// route and the kernel answers ARP for every local address. IPv6 aliases are
+// /128 with NODAD so dockerd can bind() them immediately without waiting out
+// DAD tentative state; the primary fd00::15/64 supplies the on-link route.
+type harddindNetlinkBackend struct {
+	link netlink.Link
+}
+
+func (b *harddindNetlinkBackend) netlinkAddr(addr netip.Addr) *netlink.Addr {
+	if addr.Is4() {
+		return &netlink.Addr{IPNet: &net.IPNet{IP: net.IP(addr.AsSlice()), Mask: net.CIDRMask(32, 32)}}
+	}
+	nlAddr := &netlink.Addr{
+		IPNet: &net.IPNet{IP: net.IP(addr.AsSlice()), Mask: net.CIDRMask(128, 128)},
+		Flags: unix.IFA_F_NODAD,
+	}
+	return nlAddr
+}
+
+func (b *harddindNetlinkBackend) AddAddress(ifindex int, addr netip.Addr) error {
+	link, err := lookupCachedLink(b, ifindex)
+	if err != nil {
+		return err
+	}
+	return netlink.AddrAdd(link, b.netlinkAddr(addr))
+}
+
+func (b *harddindNetlinkBackend) RemoveAddress(ifindex int, addr netip.Addr) error {
+	link, err := lookupCachedLink(b, ifindex)
+	if err != nil {
+		return err
+	}
+	err = netlink.AddrDel(link, b.netlinkAddr(addr))
+	// A crash between listing and pruning may have removed it already.
+	if err != nil && !errors.Is(err, unix.ENOENT) && !errors.Is(err, unix.EADDRNOTAVAIL) {
+		return err
+	}
+	return nil
+}
+
+func (b *harddindNetlinkBackend) ListAddresses(ifindex int) ([]netip.Addr, error) {
+	link, err := lookupCachedLink(b, ifindex)
+	if err != nil {
+		return nil, err
+	}
+	nlAddrs, err := netlink.AddrList(link, netlink.FAMILY_ALL)
+	if err != nil {
+		return nil, err
+	}
+	addrs := make([]netip.Addr, 0, len(nlAddrs))
+	for _, a := range nlAddrs {
+		if a.IP == nil || a.IP.IsMulticast() {
+			continue
+		}
+		ip, ok := netip.AddrFromSlice(a.IP)
+		if !ok {
+			continue
+		}
+		addrs = append(addrs, ip.Unmap())
+	}
+	return addrs, nil
+}
+
+func lookupCachedLink(b *harddindNetlinkBackend, ifindex int) (netlink.Link, error) {
+	if b.link != nil && b.link.Attrs().Index == ifindex {
+		return b.link, nil
+	}
+	link, err := netlink.LinkByIndex(ifindex)
+	if err != nil {
+		return nil, fmt.Errorf("lookup uplink ifindex %d: %w", ifindex, err)
+	}
+	b.link = link
+	return link, nil
+}
