+// fakeAddrBackend records exact address changes instead of touching netlink.
+type fakeAddrBackend struct {
+	mu       sync.Mutex
+	addrs    map[netip.Addr]bool
+	added    []netip.Addr
+	removed  []netip.Addr
+	failNext map[netip.Addr]bool
+}
+
+func newFakeAddrBackend(existing ...netip.Addr) *fakeAddrBackend {
+	f := &fakeAddrBackend{
+		addrs:    make(map[netip.Addr]bool),
+		failNext: make(map[netip.Addr]bool),
+	}
+	for _, a := range existing {
+		f.addrs[a.Unmap()] = true
+	}
+	return f
+}
+
+func (f *fakeAddrBackend) AddAddress(_ int, addr netip.Addr) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	addr = addr.Unmap()
+	if f.failNext[addr] {
+		delete(f.failNext, addr)
+		return errors.New("simulated netlink EEXIST")
+	}
+	if f.addrs[addr] {
+		return errors.New("duplicate add")
+	}
+	f.addrs[addr] = true
+	f.added = append(f.added, addr)
+	return nil
+}
+
+func (f *fakeAddrBackend) RemoveAddress(_ int, addr netip.Addr) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	addr = addr.Unmap()
+	f.removed = append(f.removed, addr)
+	delete(f.addrs, addr)
+	return nil
+}
+
+func (f *fakeAddrBackend) ListAddresses(_ int) ([]netip.Addr, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	out := make([]netip.Addr, 0, len(f.addrs))
+	for a := range f.addrs {
+		out = append(out, a)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Less(out[j]) })
+	return out, nil
+}
+
+func (f *fakeAddrBackend) has(addr netip.Addr) bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.addrs[addr.Unmap()]
+}
+
+func newTestManager(t *testing.T, backend *fakeAddrBackend) *harddindAliasManager {
+	t.Helper()
+	m := &harddindAliasManager{
+		backend: backend,
+		ifindex: 7,
+		refs:    make(map[netip.Addr]int),
+		aliases: make(map[netip.Addr]netip.Addr),
+		used:    make(map[netip.Addr]struct{}),
+	}
+	assert.NilError(t, m.reset())
+	return m
+}
+
+func TestHarddindManagerPrunesStaleAndAssignsWildcards(t *testing.T) {
+	stale4 := netip.MustParseAddr("10.0.2.42")    // stale dynamic alias
+	stale6 := netip.MustParseAddr("fd00::100:77") // stale dynamic alias
+	primary4 := harddindPrimary4
+	primary6 := harddindPrimary6
+	unrelated := netip.MustParseAddr("192.168.9.9")
+	backend := newFakeAddrBackend(stale4, stale6, primary4, primary6, unrelated)
+	m := newTestManager(t, backend)
+
+	assert.Check(t, !backend.has(stale4), "stale v4 alias must be pruned")
+	assert.Check(t, !backend.has(stale6), "stale v6 alias must be pruned")
+	assert.Check(t, backend.has(primary4), "primary v4 must be untouched")
+	assert.Check(t, backend.has(primary6), "primary v6 must be untouched")
+	assert.Check(t, backend.has(unrelated), "unrelated addresses must be untouched")
+	assert.Check(t, backend.has(harddindWildcard4))
+	assert.Check(t, backend.has(harddindWildcard6))
+	// Wildcards do not participate in refcounting.
+	assert.NilError(t, m.Release(netip.MustParseAddr("0.0.0.0")))
+	assert.Check(t, backend.has(harddindWildcard4))
+}
+
+func TestHarddindManagerReserveReleaseRefcountAndReuse(t *testing.T) {
+	backend := newFakeAddrBackend()
+	m := newTestManager(t, backend)
+
+	ip1 := netip.MustParseAddr("127.0.0.1")
+	ip2 := netip.MustParseAddr("127.0.0.2")
+	a1, err := m.Reserve(ip1)
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(a1, netip.MustParseAddr("10.0.2.17")))
+	// TCP and UDP on one host IP share one alias and one exact address.
+	a1again, err := m.Reserve(ip1)
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(a1again, a1))
+	assert.Equal(t, m.refs[ip1], 2)
+
+	a2, err := m.Reserve(ip2)
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(a2, netip.MustParseAddr("10.0.2.18")))
+
+	assert.NilError(t, m.Release(ip1))
+	assert.Check(t, backend.has(a1), "alias stays while a second mapping references it")
+	assert.NilError(t, m.Release(ip1))
+	assert.Check(t, !backend.has(a1), "exact address removed with last mapping")
+
+	// The freed slot is reused for a new host IP rather than monotonically
+	// leaking pool capacity over container churn.
+	a3, err := m.Reserve(netip.MustParseAddr("127.0.0.3"))
+	assert.NilError(t, err)
+	assert.Check(t, is.Equal(a3, a1))
+
+	err = m.Release(ip1)
+	assert.Check(t, err != nil, "unbalanced release must be reported")
+}
