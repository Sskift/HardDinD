From: HardDinD developers
Subject: [EXPERIMENT] um: defer IPI delivery without repeated host signal masks

Retain host signal delivery and atomically coalesce pending guest vectors.
Only drain work with guest interrupts enabled; close the final owner release
race with a shared pending/owner word. The default path stays unchanged.

--- a/arch/um/include/shared/ipi-defer.h
+++ b/arch/um/include/shared/ipi-defer.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_IPI_DEFER_H
+#define __UM_IPI_DEFER_H
+
+/* Pending vectors and the drain owner share one word. Releasing the owner
+ * succeeds only with no pending vectors, closing the final-enable race. */
+#define UML_IPI_DRAIN_ACTIVE (1U << 31)
+struct uml_ipi_defer { unsigned int state; };
+
+static inline void uml_ipi_defer_add(struct uml_ipi_defer *d, unsigned int vector)
+{
+	__atomic_fetch_or(&d->state, 1U << vector, __ATOMIC_RELEASE);
+}
+
+static inline int uml_ipi_defer_pending(struct uml_ipi_defer *d)
+{
+	return __atomic_load_n(&d->state, __ATOMIC_ACQUIRE) & ~UML_IPI_DRAIN_ACTIVE;
+}
+
+static inline int uml_ipi_defer_begin(struct uml_ipi_defer *d)
+{
+	return !(__atomic_fetch_or(&d->state, UML_IPI_DRAIN_ACTIVE,
+				  __ATOMIC_ACQ_REL) & UML_IPI_DRAIN_ACTIVE);
+}
+
+static inline unsigned int uml_ipi_defer_take(struct uml_ipi_defer *d)
+{
+	return __atomic_fetch_and(&d->state, UML_IPI_DRAIN_ACTIVE,
+				 __ATOMIC_ACQ_REL) & ~UML_IPI_DRAIN_ACTIVE;
+}
+
+static inline int uml_ipi_defer_end(struct uml_ipi_defer *d)
+{
+	unsigned int expected = UML_IPI_DRAIN_ACTIVE;
+	return __atomic_compare_exchange_n(&d->state, &expected, 0, 0,
+					  __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+#endif
--- a/arch/um/os-Linux/smp.c
+++ b/arch/um/os-Linux/smp.c
@@ -7,11 +7,13 @@
 #include <errno.h>
 #include <pthread.h>
 #include <signal.h>
+#include <string.h>
 #include <kern_util.h>
 #include <um_malloc.h>
 #include <init.h>
 #include <os.h>
 #include <smp.h>
+#include <ipi-defer.h>
 #include "internal.h"
 
 struct cpu_thread_data {
@@ -27,6 +29,72 @@
 }
 
 static pthread_t cpu_threads[CONFIG_NR_CPUS];
+
+static int defer_ipi;
+static __thread int ipi_host_unblocked;
+static __thread struct uml_ipi_defer pending_ipis;
+static struct {
+	unsigned long received, deferred, handled;
+} ipi_stats[CONFIG_NR_CPUS];
+
+static int __init setup_defer_ipi(char *str, int *add)
+{
+	if (strcmp(str, "0") && strcmp(str, "1")) {
+		os_info("defer_ipi must be 0 or 1\n");
+		return -1;
+	}
+	defer_ipi = str[0] == '1';
+	*add = 0;
+	return 0;
+}
+
+__uml_setup("defer_ipi=", setup_defer_ipi,
+"defer_ipi=<0|1>\n"
+"    Defer IPI work in software while guest interrupts are disabled.\n");
+
+static void report_deferred_ipis(void)
+{
+	unsigned long received = 0, deferred = 0, handled = 0;
+	if (!defer_ipi)
+		return;
+	for (int i = 0; i < CONFIG_NR_CPUS; i++) {
+		received += __atomic_load_n(&ipi_stats[i].received, __ATOMIC_RELAXED);
+		deferred += __atomic_load_n(&ipi_stats[i].deferred, __ATOMIC_RELAXED);
+		handled += __atomic_load_n(&ipi_stats[i].handled, __ATOMIC_RELAXED);
+	}
+	os_info("HARDDIND_DEFER_IPI enabled=1 received=%lu deferred=%lu handled=%lu\n",
+		received, deferred, handled);
+}
+__uml_exitcall(report_deferred_ipis);
+
+static void deliver_pending_ipis(void)
+{
+	if (!signals_enabled || !uml_ipi_defer_pending(&pending_ipis) ||
+	    !uml_ipi_defer_begin(&pending_ipis))
+		return;
+	/* Nested signal handlers only enqueue. CALL vectors drain their Linux
+	 * per-CPU work queues, and RESCHEDULE/STOP are level-triggered work;
+	 * repeated notifications for a vector may therefore be coalesced. */
+	do {
+		unsigned int bits;
+		signals_enabled = 0;
+		asm volatile("" ::: "memory");
+		um_trace_signals_off();
+		bits = uml_ipi_defer_take(&pending_ipis);
+		for (unsigned int vector = 0; bits; vector++, bits >>= 1) {
+			if (!(bits & 1))
+				continue;
+			__atomic_add_fetch(&ipi_stats[__curr_cpu].handled, 1,
+					   __ATOMIC_RELAXED);
+			uml_ipi_handler(vector);
+		}
+		um_trace_signals_on();
+		signals_enabled = 1;
+		asm volatile("" ::: "memory");
+		/* An IPI arriving before this CAS keeps ownership here. One
+		 * arriving afterwards acquires ownership in its signal handler. */
+	} while (!uml_ipi_defer_end(&pending_ipis));
+}
 
 static void *cpu_thread(void *arg)
 {
@@ -109,17 +177,44 @@
 
 void os_local_ipi_enable(void)
 {
+	if (defer_ipi) {
+		/* Secondary CPU threads start with host signals blocked. Open
+		 * the host IPI signal once; later IRQ masking is software only. */
+		if (!ipi_host_unblocked) {
+			ipi_host_unblocked = 1;
+			__local_ipi_set(1);
+		}
+		deliver_pending_ipis();
+		return;
+	}
 	__local_ipi_set(1);
 }
 
 void os_local_ipi_disable(void)
 {
+	if (defer_ipi)
+		return;
 	__local_ipi_set(0);
 }
 
 static void ipi_sig_handler(int sig, siginfo_t *si, void *uc)
 {
 	int save_errno = errno;
+
+	if (defer_ipi) {
+		int vector = si->si_value.sival_int;
+		if (vector < 0 || vector >= 31)
+			panic("Invalid deferred IPI vector %d", vector);
+		__atomic_add_fetch(&ipi_stats[__curr_cpu].received, 1,
+				   __ATOMIC_RELAXED);
+		if (!signals_enabled)
+			__atomic_add_fetch(&ipi_stats[__curr_cpu].deferred, 1,
+					   __ATOMIC_RELAXED);
+		uml_ipi_defer_add(&pending_ipis, vector);
+		deliver_pending_ipis();
+		errno = save_errno;
+		return;
+	}
 
 	signals_enabled = 0;
 	um_trace_signals_off();
