@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+//! Optional aggregate diagnostics. No timing or mutex updates when disabled.
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct Stats {
+    count: u64,
+    attempts: u64,
+    queue_ns: u128,
+    service_ns: u128,
+    reply_ns: u128,
+    total_ns: u128,
+    max_total_ns: u128,
+}
+#[derive(Default)]
+pub struct RequestProfile(Mutex<BTreeMap<(u32, u32), Stats>>);
+pub struct Sample {
+    profile: Arc<RequestProfile>,
+    key: (u32, u32),
+    received: Instant,
+    first_start: Option<Instant>,
+    service: Duration,
+    attempts: u64,
+}
+impl RequestProfile {
+    pub fn begin(self: &Arc<Self>, opcode: u32, lock_type: u32) -> Sample {
+        Sample { profile: self.clone(), key: (opcode, lock_type), received: Instant::now(),
+                 first_start: None, service: Duration::ZERO, attempts: 0 }
+    }
+}
+impl Sample {
+    pub fn start(&mut self) -> Instant {
+        let now = Instant::now();
+        self.first_start.get_or_insert(now);
+        self.attempts += 1;
+        now
+    }
+    pub fn end_service(&mut self, start: Instant) { self.service += start.elapsed(); }
+    pub fn finish(self, reply_start: Instant) {
+        let now = Instant::now();
+        let total = now.duration_since(self.received).as_nanos();
+        let mut rows = self.profile.0.lock().unwrap();
+        let row = rows.entry(self.key).or_default();
+        row.count += 1;
+        row.attempts += self.attempts;
+        row.queue_ns += self.first_start.unwrap().duration_since(self.received).as_nanos();
+        row.service_ns += self.service.as_nanos();
+        row.reply_ns += now.duration_since(reply_start).as_nanos();
+        row.total_ns += total;
+        row.max_total_ns = row.max_total_ns.max(total);
+    }
+}
+impl Drop for RequestProfile {
+    fn drop(&mut self) {
+        let rows = self.0.lock().unwrap();
+        for ((opcode, lock_type), s) in rows.iter() {
+            info!("HARDDIND_REQUEST_PROFILE {{\"opcode\":{},\"lock_type\":{},\"count\":{},\"attempts\":{},\"queue_ns\":{},\"service_ns\":{},\"reply_ns\":{},\"total_ns\":{},\"max_total_ns\":{}}}",
+                  opcode, lock_type, s.count, s.attempts, s.queue_ns, s.service_ns,
+                  s.reply_ns, s.total_ns, s.max_total_ns);
+        }
+        info!("HARDDIND_REQUEST_PROFILE_END rows={}", rows.len());
+    }
+}
+
+#[cfg(test)]
+mod harddind_tests {
+    use super::*;
+    #[test]
+    fn harddind_profile_concurrent_attempts_and_completion() {
+        let profile = Arc::new(RequestProfile::default());
+        let workers: Vec<_> = (0..8).map(|_| {
+            let profile = profile.clone();
+            std::thread::spawn(move || {
+                for _ in 0..128 {
+                    let mut sample = profile.begin(33, 2);
+                    for _ in 0..3 { let start = sample.start(); sample.end_service(start); }
+                    sample.finish(Instant::now());
+                }
+            })
+        }).collect();
+        for worker in workers { worker.join().unwrap(); }
+        let rows = profile.0.lock().unwrap();
+        let row = &rows[&(33, 2)];
+        assert_eq!(row.count, 1024);
+        assert_eq!(row.attempts, 3072);
+        assert!(row.queue_ns + row.service_ns + row.reply_ns <= row.total_ns);
+        assert!(row.max_total_ns <= row.total_ns);
+    }
+}
