+#[cfg(test)]
+mod harddind_tests {
+    use super::*;
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+    use std::sync::{Arc, Barrier};
+
+    #[test]
+    fn harddind_concurrent_creation_masks() {
+        let base = std::env::temp_dir().join(format!("virtiofs-mask-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let barrier = Arc::new(Barrier::new(8));
+        let mut workers = Vec::new();
+        for i in 0..8 {
+            let base = base.clone();
+            let barrier = barrier.clone();
+            workers.push(std::thread::spawn(move || {
+                barrier.wait();
+                for j in 0..256 {
+                    let mask = [0o007, 0o027, 0o077, 0][(i + j) % 4];
+                    let file = {
+                        let _guard = ScopedUmask::new(mask);
+                        std::thread::yield_now();
+                        std::fs::OpenOptions::new().write(true).create_new(true).mode(0o666)
+                            .open(base.join(format!("{i}-{j}"))).unwrap()
+                    };
+                    assert_eq!(file.metadata().unwrap().permissions().mode() & 0o777, 0o666 & !mask);
+                }
+            }));
+        }
+        for worker in workers { worker.join().unwrap(); }
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
