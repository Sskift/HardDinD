 /// An RAII implementation of a scoped file mode creation mask (umask), it set the
 /// new umask. When this structure is dropped (falls out of scope), it set the previous
 /// value of the mask.
+// pthread workers share their fs_struct in HardDinD. Hold the lock until the
+// previous mask has been restored; never serialize unrelated file I/O.
+static UMASK_LOCK: Mutex<()> = Mutex::new(());
+
 pub struct ScopedUmask {
     umask: libc::mode_t,
+    _lock: MutexGuard<'static, ()>,
 }
 
 impl ScopedUmask {
     pub fn new(new_umask: u32) -> Self {
+        let lock = UMASK_LOCK.lock().unwrap();
         Self {
             umask: umask(new_umask),
+            _lock: lock,
         }
     }
 }
