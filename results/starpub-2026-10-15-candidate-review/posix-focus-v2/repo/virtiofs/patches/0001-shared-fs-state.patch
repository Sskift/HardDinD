+// Only operations using a temporary CWD take this lock. All other request
+// paths use descriptors or absolute paths, including reopening unlinked inodes.
+static WORKING_DIRECTORY: Mutex<()> = Mutex::new(());
+
 struct ScopedWorkingDirectory {
     back_to: RawFd,
+    _lock: MutexGuard<'static, ()>,
 }
 
 impl ScopedWorkingDirectory {
     fn new(new_wd: RawFd, old_wd: RawFd) -> ScopedWorkingDirectory {
+        let lock = WORKING_DIRECTORY.lock().unwrap();
         oslib::fchdir(new_wd).expect("the working directory should be changed");
-        ScopedWorkingDirectory { back_to: old_wd }
+        ScopedWorkingDirectory { back_to: old_wd, _lock: lock }
     }
 }
 
