#!/bin/sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc || exit 1
mount -t sysfs sysfs /sys || exit 1
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev || exit 1
mode=time
grep -q 'profile_trace=1' /proc/cmdline && mode=trace
echo "PROFILE_SHA256=$(sha256sum /profilebench | cut -d' ' -f1)"
/profilebench "$mode"
echo "PROFILE_STATUS=$?"
sync
poweroff -f
