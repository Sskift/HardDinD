From: HardDinD developers
Subject: [EXPERIMENT] um: optional bounded polling for seccomp rendezvous

Keep the default upstream behavior (seccomp_spin=0). Allow measurements
of bounded polling before a futex sleep in both participants, without
bypassing guest syscall handling. This is an experiment, not a claim of
native performance. CPU cost and scheduler pressure must be measured.

--- a/arch/um/os-Linux/start_up.c
+++ b/arch/um/os-Linux/start_up.c
@@ -421,6 +421,27 @@
 	}
 }
 
+/* Bounded polling is opt-in: keep the upstream sleeping path by default. */
+unsigned int uml_seccomp_spin_limit;
+static int __init uml_seccomp_spin_setup(char *line, int *add)
+{
+	char *end;
+	unsigned long value;
+
+	*add = 0;
+	errno = 0;
+	value = strtoul(line, &end, 10);
+	if (errno || end == line || *end || value > 10000)
+		fatal("Invalid seccomp_spin value, expected 0..10000\n");
+	uml_seccomp_spin_limit = value;
+	return 0;
+}
+__uml_setup("seccomp_spin=", uml_seccomp_spin_setup,
+"seccomp_spin=<0..10000>\n"
+"    Bounded polling before futex sleep in SECCOMP mode (default 0).\n"
+"    Experimental latency/CPU tradeoff; does not change guest syscalls.\n"
+);
+
 static int seccomp_config __initdata;
 
 static int __init uml_seccomp_config(char *line, int *add)
