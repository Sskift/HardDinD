From: HardDinD developers
Subject: [EXPERIMENT] um: lazy XSTATE handoff for the SECCOMP syscall path

In SECCOMP mode each guest syscall traps through a host SIGSYS: the host
saves the guest XSTATE into the parked signal frame on the runner's stub
stack and reloads it on rt_sigreturn. On top of those unavoidable hardware
save/restores, UML copied the full XSTATE image out of the frame into
current->...regs.fp on entry and back into the very same frame on exit,
roughly two full-XSTATE memcpys per guest syscall although almost no syscall
touches FP state.

This keeps the parked frame authoritative and moves only embedded ownership
bookkeeping. It replaces the earlier salvage-list experiment: there is no
heap allocation anywhere on the handoff path, so memory pressure cannot
degrade it and there is no OOM panic; retained bytes are bounded by live
tasks, not exited ones.

  - entry (get_stub_state_seccomp) arms the task as LIVE owner of the
    frame, without copying;
  - exit (set_stub_state_seccomp) skips the write-back while the same task
    still owns the same frame; the host rt_sigreturn then reloads the bytes
    it itself saved;
  - when another task reuses the runner first (threads multiplexing one
    stub), or the task resumes on another vCPU runner after migration, the
    owner's own regs->fp buffer receives the bytes under a per-runner
    handoff lock and a per-task lock; no salvage nodes exist;
  - task exit detaches with the task lock only, so it never dereferences
    its mm after exit_mm(); destroy_context clears every runner record
    (broker, per-CPU runners and GPU worker) and broker-cache reuse starts
    from a clean record;
  - genuine FP consumers materialise on demand: guest signal delivery
    (copy_sc_to_user), sigreturn (copy_sc_from_user), the FP/XSTATE
    regsets used by ptrace and coredumps (including partial writes), fork
    (arch_dup_task_struct) and exec (flush_thread).

GP register copies, FS/GS base sync, single-stepping, queued mapping/GPU
stub work (which parks without rt_sigreturn and never rewrites the frame)
and the i387 conversion are untouched. i386 keeps eager copies. Default is
OFF (lazyxstate=0); with lazyxstate=0 the generated code path copies
exactly as before. The feature stacks on the parallel shared-VM runner
series and the GPU stack; no syscall is special-cased.

This is a reproducibility experiment, not a performance claim.

---
diff --git a/arch/um/include/shared/registers.h b/arch/um/include/shared/registers.h
--- a/arch/um/include/shared/registers.h
+++ b/arch/um/include/shared/registers.h
@@ -8,9 +8,39 @@
 
 #include <sysdep/ptrace.h>
 
+struct mm_id;
+
 extern int init_pid_registers(int pid);
 extern void get_safe_registers(unsigned long *regs, unsigned long *fp_regs);
 extern int get_fp_registers(int pid, unsigned long *regs);
 extern int put_fp_registers(int pid, unsigned long *regs);
 
+struct task_struct;
+
+/*
+ * Experimental lazy XSTATE handoff for the SECCOMP syscall path
+ * (lazyxstate=1). No-ops with the feature off and on i386. See
+ * arch/x86/um/fp_lazy.c for the ownership state machine.
+ */
+/* Host just wrote frame on runner at syscall entry; arm ownership. */
+extern int uml_fp_enter(struct uml_pt_regs *regs, struct mm_id *runner,
+			void *frame, unsigned int size);
+/*
+ * Runner frame is about to be resumed. Returns 1 when the frame must be
+ * left untouched (fast path), 0 when regs->fp was copied into it, negative
+ * errno on unrecoverable protocol corruption.
+ */
+extern int uml_fp_leave(struct uml_pt_regs *regs, struct mm_id *runner,
+			void *frame, unsigned int size);
+/* Make regs->fp authoritative before reading it (signal, ptrace, fork). */
+extern void uml_fp_materialize(struct uml_pt_regs *regs);
+/* Drop parked state immediately before regs->fp is overwritten wholesale. */
+extern void uml_fp_discard(struct uml_pt_regs *regs);
+/* Initialise a fresh child/kthread descriptor (parent image already copied). */
+extern void uml_fp_reset(struct uml_pt_regs *regs);
+/* Task is exiting; detach without dereferencing its (possibly dead) mm. */
+extern void uml_fp_exit(struct task_struct *tsk);
+/* Clear runner ownership at mm destruction / broker-cache reuse. */
+extern void uml_fp_handoff_reset(struct mm_id *runner);
+
 #endif
diff --git a/arch/um/include/shared/skas/mm_id.h b/arch/um/include/shared/skas/mm_id.h
--- a/arch/um/include/shared/skas/mm_id.h
+++ b/arch/um/include/shared/skas/mm_id.h
@@ -10,6 +10,23 @@
 
 #define STUB_MAX_FDS 4
 
+struct task_struct;
+
+/*
+ * Experimental lazy XSTATE handoff bookkeeping (lazyxstate=1), one record
+ * per SECCOMP runner. Plain scalar fields only: this header is also compiled
+ * by the userspace-facing units, so all locking and refcounting lives in
+ * arch/x86/um/fp_lazy.c. While @owner is non-NULL the runner holds one
+ * strong task reference (get/put_task_struct); it is cleared on fast path,
+ * takeover, materialise, discard, task exit and mm teardown.
+ */
+struct um_fp_handoff {
+	struct task_struct *owner;
+	unsigned long long token;
+	/* Test-and-set lock word; 0 means unlocked. */
+	unsigned int lock;
+};
+
 struct mm_id {
 	int pid;
 	unsigned long stack;
@@ -21,6 +38,8 @@
 	int syscall_fd_map[STUB_MAX_FDS];
 	/* Physical-memory FD retained by a parallel mapping broker at host FD 1. */
 	int cached_phys_fd;
+
+	struct um_fp_handoff fp_handoff;
 };
 
 struct mutex *__get_turnstile(struct mm_id *mm_id);
