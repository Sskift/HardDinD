+/* HARDDIND round12 experimental diagnostics, both default off.
+ * harddind_stall_diag_ms is defined in arch/um/kernel/stall_diag.c. */
+extern unsigned int harddind_stall_diag_ms;
+
+static int __init harddind_stall_diag_setup(char *line, int *add)
+{
+	char *end;
+	unsigned long value;
+
+	*add = 0;
+	errno = 0;
+	value = strtoul(line, &end, 10);
+	if (errno || end == line || *end || value > 600000)
+		fatal("Invalid harddind_stall_diag value, expected 0..600000 ms\n");
+	harddind_stall_diag_ms = (unsigned int)value;
+	return 0;
+}
+__uml_setup("harddind_stall_diag=", harddind_stall_diag_setup,
+"harddind_stall_diag=<0..600000>\n"
+"    EXPERIMENTAL: log long seccomp rendezvous waits and CFS throttle\n"
+"    events. Default 0 (off). Suppression makes absence inconclusive.\n");
+
 
