+/*
+ * HARDDIND experimental A/B scheduler clock, selected with
+ * harddind_hr_sched_clock=1 (default 0: unchanged behavior).
+ *
+ * With CONFIG_UML_TIME_TRAVEL_SUPPORT and a non-off travel mode, the
+ * simulated time-travel clock is always used.
+ *
+ * HR mode (TT off): nanosecond host CLOCK_MONOTONIC (the same host clock
+ * backing the UML clocksource and timers via os_nsecs()) with a constant
+ * offset fixed on the boot CPU.
+ *
+ * INITIALIZATION (no lazy first use): harddind_hr_clock_init() is called
+ * once from time_init() in start_kernel(). start_kernel() calls time_init()
+ * (init/main.c) BEFORE smp_init() creates secondary vCPU pthreads and before
+ * the timer IRQ is requested (that happens later in um_timer_init via
+ * late_time_init), so only the boot CPU exists at anchor time. It publishes
+ * the two anchors, then flips harddind_hr_ready with release ordering.
+ * sched_clock() acquires that flag and returns the unchanged jiffies clock
+ * until it is set; after publication anchors are immutable, so a nested
+ * timer signal and other vCPUs only read them. The guest anchor equals the
+ * jiffies-clock value at initialization, making the jiffies->HR transition
+ * non-decreasing.
+ *
+ * SCOPE: this changes scheduler-clock granularity and therefore the guest
+ * scheduling/accounting behavior driven by sched_clock. Configured quotas,
+ * periods and weights are unchanged. It is WALL time: it advances while the
+ * host deschedules a vCPU and provides no steal-time compensation.
+ */
+unsigned int harddind_hr_sched_clock;
+static u64 harddind_hr_anchor_guest_ns;
+static u64 harddind_hr_anchor_host_ns;
+static int harddind_hr_ready;
+
+static void __init harddind_hr_clock_init(void)
+{
+	u64 guest, host;
+
+	if (!harddind_hr_sched_clock)
+		return;
+	guest = (u64)(jiffies - INITIAL_JIFFIES) * (NSEC_PER_SEC / HZ);
+	host = (u64)os_nsecs();
+	WRITE_ONCE(harddind_hr_anchor_guest_ns, guest);
+	WRITE_ONCE(harddind_hr_anchor_host_ns, host);
+	smp_store_release(&harddind_hr_ready, 1);
+}
+
+unsigned long long sched_clock(void); /* matches linux/sched/clock.h */
+
+notrace unsigned long long sched_clock(void)
+{
+#ifdef CONFIG_UML_TIME_TRAVEL_SUPPORT
+	if (time_travel_mode != TT_MODE_OFF)
+		return harddind_tt_sched_clock();
+#endif
+	if (!harddind_hr_sched_clock ||
+	    !smp_load_acquire(&harddind_hr_ready))
+		return (unsigned long long)(jiffies - INITIAL_JIFFIES) *
+			(NSEC_PER_SEC / HZ);
+
+	/* Boot-initialized and immutable; pure reads, safe under a nested
+	 * timer signal. */
+	return READ_ONCE(harddind_hr_anchor_guest_ns) +
+	       (u64)os_nsecs() - READ_ONCE(harddind_hr_anchor_host_ns);
+}
+
