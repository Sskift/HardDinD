#!/bin/sh
# harddind-perf-init - guest init for the owner-run descriptive perf harness.
#
# Emits a strict, parser-validated protocol on the UML console:
#   HARDDIND_PERF_BEGIN
#   HARDDIND_PERF_<BIN>_SHA256=<hash>                      (x2)
#   HARDDIND_PERF_RUN binary=<b> workload=<w> args=<a|-> warmup=<0|1> seq=<n>
#   {"test":...,"workers":...,"seconds":...}               (benchmark line)
#   HARDDIND_PERF_RUN_RC=<rc>                              (x35 total)
#   HARDDIND_PERF_END status=<0|1>
# Fixed iteration counts live in the frozen binaries; nothing here scales
# work. Each invocation is bounded by /sbin/perfrun @RUN_TIMEOUT@.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc || exit 1
mount -t sysfs sysfs /sys || exit 1
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev || exit 1
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run

echo HARDDIND_PERF_BEGIN
echo "HARDDIND_PERF_COREBENCH_SHA256=$(sha256sum /corebench | cut -d' ' -f1)"
echo "HARDDIND_PERF_DISPATCHBENCH_SHA256=$(sha256sum /dispatchbench | cut -d' ' -f1)"

agg=0
run() {
	binary=$1
	workload=$2
	args=$3
	seq=1
	while [ "$seq" -le 7 ]; do
		if [ "$seq" -le 2 ]; then
			warm=1
		else
			warm=0
		fi
		echo "HARDDIND_PERF_RUN binary=$binary workload=$workload args=$args warmup=$warm seq=$seq"
		if [ "$args" = "-" ]; then
			/sbin/perfrun @RUN_TIMEOUT@ "/$binary" "$workload"
		else
			/sbin/perfrun @RUN_TIMEOUT@ "/$binary" "$workload" "$args"
		fi
		rc=$?
		echo "HARDDIND_PERF_RUN_RC=$rc"
		if [ "$rc" != 0 ]; then
			agg=1
		fi
		seq=$((seq + 1))
	done
}

# Fixed order; supervisor parser requires this exact sequence.
run corebench syscall 1
run corebench signals 1
run corebench threads 4
run corebench processes 4
run dispatchbench thread_syscalls -

echo "HARDDIND_PERF_END status=$agg"
sync
poweroff -f
