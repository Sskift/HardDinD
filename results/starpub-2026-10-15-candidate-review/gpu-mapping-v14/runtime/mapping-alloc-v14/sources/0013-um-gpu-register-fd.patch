+static int gpu_device_path(unsigned int index, char *path, size_t size)
+{
+	if (index > 255)
+		return -EINVAL;
+	if (index == 255)
+		snprintf(path, size, "/dev/nvidiactl");
+	else
+		snprintf(path, size, "/dev/nvidia%u", index);
+	return 0;
+}
