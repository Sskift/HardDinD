--- /dev/null
+++ b/arch/um/include/shared/faultstat.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Minimal UML fault/rendezvous counters (optional, default off).
+ *
+ * This header is shared between proper kernel code and os-Linux
+ * user-space style code, so it deliberately contains no kernel includes:
+ * GCC atomics work in both compilation environments.
+ *
+ * Overhead contract (verified by tests/faultstat_unit.c and the static
+ * contract check in tests/run_faultstat_checks.py):
+ *
+ *  - When uml_faultstat_enabled is 0, uml_fs_inc/uml_fs_add are a single
+ *    predicted-not-taken branch and NO atomic instruction is emitted;
+ *    uml_fs_time_begin/end do not read any clock at all (the gate runs
+ *    before the clock call).
+ *  - When enabled, all timestamps come from ONE source,
+ *    uml_fs_clock_ns() (host CLOCK_MONOTONIC ns via os_nsecs()), in
+ *    both kernel and host compilation contexts.  Local jiffies clocks
+ *    are deliberately not used.
+ *  - Counter helpers return void and have no errno.  The map/unmap
+ *    wrappers in tlb.c return the underlying operation's result byte for
+ *    byte, so instrumentation can never change a driver/syscall result.
+ *
+ * Counters are per-machine and approximate under multi-CPU updates.
+ */
+#ifndef __UM_SHARED_FAULTSTAT_H
+#define __UM_SHARED_FAULTSTAT_H
+
+/*
+ * No includes on purpose: this header is compiled both by the kernel
+ * (-nostdinc) and by os-Linux user objects.  Only built-in integer
+ * types are used, which need no header in either environment.
+ */
+
+extern volatile int uml_faultstat_enabled;
+
+/* Userspace reports handled (per userspace() round, any signal). */
+extern volatile unsigned long long uml_fs_trap;
+/* SIGSEGV reports specifically. */
+extern volatile unsigned long long uml_fs_segv;
+/* Successful user write faults resolved by handle_page_fault(). */
+extern volatile unsigned long long uml_fs_write_fault;
+/* Faultaround windows entered/skipped and neighbour faults issued. */
+extern volatile unsigned long long uml_fs_window;
+extern volatile unsigned long long uml_fs_window_page;
+extern volatile unsigned long long uml_fs_window_skip;
+/* TLB sync walks with dirty ranges; mmap/unmap records generated. */
+extern volatile unsigned long long uml_fs_sync;
+extern volatile unsigned long long uml_fs_map;
+extern volatile unsigned long long uml_fs_unmap;
+/* Broker stub batches completed and ns spent inside the flush call. */
+extern volatile unsigned long long uml_fs_flush;
+extern volatile unsigned long long uml_fs_flush_ns;
+/*
+ * userspace() rounds and ns spent in them.  This interval STARTS when
+ * the vCPU hands the runner off (resume) and ENDS when the runner traps
+ * back.  It therefore INCLUDES guest user execution time up to the
+ * trap; it is NOT pure fault-handling overhead.
+ */
+extern volatile unsigned long long uml_fs_run;
+extern volatile unsigned long long uml_fs_run_ns;
+
+/* One host CLOCK_MONOTONIC source for both compilation contexts. */
+unsigned long long uml_fs_clock_ns(void);
+
+static inline void uml_fs_inc(volatile unsigned long long *p)
+{
+	if (__builtin_expect(uml_faultstat_enabled, 0))
+		__atomic_add_fetch(p, 1ULL, __ATOMIC_RELAXED);
+}
+
+static inline void uml_fs_add(volatile unsigned long long *p,
+			      unsigned long long n)
+{
+	if (__builtin_expect(uml_faultstat_enabled, 0))
+		__atomic_add_fetch(p, n, __ATOMIC_RELAXED);
+}
+
+/* Consistent (torn-free) snapshot for /proc readers. */
+static inline unsigned long long uml_fs_read(
+		const volatile unsigned long long *p)
+{
+	return __atomic_load_n(p, __ATOMIC_ACQUIRE);
+}
+
+/*
+ * Timing brackets.  The enabled check happens BEFORE any clock access;
+ * a disabled probe returns 0 and uml_fs_time_end() is a no-op, so zero
+ * clock syscalls and zero atomics occur on the default-off path.
+ */
+static inline unsigned long long uml_fs_time_begin(void)
+{
+	if (__builtin_expect(!uml_faultstat_enabled, 1))
+		return 0;
+	return uml_fs_clock_ns();
+}
+
+static inline void uml_fs_time_end(volatile unsigned long long *sum,
+				   unsigned long long t0)
+{
+	unsigned long long now;
+
+	if (__builtin_expect(!uml_faultstat_enabled, 1))
+		return;
+	now = uml_fs_clock_ns();
+	/* Ignore non-monotonic samples instead of recording garbage. */
+	if (now >= t0)
+		__atomic_add_fetch(sum, now - t0, __ATOMIC_RELAXED);
+}
+
+#endif
--- /dev/null
+++ b/arch/um/kernel/faultstat.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Optional per-fault rendezvous counters for the UML seccomp thread
+ * machinery.  Enabled with uml_faultstat=1; read /proc/uml_faultstat.
+ *
+ * The instrumentation is bounded, purely observational and off by
+ * default: it never returns an error and never alters the result of a
+ * mapping/syscall path.  Timestamps use the host CLOCK_MONOTONIC via the
+ * os layer (same clock the os-Linux side uses), never the coarse guest
+ * jiffies clock.
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kstrtox.h>
+#include <linux/module.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <init.h>
+#include <os.h>
+#include <faultstat.h>
+
+volatile int uml_faultstat_enabled;
+
+volatile unsigned long long uml_fs_trap;
+volatile unsigned long long uml_fs_segv;
+volatile unsigned long long uml_fs_write_fault;
+volatile unsigned long long uml_fs_window;
+volatile unsigned long long uml_fs_window_page;
+volatile unsigned long long uml_fs_window_skip;
+volatile unsigned long long uml_fs_sync;
+volatile unsigned long long uml_fs_map;
+volatile unsigned long long uml_fs_unmap;
+volatile unsigned long long uml_fs_flush;
+volatile unsigned long long uml_fs_flush_ns;
+volatile unsigned long long uml_fs_run;
+volatile unsigned long long uml_fs_run_ns;
+
+unsigned long long uml_fs_clock_ns(void)
+{
+	/* os_nsecs() is host CLOCK_MONOTONIC; shared by kernel- and
+	 * os-Linux-compiled callers so timestamps are comparable. */
+	return (unsigned long long)os_nsecs();
+}
+
+static int faultstat_show(struct seq_file *m, void *v)
+{
+	/*
+	 * Torn-free point reads of each counter.  The set is not a
+	 * multi-counter transaction; machine-wide counters from several
+	 * vCPUs can interleave between lines, which the header states.
+	 */
+	seq_puts(m,
+"# UML fault rendezvous counters (machine-wide, approximate; one ns clock:\n"
+"# host CLOCK_MONOTONIC via os_nsecs)\n"
+"# trap          userspace() rounds (runner resume until next trap)\n"
+"# segv          rounds whose report was SIGSEGV\n"
+"# write_fault   successful user write faults\n"
+"# window        faultaround windows entered\n"
+"# window_page   neighbour faults issued inside windows\n"
+"# window_skip   faultaround attempts gated off\n"
+"# sync          TLB range syncs with pending work\n"
+"# map           host mmap records queued\n"
+"# unmap         host munmap records queued\n"
+"# flush         broker stub batches completed\n"
+"# flush_ns      ns spent inside broker stub flushes\n"
+"# run           userspace() rounds timed\n"
+"# run_ns        ns per round INCLUDING guest user execution until the\n"
+"#               next trap; NOT pure fault-handling overhead\n");
+	seq_printf(m, "enabled %u\n", __atomic_load_n(&uml_faultstat_enabled,
+						      __ATOMIC_ACQUIRE));
+	seq_printf(m, "trap %llu\n", uml_fs_read(&uml_fs_trap));
+	seq_printf(m, "segv %llu\n", uml_fs_read(&uml_fs_segv));
+	seq_printf(m, "write_fault %llu\n", uml_fs_read(&uml_fs_write_fault));
+	seq_printf(m, "window %llu\n", uml_fs_read(&uml_fs_window));
+	seq_printf(m, "window_page %llu\n", uml_fs_read(&uml_fs_window_page));
+	seq_printf(m, "window_skip %llu\n", uml_fs_read(&uml_fs_window_skip));
+	seq_printf(m, "sync %llu\n", uml_fs_read(&uml_fs_sync));
+	seq_printf(m, "map %llu\n", uml_fs_read(&uml_fs_map));
+	seq_printf(m, "unmap %llu\n", uml_fs_read(&uml_fs_unmap));
+	seq_printf(m, "flush %llu\n", uml_fs_read(&uml_fs_flush));
+	seq_printf(m, "flush_ns %llu\n", uml_fs_read(&uml_fs_flush_ns));
+	seq_printf(m, "run %llu\n", uml_fs_read(&uml_fs_run));
+	seq_printf(m, "run_ns %llu\n", uml_fs_read(&uml_fs_run_ns));
+	return 0;
+}
+
+static int faultstat_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, faultstat_show, NULL);
+}
+
+static const struct proc_ops faultstat_proc_ops = {
+	.proc_open	= faultstat_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int __init faultstat_init(void)
+{
+	proc_create("uml_faultstat", 0400, NULL, &faultstat_proc_ops);
+	return 0;
+}
+__initcall(faultstat_init);
+
+static int __init uml_faultstat_setup(char *line, int *add)
+{
+	unsigned int enable;
+
+	*add = 0;
+	if (kstrtouint(line, 10, &enable) || enable > 1) {
+		pr_warn("uml_faultstat requires 0 or 1\n");
+		return 0;
+	}
+	uml_faultstat_enabled = enable;
+	return 0;
+}
+__uml_setup("uml_faultstat=", uml_faultstat_setup,
+"uml_faultstat=<0|1>\n"
+"    Default 0.  Count anonymous fault rendezvous, TLB syncs, broker\n"
+"    stub flushes and runner rounds; read them from /proc/uml_faultstat.\n"
+"    When disabled no clock is read and no atomic is executed; timings\n"
+"    use host CLOCK_MONOTONIC ns (os_nsecs), not guest jiffies.\n\n");
