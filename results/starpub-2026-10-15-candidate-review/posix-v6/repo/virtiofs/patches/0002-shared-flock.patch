+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+//! Retry nonblocking host locks without consuming filesystem worker threads.
+use std::collections::HashMap;
+use std::io;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+type Task = Box<dyn FnMut(bool) -> bool + Send>;
+struct Job { unique: u64, cancelled: Arc<AtomicBool>, task: Task }
+#[derive(Default)]
+struct State {
+    jobs: Vec<Job>,
+    tokens: HashMap<u64, Arc<AtomicBool>>,
+    stopping: bool,
+    peak: usize,
+    completed: u64,
+    interrupted: u64,
+}
+#[derive(Clone, Default)]
+pub struct RetryHandle(Arc<(Mutex<State>, Condvar)>);
+
+impl RetryHandle {
+    /// `task` must use nonblocking operations and finish when cancelled.
+    pub fn submit(&self, unique: u64, task: Task) -> io::Result<()> {
+        let (lock, cv) = &*self.0;
+        let mut state = lock.lock().unwrap();
+        if state.stopping { return Err(io::Error::from_raw_os_error(libc::ENODEV)); }
+        if state.tokens.contains_key(&unique) { return Err(io::Error::from_raw_os_error(libc::EINVAL)); }
+        let cancelled = Arc::new(AtomicBool::new(false));
+        state.tokens.insert(unique, cancelled.clone());
+        state.jobs.push(Job { unique, cancelled, task });
+        state.peak = state.peak.max(state.tokens.len());
+        cv.notify_one();
+        Ok(())
+    }
+
+    pub fn interrupt(&self, unique: u64) -> bool {
+        let (lock, cv) = &*self.0;
+        let mut state = lock.lock().unwrap();
+        if let Some(token) = state.tokens.get(&unique) {
+            if !token.swap(true, Ordering::SeqCst) { state.interrupted += 1; }
+            cv.notify_one();
+            true
+        } else { false }
+    }
+}
+
+pub struct RetryQueue { handle: RetryHandle, worker: Option<JoinHandle<()>> }
+impl RetryQueue {
+    pub fn new() -> io::Result<Self> {
+        let handle = RetryHandle::default();
+        let worker_handle = handle.clone();
+        let worker = thread::Builder::new().name("fuse-lock-waits".into()).spawn(move || {
+            let (lock, cv) = &*worker_handle.0;
+            loop {
+                let mut state = lock.lock().unwrap();
+                while state.jobs.is_empty() && !state.stopping { state = cv.wait(state).unwrap(); }
+                if state.jobs.is_empty() && state.stopping { break; }
+                let jobs = std::mem::take(&mut state.jobs);
+                drop(state);
+                let mut pending = Vec::new();
+                for mut job in jobs {
+                    let cancelled = job.cancelled.load(Ordering::SeqCst);
+                    // Never hold the scheduler lock while invoking a callback: it can
+                    // return a virtqueue descriptor or cancel another pending request.
+                    if (job.task)(cancelled) {
+                        let mut state = lock.lock().unwrap();
+                        state.tokens.remove(&job.unique);
+                        state.completed += 1;
+                        cv.notify_all();
+                    } else {
+                        assert!(!cancelled, "cancelled retry must complete");
+                        pending.push(job);
+                    }
+                }
+                let mut state = lock.lock().unwrap();
+                let new_work = !state.jobs.is_empty();
+                state.jobs.extend(pending);
+                if !state.jobs.is_empty() && !state.stopping && !new_work {
+                    // Host unlocks do not signal this process. Bounded polling applies
+                    // only to contended locks; an idle queue consumes no periodic CPU.
+                    drop(cv.wait_timeout(state, Duration::from_millis(2)).unwrap());
+                }
+            }
+        })?;
+        Ok(Self { handle, worker: Some(worker) })
+    }
+    pub fn handle(&self) -> RetryHandle { self.handle.clone() }
+    /// Called with the backend's exclusive lock so no new requests can enter.
+    pub fn cancel_all(&self) {
+        let (lock, cv) = &*self.handle.0;
+        let mut state = lock.lock().unwrap();
+        for token in state.tokens.values() { token.store(true, Ordering::SeqCst); }
+        cv.notify_all();
+        while !state.tokens.is_empty() { state = cv.wait(state).unwrap(); }
+    }
+}
+impl Drop for RetryQueue {
+    fn drop(&mut self) {
+        let (lock, cv) = &*self.handle.0;
+        {
+            let mut state = lock.lock().unwrap();
+            state.stopping = true;
+            for token in state.tokens.values() { token.store(true, Ordering::SeqCst); }
+            cv.notify_all();
+        }
+        if let Some(worker) = self.worker.take() { worker.join().unwrap(); }
+        let state = lock.lock().unwrap();
+        info!("HARDDIND_LOCK_QUEUE completed={} interrupted={} peak={} remaining={}",
+              state.completed, state.interrupted, state.peak, state.tokens.len());
+    }
+}
+
+#[cfg(test)]
+mod harddind_tests {
+    use super::*;
+    use std::sync::mpsc;
+    #[test]
+    fn harddind_retry_queue_progress_cancellation_and_shutdown() {
+        let queue = RetryQueue::new().unwrap();
+        let handle = queue.handle();
+        let (tx, rx) = mpsc::channel();
+        for unique in 0..12 {
+            let tx = tx.clone();
+            handle.submit(unique, Box::new(move |cancelled| {
+                if cancelled { tx.send(unique).unwrap(); true } else { false }
+            })).unwrap();
+        }
+        let immediate = tx.clone();
+        handle.submit(100, Box::new(move |_| { immediate.send(100).unwrap(); true })).unwrap();
+        assert_eq!(rx.recv_timeout(Duration::from_secs(3)).unwrap(), 100);
+        assert!(!handle.interrupt(999));
+        assert!(handle.interrupt(7));
+        assert_eq!(rx.recv_timeout(Duration::from_secs(3)).unwrap(), 7);
+        drop(queue);
+        let mut remaining: Vec<_> = (0..11).map(|_| rx.recv_timeout(Duration::from_secs(3)).unwrap()).collect();
+        remaining.sort();
+        assert_eq!(remaining, (0..12).filter(|i| *i != 7).collect::<Vec<_>>());
+        assert!(handle.submit(200, Box::new(|_| true)).is_err());
+    }
+}
