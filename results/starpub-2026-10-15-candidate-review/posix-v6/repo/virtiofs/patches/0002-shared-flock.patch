+    pub fn try_flock(&self, header: InHeader, request: LkIn) -> io::Result<()> {
+        if header.len as usize != size_of::<InHeader>() + size_of::<LkIn>() {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        if request.lk_flags != LK_FLOCK {
+            return Err(io::Error::from_raw_os_error(libc::ENOSYS));
+        }
+        if request.lk.start != 0 || request.lk.end != i64::MAX as u64 {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        let operation = match request.lk.type_ as i32 {
+            libc::F_RDLCK => libc::LOCK_SH,
+            libc::F_WRLCK => libc::LOCK_EX,
+            libc::F_UNLCK => libc::LOCK_UN,
+            _ => return Err(io::Error::from_raw_os_error(libc::EINVAL)),
+        };
+        self.fs.flock(Context::from(header), header.nodeid.into(), request.fh.into(), operation)
+    }
+
+    pub fn reply_flock(&self, header: InHeader, w: Writer, result: io::Result<()>) -> Result<usize> {
+        match result {
+            Ok(()) => reply_ok(None::<u8>, None, header.unique, w),
+            Err(error) => reply_error(error, header.unique, w),
+        }
+    }
+
+    fn setlk(&self, header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+        let request: LkIn = r.read_obj().map_err(Error::DecodeMessage)?;
