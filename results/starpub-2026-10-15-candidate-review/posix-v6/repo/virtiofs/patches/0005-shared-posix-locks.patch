+    fn handle_access_mode(&self, handle: Handle, inode: Inode) -> io::Result<i32> {
+        let data = self.find_handle(handle, inode)?;
+        let file = data.file.get()?;
+        let guard = file.read().unwrap();
+        // Safe: F_GETFL with no pointer argument only reads the flags.
+        let flags = unsafe { libc::fcntl(guard.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0 {
+            return Err(io::Error::last_os_error());
+        }
