+    #[test]
+    fn harddind_posix_wait_deadlock_flush_teardown_and_cancel() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-wait-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("lock");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let name = CString::new("lock").unwrap();
+        let inode = fs.do_lookup(1, &name).unwrap().inode;
+        let ha = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let hb = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        let (a, b) = (0x5001u64, 0x5002u64);
+        let eagain = Some(libc::EAGAIN);
+
+        // Two-owner cycle: A holds [0,64), B holds [64,128); each waits for the other.
+        fs.setlk(ctx, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 0, 64)).unwrap();
+        fs.setlk(ctx, inode, hb, b, 52, harddind_plock(libc::F_WRLCK, 64, 64)).unwrap();
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 9001, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 64, 64))
+                .unwrap_err().raw_os_error(),
+            eagain
+        );
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 9002, inode, hb, b, 52, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err().raw_os_error(),
+            Some(libc::EDEADLK)
+        );
+        // After B releases its range (deadlock cleanup), A's wait grants.
+        fs.setlk(ctx, inode, hb, b, 52, harddind_plock(libc::F_UNLCK, 64, 64)).unwrap();
+        fs.setlk_wait_attempt(ctx, 9001, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 64, 64))
+            .unwrap();
+        fs.setlk(ctx, inode, ha, a, 51, harddind_plock(libc::F_UNLCK, 0, 128)).unwrap();
+
+        // Flush-vs-wait: pending waiter must abort EINTR and never acquire.
+        fs.setlk(ctx, inode, hb, b, 52, harddind_plock(libc::F_WRLCK, 256, 64)).unwrap();
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 9003, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 256, 64))
+                .unwrap_err().raw_os_error(),
+            eagain
+        );
+        fs.flush(ctx, inode, ha, a).unwrap();
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 9003, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 256, 64))
+                .unwrap_err().raw_os_error(),
+            Some(libc::EINTR)
+        );
+        // Actual mutation: B unlocks and a host process gets the range; A never held it.
+        fs.setlk(ctx, inode, hb, b, 52, harddind_plock(libc::F_UNLCK, 256, 64)).unwrap();
+        assert_eq!(harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 256, 64).0, 0);
+        // A fresh SETLK from A works (new entry) and really blocks the host.
+        fs.setlk(ctx, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 256, 64)).unwrap();
+        assert_eq!(harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 256, 64),
+                   (-1, Some(libc::EAGAIN)));
+        fs.setlk(ctx, inode, ha, a, 51, harddind_plock(libc::F_UNLCK, 256, 64)).unwrap();
+
+        // Interrupt cleanup while the range is held by the host: the waiter
+        // stays EAGAIN, cancel drops it, and after the host unlocks A must not
+        // have acquired it (actual mutation, not just waiter-map absence).
+        let waiter_file = std::fs::OpenOptions::new().read(true).write(true).open(&path).unwrap();
+        assert_eq!(
+            unsafe { libc::fcntl(waiter_file.as_raw_fd(), libc::F_SETLK, &mut libc::flock {
+                l_type: libc::F_WRLCK as i16, l_whence: libc::SEEK_SET as i16,
+                l_start: 512, l_len: 64, l_pid: 0 }) },
+            0
+        );
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 9004, inode, ha, a, 51, harddind_plock(libc::F_WRLCK, 512, 64))
+                .unwrap_err().raw_os_error(),
+            eagain
+        );
+        fs.setlk_wait_cancel(9004, inode);
+        assert_eq!(
+            unsafe { libc::fcntl(waiter_file.as_raw_fd(), libc::F_SETLK, &mut libc::flock {
+                l_type: libc::F_UNLCK as i16, l_whence: libc::SEEK_SET as i16,
+                l_start: 512, l_len: 64, l_pid: 0 }) },
+            0
+        );
+        assert_eq!(harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 512, 64).0, 0);
+        std::fs::remove_dir_all(base).unwrap();
+    }
