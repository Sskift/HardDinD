+    #[test]
+    fn harddind_posix_cycle_verifier_respects_locked_scope() {
+        // Direct deterministic proof for review point 2: reachability used to
+        // confirm EDEADLK may only traverse waiters whose inode grants are
+        // frozen (same Arc held by the caller).  A wait edge on an unlocked
+        // inode forces NeedExpand instead of producing a Cycle or NoCycle.
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-scope-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let px = base.join("x");
+        let py = base.join("y");
+        std::fs::write(&px, vec![0u8; 4096]).unwrap();
+        std::fs::write(&py, vec![0u8; 4096]).unwrap();
+        let table = PosixLockTable::new();
+        let opener_x = |w: bool| File::options().read(true).write(w).open(&px);
+        let opener_y = |w: bool| File::options().read(true).write(w).open(&py);
+        const X: Inode = 701;
+        const Y: Inode = 702;
+        const A: u64 = 0x700A;
+        const B: u64 = 0x700B;
+        // A holds X; B holds Y.
+        apply(&table, X, A, 71, true, 0, 63, false, &opener_x);
+        apply(&table, Y, B, 72, true, 0, 63, false, &opener_y);
+        // Register A's real blocker on Y via the real fcntl path (EAGAIN).
+        assert_eq!(
+            table.wait_attempt(Y, 8001, A, 71, false, true, 0, 63, &opener_y)
+                .unwrap_err().raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        // B's closing wait on X is verified EDEADLK and its waiter removed,
+        // but the attempt also creates B's real owner entry on X; reuse it to
+        // re-insert the edge directly for the locked-scope probe.
+        assert_eq!(
+            table.wait_attempt(X, 8002, B, 72, false, true, 0, 63, &opener_x)
+                .unwrap_err().raw_os_error(),
+            Some(libc::EDEADLK)
+        );
+        let set_x = table.set_for(X);
+        let b_entry = Arc::clone(set_x.owners.lock().unwrap().get(&B).unwrap());
+        table.waiters.lock().unwrap().insert(
+            8002,
+            Waiter {
+                inode: X,
+                entry: Arc::clone(&b_entry),
+                owner: B,
+                want_write: true,
+                start: 0,
+                end: 63,
+            },
+        );
+        // Fabricate the exact locked-set arguments reach_with_locked uses.
+        let set_y = table.set_for(Y);
+        let waiters = table.waiters.lock().unwrap();
+        // Only X frozen: A's edge lives on Y (unlocked) -> must expand, never
+        // cycle/no-cycle verdict (the old unscoped DFS returned EDEADLK here).
+        let mut only_x = BTreeMap::new();
+        only_x.insert(X, Arc::clone(&set_x));
+        match PosixLockTable::reach_with_locked(&only_x, &waiters, B) {
+            CycleVerdict::NeedExpand(need) => assert!(need.contains(&Y)),
+            other => panic!("expected NeedExpand([Y]), got {other:?}"),
+        }
+        // Both frozen: the cycle is provable with identical Arc identities.
+        let mut both = BTreeMap::new();
+        both.insert(X, Arc::clone(&set_x));
+        both.insert(Y, Arc::clone(&set_y));
+        assert!(matches!(
+            PosixLockTable::reach_with_locked(&both, &waiters, B),
+            CycleVerdict::Cycle
+        ));
+        // Drop B's waiter; same locked sets must now say NoCycle.
+        drop(waiters);
+        table.wait_cancel(X, 8002);
+        let waiters = table.waiters.lock().unwrap();
+        assert!(matches!(
+            PosixLockTable::reach_with_locked(&both, &waiters, B),
+            CycleVerdict::NoCycle
+        ));
+        std::fs::remove_dir_all(base).unwrap();
+    }
