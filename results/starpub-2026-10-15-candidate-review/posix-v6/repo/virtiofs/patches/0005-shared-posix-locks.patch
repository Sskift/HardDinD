+    /// honoring the access mode of the guest handle behind the request.  When
+    /// O_RDWR is not permitted, fall back to the exact mode required so an
+    /// already-valid guest lock is not denied by daemon-side reopening; cached
+    /// owner fds are never reopened afterwards.
+    fn open_posix_lock_fd(&self, inode: Inode, guest_mode: i32, need_write: bool) -> io::Result<File> {
+        let primary = if need_write && guest_mode != libc::O_RDONLY {
+            libc::O_RDWR
+        } else if !need_write && guest_mode != libc::O_WRONLY {
+            libc::O_RDWR
+        } else if need_write {
+            libc::O_WRONLY
+        } else {
+            libc::O_RDONLY
+        };
+        match self.open_inode(inode, primary) {
+            Ok(file) => Ok(file),
+            Err(first) => {
+                let fallback = if need_write {
+                    libc::O_WRONLY
+                } else {
+                    libc::O_RDONLY
+                };
+                if fallback == primary {
+                    Err(first)
+                } else {
+                    self.open_inode(inode, fallback)
+                }
+            }
+        }
+    }
