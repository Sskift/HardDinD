+    #[test]
+    fn harddind_posix_table_owner_isolation_flush_and_forget() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-table-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("locks");
+        std::fs::write(&path, b"data").unwrap();
+        let opener = |write: bool| {
+            File::options()
+                .read(true)
+                .write(write)
+                .open(&path)
+        };
+
+        let table = PosixLockTable::new();
+        apply(&table, 7, 0x1111, 111, true, 0, 63, false, &opener);
+        apply(&table, 7, 0x2222, 222, true, 64, 127, false, &opener);
+
+        // Guest pid attribution for exact merged records.
+        assert_eq!(table.attribute(7, true, 0, 63), 111);
+        assert_eq!(table.attribute(7, true, 64, 127), 222);
+        assert_eq!(table.attribute(7, true, 128, 255), 0);
+
+        // Host sees the conflicts bidirectionally.
+        let host = File::options().read(true).write(true).open(&path).unwrap();
+        assert_eq!(
+            fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 0, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+        assert_eq!(
+            fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 64, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+
+        // FLUSH for A releases A; attribution disappears with the entry.
+        table.flush_owner(7, 0x1111);
+        assert_eq!(table.attribute(7, true, 0, 63), 0);
+        assert_eq!(fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 0, 64).0, 0);
+        assert_eq!(
+            fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 64, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+
+        table.forget_inode(7);
+        assert_eq!(fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 64, 64).0, 0);
+        std::fs::remove_dir_all(base).unwrap();
+    }
