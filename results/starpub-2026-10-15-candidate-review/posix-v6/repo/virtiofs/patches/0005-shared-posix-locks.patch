+    fn harddind_posix_locks_owner_ranges_host_conflicts_and_flush() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("lock");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let name = CString::new("lock").unwrap();
+        let inode = fs.do_lookup(1, &name).unwrap().inode;
+        let handle = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        let (a, b) = (0x1001u64, 0x1002u64);
+
+        // Owner A owns bytes [0,64) for writing.
+        fs.setlk(ctx, inode, handle, a, 1001, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        // Distinct guest owners must conflict for read and write on overlap...
+        assert_eq!(
+            fs.setlk(ctx, inode, handle, b, 1002, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        assert_eq!(
+            fs.setlk(ctx, inode, handle, b, 1002, harddind_plock(libc::F_RDLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        // ...but disjoint ranges are independent, including adjacent boundaries.
+        fs.setlk(ctx, inode, handle, b, 1002, harddind_plock(libc::F_WRLCK, 64, 64))
+            .unwrap();
+        fs.setlk(ctx, inode, handle, b, 1002, harddind_plock(libc::F_RDLCK, 128, 64))
+            .unwrap();
+        assert_eq!(
+            fs.setlk(ctx, inode, handle, b, 1002, harddind_plock(libc::F_WRLCK, 63, 2))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        // Same owner downgrading its own range never blocks itself.
+        fs.setlk(ctx, inode, handle, a, 1001, harddind_plock(libc::F_RDLCK, 0, 64))
+            .unwrap();
+
+        // F_GETLK attributes the guest holder pid recorded from SETLK.
+        let found = fs
+            .getlk(ctx, inode, handle, b, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!((found.type_ as i32, found.start, found.end, found.pid),
+                   (libc::F_RDLCK, 0, 63, 1001));
+        // Within A's own range, A cannot see its own lock...
+        let clean = fs
+            .getlk(ctx, inode, handle, a, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        assert_eq!(clean.type_ as i32, libc::F_UNLCK);
+        // ...but over the full file A does see B's lock starting at byte 64.
+        let b_from_a = fs
+            .getlk(ctx, inode, handle, a, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!((b_from_a.type_ as i32, b_from_a.start, b_from_a.end, b_from_a.pid),
+                   (libc::F_WRLCK, 64, 127, 1002));
+
+        // Host-native POSIX locks conflict with guest owners in both directions.
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 0, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+        let (_, pid) = harddind_host_fcntl(&path, libc::F_GETLK, libc::F_WRLCK as i16, 0, 64);
+        assert_eq!(pid, Some(-1));
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_RDLCK as i16, 128, 64),
+            (0, Some(0)) // shared with B's read lock
+        );
+
+        // A host-process holder has no guest pid: GETLK must report 0 rather
+        // than its host pid (which could coincide with a guest pid).
+        let host = std::fs::OpenOptions::new().read(true).write(true).open(&path).unwrap();
+        assert_eq!(
+            unsafe {
+                libc::fcntl(
+                    host.as_raw_fd(),
+                    libc::F_SETLK,
+                    &mut libc::flock {
+                        l_type: libc::F_WRLCK as i16,
+                        l_whence: libc::SEEK_SET as i16,
+                        l_start: 256,
+                        l_len: 64,
+                        l_pid: 0,
+                    },
+                )
+            },
+            0
+        );
+        let holder = fs
+            .getlk(ctx, inode, handle, a, harddind_plock(libc::F_WRLCK, 256, 64))
+            .unwrap();
+        assert_eq!(holder.type_ as i32, libc::F_WRLCK);
+        assert_eq!(holder.start, 256);
+        assert_eq!(holder.end, 319);
+        assert_eq!(holder.pid, 0);
+        assert_ne!(holder.pid, std::process::id() as u32);
+        drop(host);
+
+        // Explicit unlock releases only the requested owner range.
+        fs.setlk(ctx, inode, handle, a, 1001, harddind_plock(libc::F_UNLCK, 0, 64))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 0, 64),
+            (0, Some(0))
+        );
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 64, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+
+        // Any close (FLUSH) releases all of that owner's locks on the inode,
+        // including its read lock and locks it held on ranges taken elsewhere.
+        fs.flush(ctx, inode, handle, b).unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 64, 128),
+            (0, Some(0))
+        );
+
+        // To-EOF lock (len 0) blocks a writer far past EOF and round-trips via GETLK.
+        fs.setlk(ctx, inode, handle, a, 1001, harddind_plock(libc::F_WRLCK, 1000, 0))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 5000, 1),
+            (-1, Some(libc::EAGAIN))
+        );
+        let (_, far_pid) =
+            harddind_host_fcntl(&path, libc::F_GETLK, libc::F_WRLCK as i16, 5000, 1);
+        assert_eq!(far_pid, Some(-1));
+        fs.setlk(ctx, inode, handle, a, 1001, harddind_plock(libc::F_UNLCK, 1000, 0))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 5000, 1),
+            (0, Some(0))
+        );
+        std::fs::remove_dir_all(base).unwrap();
+    }
