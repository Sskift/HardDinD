+    #[test]
+    fn harddind_posix_table_deadlock_flush_and_cancel() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-dead-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("locks");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let opener = |write: bool| {
+            File::options().read(true).write(write).open(&path)
+        };
+        let table = PosixLockTable::new();
+        // A owns [0,64), B owns [64,128).
+        apply(&table, 5, 0xA, 1, true, 0, 63, false, &opener);
+        apply(&table, 5, 0xB, 2, true, 64, 127, false, &opener);
+
+        // A waits for B; B then waiting for A is a deadlock.
+        assert_eq!(
+            table
+                .wait_attempt(5, 1001, 0xA, 1, false, true, 64, 127, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        assert_eq!(
+            table
+                .wait_attempt(5, 1002, 0xB, 2, false, true, 0, 63, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EDEADLK)
+        );
+        // B's waiter was removed: after B moves away, A's wait grants normally.
+        apply(&table, 5, 0xB, 2, true, 64, 127, true, &opener);
+        table.wait_attempt(5, 1001, 0xA, 1, false, true, 64, 127, &opener)
+            .unwrap();
+
+        // Flush during a fresh pending wait fails it with EINTR and never grants.
+        assert_eq!(
+            table
+                .wait_attempt(5, 1003, 0xB, 2, false, true, 0, 63, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        table.flush_owner(5, 0xB);
+        assert_eq!(
+            table
+                .wait_attempt(5, 1003, 0xB, 2, false, true, 0, 63, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINTR)
+        );
+        // B re-acquires [200,264) fresh; a new A waiter gets plain EAGAIN
+        // (the dead edge from 1001/1002 is gone), then cancel drops it.
+        apply(&table, 5, 0xB, 2, true, 200, 263, false, &opener);
+        assert_eq!(
+            table
+                .wait_attempt(5, 1004, 0xA, 1, false, true, 200, 263, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        table.wait_cancel(5, 1004);
+        // Re-registering after cancel still sees the real conflict, no phantom
+        // deadlock from stale waiters.
+        assert_eq!(
+            table
+                .wait_attempt(5, 1005, 0xA, 1, false, true, 200, 263, &opener)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        table.wait_cancel(5, 1005);
+        std::fs::remove_dir_all(base).unwrap();
+    }
