+    #[test]
+    fn harddind_posix_table_cross_inode_deadlock_cycle_and_edges() {
+        // The v3 blind spot: A holds X waits Y; B holds Y waits X. With the
+        // waiter registry scoped to one InodeLockSet that cycle is invisible.
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-xdead-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let pathx = base.join("x");
+        let pathy = base.join("y");
+        std::fs::write(&pathx, vec![0u8; 4096]).unwrap();
+        std::fs::write(&pathy, vec![0u8; 4096]).unwrap();
+        let opener_x = |_write: bool| File::options().read(true).write(true).open(&pathx);
+        let opener_y = |_write: bool| File::options().read(true).write(true).open(&pathy);
+        const X: Inode = 101;
+        const Y: Inode = 102;
+        const Z: Inode = 103;
+        const A: u64 = 0xC00A;
+        const B: u64 = 0xC00B;
+        const C: u64 = 0xC00C;
+        let table = PosixLockTable::new();
+        let eagain = Some(libc::EAGAIN);
+        let edeadlk = Some(libc::EDEADLK);
+
+        // A holds X[0,64), B holds Y[0,64).
+        apply(&table, X, A, 901, true, 0, 63, false, &opener_x);
+        apply(&table, Y, B, 902, true, 0, 63, false, &opener_y);
+
+        // A waits for Y: blocked, no cycle.
+        assert_eq!(
+            table
+                .wait_attempt(Y, 2001, A, 901, false, true, 0, 63, &opener_y)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain
+        );
+        // Non-cycle: repeated polls stay EAGAIN (no phantom detection).
+        for _ in 0..3 {
+            assert_eq!(
+                table
+                    .wait_attempt(Y, 2001, A, 901, false, true, 0, 63, &opener_y)
+                    .unwrap_err()
+                    .raw_os_error(),
+                eagain
+            );
+        }
+        // B waits for X: that closes the cross-file cycle immediately.
+        assert_eq!(
+            table
+                .wait_attempt(X, 2002, B, 902, false, true, 0, 63, &opener_x)
+                .unwrap_err()
+                .raw_os_error(),
+            edeadlk
+        );
+
+        // B abandons its waiter (EDEADLK path already unregistered it); after
+        // B unlocks Y, A's pending cross-file wait is granted on the next poll.
+        apply(&table, Y, B, 902, true, 0, 63, true, &opener_y);
+        table
+            .wait_attempt(Y, 2001, A, 901, false, true, 0, 63, &opener_y)
+            .unwrap();
+        // A now really holds Y: a host process cannot get it.
+        let host = File::options().read(true).write(true).open(&pathy).unwrap();
+        assert_eq!(
+            fcntl_lock(&host, libc::F_SETLK, libc::F_WRLCK, 0, 64),
+            (-1, eagain)
+        );
+        apply(&table, Y, A, 901, true, 0, 63, true, &opener_y);
+
+        // Cancel edge removal: recreate A waits Y; cancel it; B waiting for X
+        // must NOT see a deadlock (A's edge is gone), only EAGAIN.
+        apply(&table, Y, B, 902, true, 0, 63, false, &opener_y);
+        assert_eq!(
+            table
+                .wait_attempt(Y, 2003, A, 901, false, true, 0, 63, &opener_y)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain
+        );
+        table.wait_cancel(Y, 2003);
+        assert_eq!(
+            table
+                .wait_attempt(X, 2004, B, 902, false, true, 0, 63, &opener_x)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain
+        );
+        // B never acquired X despite the canceled A edge: its waiter is still
+        // registered after the EAGAIN poll (A legitimately holds X, so a host
+        // acquire check would be meaningless here).
+        assert!(table.is_waiting(2004));
+        table.wait_cancel(X, 2004);
+        assert!(!table.is_waiting(2004));
+
+        // Three-owner chain without a closing edge is NOT a cycle; adding the
+        // closing waiter on the third file makes it one.
+        apply(&table, X, A, 901, true, 0, 63, false, &opener_x);
+        // B waits X (blocked by A).
+        assert_eq!(
+            table
+                .wait_attempt(X, 2005, B, 902, false, true, 0, 63, &opener_x)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain
+        );
+        // C holds Z and waits Y (held by B): chain C->B->A, open at A.
+        let pathz = base.join("z");
+        std::fs::write(&pathz, vec![0u8; 4096]).unwrap();
+        let opener_z = |_write: bool| File::options().read(true).write(true).open(&pathz);
+        apply(&table, Z, C, 903, true, 0, 63, false, &opener_z);
+        assert_eq!(
+            table
+                .wait_attempt(Y, 2006, C, 903, false, true, 0, 63, &opener_y)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain
+        );
+        // A waiting for Z closes the ring A->C->B->A across three files.
+        assert_eq!(
+            table
+                .wait_attempt(Z, 2007, A, 901, false, true, 0, 63, &opener_z)
+                .unwrap_err()
+                .raw_os_error(),
+            edeadlk
+        );
+
+        // FLUSH on the waited file Y for B does not disturb B's wait on X;
+        // FLUSH on X (B's waited file itself) kills B's X waiter with EINTR.
+        table.flush_owner(Y, B);
+        assert_eq!(
+            table
+                .wait_attempt(X, 2005, B, 902, false, true, 0, 63, &opener_x)
+                .unwrap_err()
+                .raw_os_error(),
+            eagain // waiter alive: flushing a different file is per-file
+        );
+        table.flush_owner(X, B);
+        assert_eq!(
+            table
+                .wait_attempt(X, 2005, B, 902, false, true, 0, 63, &opener_x)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINTR)
+        );
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
