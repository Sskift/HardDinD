+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        if cmd == libc::F_GETLK {
+            (
+                rc,
+                Some(lock.l_pid),
+            )
+        } else if rc < 0 {
+            (rc, io::Error::last_os_error().raw_os_error())
+        } else {
+            (rc, Some(0))
+        }
+    }
