+    #[test]
+    fn harddind_posix_locks_multi_open_rename_unlink_and_retry_grant() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-life-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("life");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        let inode = fs.do_lookup(1, &CString::new("life").unwrap()).unwrap().inode;
+        let handle1 = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let handle2 = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+
+        // Two guest opens by one owner share the owner fd: the second lock does
+        // not conflict, and FLUSH on either open releases the owner's locks.
+        let owner = 0x2001u64;
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_WRLCK, 10, 10))
+            .unwrap();
+        fs.setlk(ctx, inode, handle2, owner, 2001, harddind_plock(libc::F_WRLCK, 10, 10))
+            .unwrap();
+        fs.flush(ctx, inode, handle1, owner).unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 10, 10),
+            (0, Some(0))
+        );
+
+        // The retry worker's nonblocking poll sees EAGAIN then grants after unlock.
+        let other = 0x2002u64;
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        assert_eq!(
+            fs.setlk(ctx, inode, handle2, other, 2002, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_UNLCK, 0, 64))
+            .unwrap();
+        fs.setlk(ctx, inode, handle2, other, 2002, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        fs.flush(ctx, inode, handle2, other).unwrap();
+
+        // Inode identity follows rename and unlink; locks keep working on the
+        // same nodeid and are releasable after the name disappears.
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        std::fs::rename(&path, base.join("life-moved")).unwrap();
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_WRLCK, 64, 64))
+            .unwrap();
+        let found = fs
+            .getlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!(found.type_ as i32, libc::F_WRLCK);
+        std::fs::remove_file(base.join("life-moved")).unwrap();
+        fs.setlk(ctx, inode, handle1, owner, 2001, harddind_plock(libc::F_WRLCK, 128, 64))
+            .unwrap();
+        // `other`'s owner fd was flushed earlier, so GETLK lazily reopens the
+        // inode through /proc/self/fd even though the last name is gone.
+        let unlinked = fs
+            .getlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!(unlinked.type_ as i32, libc::F_WRLCK);
+        fs.flush(ctx, inode, handle1, owner).unwrap();
+        fs.flush(ctx, inode, handle2, other).unwrap();
+        std::fs::remove_dir_all(base).unwrap();
+    }
