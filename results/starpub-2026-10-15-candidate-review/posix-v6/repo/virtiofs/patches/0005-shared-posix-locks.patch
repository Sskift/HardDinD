+
+    fn fcntl_lock(file: &File, cmd: i32, type_: i32, start: i64, len: i64) -> (i32, Option<i32>) {
+        let mut lock = libc::flock {
+            l_type: type_ as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        let error = if rc < 0 {
+            io::Error::last_os_error().raw_os_error()
+        } else {
+            None
+        };
+        (rc, error)
+    }
+
+    fn apply(table: &PosixLockTable, inode: Inode, owner: u64, pid: u32, write: bool,
+             start: u64, end: u64, unlock: bool,
+             opener: &impl Fn(bool) -> io::Result<File>) {
+        // Syscall + shadow mutation are one locked operation in the table.
+        table
+            .attempt_once(inode, owner, pid, unlock, write, start, end, opener)
+            .unwrap();
+    }
