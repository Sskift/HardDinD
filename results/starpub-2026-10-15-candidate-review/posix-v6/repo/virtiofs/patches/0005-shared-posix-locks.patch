@@ -0,0 +1,1166 @@
+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+
+//! Per-guest-owner host file descriptors for POSIX byte-range locks.
+//!
+//! Linux POSIX record locks (`fcntl(2)` `F_SETLK`) are owned by the process's
+//! `struct files_struct`.  The FUSE protocol identifies that owner with the
+//! per-mount scrambled 64-bit value carried in `fuse_lk_in::owner` and
+//! `fuse_flush_in::lock_owner`; threads and `dup(2)` share it, `fork(2)`
+//! without `CLONE_FILES` produces a new one.
+//!
+//! Traditional host locks cannot distinguish between guest owners because all
+//! requests run in one virtiofsd process.  Per-open `F_OFD_SETLK` is not
+//! sufficient either: two opens by the same guest process would then conflict
+//! with each other, while locks taken through one fd would survive the close
+//! of another fd (both contradict POSIX semantics).  Instead this table keeps
+//! exactly one host open file description per access mode per
+//! `(inode, owner)` and issues all of that owner's lock operations with
+//! `F_OFD_SETLK`/`F_OFD_GETLK` on it:
+//!
+//! * different owners use different fds, so their locks conflict on the host
+//!   exactly like locks of independent host processes, in both directions
+//!   with host-native POSIX locks;
+//! * repeated operations on the owner's fd reproduce one owner's split/merge
+//!   behavior and never conflict with the owner itself;
+//! * `FLUSH` is sent by the guest for every `close(2)`, and POSIX semantics
+//!   release all of that owner's record locks on the inode on any close, so
+//!   `flush_owner` marks the entry dead and closes the fds.
+//!
+//! A shadow interval set per owner mirrors the kernel lock records so GETLK
+//! can attribute a host OFD conflict (whose `l_pid` is -1) back to the guest
+//! tgid the client sent with SETLK.  Blocking requests register a waiter used
+//! for guest-side deadlock detection; a waiter whose entry was flushed fails
+//! with EINTR and can never acquire or recreate a lock.
+//!
+//! All fcntl operations issued through this module are nonblocking.
+
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::io;
+use std::os::unix::io::AsRawFd;
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::sync::{Arc, Mutex, MutexGuard};
+
+use super::inode_store::Inode;
+
+/// Inclusive range; `end == i64::MAX as u64` means "through end of file".
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) struct Interval {
+    pub(super) write: bool,
+    pub(super) start: u64,
+    pub(super) end: u64,
+}
+
+impl Interval {
+    fn overlaps(&self, start: u64, end: u64) -> bool {
+        self.start <= end && start <= self.end
+    }
+
+    /// POSIX conflict: writers block everyone; a read request only conflicts
+    /// with a held write lock.
+    fn conflicts(&self, want_write: bool, start: u64, end: u64) -> bool {
+        self.overlaps(start, end) && (want_write || self.write)
+    }
+}
+
+/// Subtract `[start,end]` from every overlapping record (split, no deletion
+/// of the surrounding parts).
+fn interval_cut(intervals: &mut Vec<Interval>, start: u64, end: u64) {
+    let mut kept = Vec::with_capacity(intervals.len() + 2);
+    for it in intervals.drain(..) {
+        if it.start > end || it.end < start {
+            kept.push(it);
+            continue;
+        }
+        if it.start < start {
+            kept.push(Interval {
+                write: it.write,
+                start: it.start,
+                end: start - 1,
+            });
+        }
+        if it.end > end {
+            kept.push(Interval {
+                write: it.write,
+                start: end + 1,
+                end: it.end,
+            });
+        }
+    }
+    *intervals = kept;
+}
+
+/// Apply a POSIX lock acquisition: cut the range out of existing records
+/// (including same-typed ones) then insert and coalesce with same-type
+/// adjacent/overlapping neighbors, matching the kernel's split/merge.
+fn interval_apply(intervals: &mut Vec<Interval>, op: Interval) {
+    if op.start > op.end {
+        return;
+    }
+    interval_cut(intervals, op.start, op.end);
+    let mut merged = op;
+    intervals.retain(|it| {
+        if it.write != merged.write {
+            return true;
+        }
+        if it.end + 1 >= merged.start && it.start <= merged.end + 1 {
+            merged.start = merged.start.min(it.start);
+            merged.end = merged.end.max(it.end);
+            false
+        } else {
+            true
+        }
+    });
+    intervals.push(merged);
+    intervals.sort_by_key(|it| it.start);
+}
+
+/// Remove an unlock range (cut only; nothing is inserted).
+fn interval_unlock(intervals: &mut Vec<Interval>, start: u64, end: u64) {
+    if start <= end {
+        interval_cut(intervals, start, end);
+        intervals.sort_by_key(|it| it.start);
+    }
+}
+
+pub(super) struct OwnerEntry {
+    /// Single host description carrying this owner's locks; its access mode
+    /// matches the first lock request. One fd is what makes split/merge and
+    /// multi-open identity exact (two fds would self-conflict under OFD).
+    file: Mutex<Option<Arc<File>>>,
+    /// Guest tgid in the mount pid namespace, sent with each SETLK; 0 unknown.
+    guest_pid: AtomicU32,
+    /// Shadow copy of the owner's granted records (for GETLK attribution).
+    intervals: Mutex<Vec<Interval>>,
+    /// Set when FLUSH closed this entry; stale waiters must abort, not retry.
+    dead: AtomicBool,
+}
+
+impl OwnerEntry {
+    fn new() -> Self {
+        OwnerEntry {
+            file: Mutex::new(None),
+            guest_pid: AtomicU32::new(0),
+            intervals: Mutex::new(Vec::new()),
+            dead: AtomicBool::new(false),
+        }
+    }
+
+    fn is_dead(&self) -> bool {
+        self.dead.load(Ordering::SeqCst)
+    }
+}
+
+/// A pending F_SETLKW request.  Waiters are tracked GLOBALLY (not per inode):
+/// an all-guest deadlock routinely spans files (A holds X waits Y, B holds Y
+/// waits X), so the wait-for graph must not be scoped to one InodeLockSet.
+struct Waiter {
+    inode: Inode,
+    entry: Arc<OwnerEntry>,
+    owner: u64,
+    want_write: bool,
+    start: u64,
+    end: u64,
+}
+
+pub(super) struct InodeLockSet {
+    /// Held across the nonblocking fcntl and owner-table updates, never across
+    /// a blocking wait.  Orders lock attempts against `FLUSH`/forget teardown
+    /// for this inode so a granted lock cannot outlive the fd close that was
+    /// supposed to release it.
+    serialize: Arc<Mutex<()>>,
+
+    owners: Mutex<BTreeMap<u64, Arc<OwnerEntry>>>,
+}
+
+impl InodeLockSet {
+    fn new() -> Self {
+        InodeLockSet {
+            serialize: Arc::new(Mutex::new(())),
+            owners: Mutex::new(BTreeMap::new()),
+        }
+    }
+
+    /// Guest owners whose GRANTED intervals block the given wait request on
+    /// this inode.  Host-process holders are deliberately absent: mixed
+    /// host/guest cycles cannot be tracked from userspace and stay an explicit
+    /// pending limitation.
+    fn blockers_of(&self, want_write: bool, start: u64, end: u64, except: u64) -> Vec<u64> {
+        let owners = self.owners.lock().unwrap();
+        let mut out = Vec::new();
+        for (&owner, entry) in owners.iter() {
+            if owner == except || entry.is_dead() {
+                continue;
+            }
+            if entry
+                .intervals
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|it| it.conflicts(want_write, start, end))
+            {
+                out.push(owner);
+            }
+        }
+        out
+    }
+}
+
+/// Verdict of one locked reachability pass over the global wait graph.
+#[derive(Debug)] enum CycleVerdict {
+    /// A path back to the root owner exists using only waiters on locked
+    /// inodes whose grants are frozen.
+    Cycle,
+    /// No such path using locked inodes; all referenced inodes were locked.
+    NoCycle,
+    /// The traversal needed granted-owner state from an unlocked inode.
+    NeedExpand(Vec<Inode>),
+}
+
+#[derive(Default)]
+pub(super) struct PosixLockTable {
+    inodes: Mutex<BTreeMap<Inode, Arc<InodeLockSet>>>,
+
+    /// Global pending-waiter registry keyed by FUSE request unique.
+    /// Lock order: per-inode `serialize` -> `waiters` -> owner `intervals`;
+    /// `intervals` is a leaf lock and `inodes` is only briefly mapped/cloned.
+    waiters: Mutex<BTreeMap<u64, Waiter>>,
+}
+
+impl PosixLockTable {
+    pub(super) fn new() -> Self {
+        PosixLockTable::default()
+    }
+
+    fn set_for(&self, inode: Inode) -> Arc<InodeLockSet> {
+        let mut inodes = self.inodes.lock().unwrap();
+        Arc::clone(
+            inodes
+                .entry(inode)
+                .or_insert_with(|| Arc::new(InodeLockSet::new())),
+        )
+    }
+
+    /// Obtain an owner entry, creating its fd lazily.  `open(write)` opens the
+    /// inode honoring the requesting guest handle's access mode; an existing
+    /// fd is reused even after a permission change, like an fd already held.
+    fn entry_with_file(
+        set: &InodeLockSet,
+        owner: u64,
+        need_write: bool,
+        open: &impl Fn(bool) -> io::Result<File>,
+    ) -> io::Result<Arc<OwnerEntry>> {
+        let entry = {
+            let mut owners = set.owners.lock().unwrap();
+            Arc::clone(owners.entry(owner).or_insert_with(|| Arc::new(OwnerEntry::new())))
+        };
+        if entry.is_dead() {
+            return Err(io::Error::from_raw_os_error(libc::EINTR));
+        }
+        if entry.file.lock().unwrap().is_none() {
+            let file = Arc::new(open(need_write)?);
+            // The guest kernel rejects lock types its fd mode cannot take
+            // before sending them, so the opened mode always matches need.
+            *entry.file.lock().unwrap() = Some(file);
+        }
+        Ok(entry)
+    }
+
+    fn file_for(entry: &OwnerEntry) -> Option<Arc<File>> {
+        entry.file.lock().unwrap().clone()
+    }
+
+    /// Run `op` against an fd carrying `owner`'s locks.  The inode's teardown
+    /// lock is held, so FLUSH/forget cannot close fds while the nonblocking
+    /// fcntl runs.
+    pub(super) fn with_owner_file<R>(
+        &self,
+        inode: Inode,
+        owner: u64,
+        need_write: bool,
+        open: impl Fn(bool) -> io::Result<File>,
+        op: impl FnOnce(&File) -> io::Result<R>,
+    ) -> io::Result<R> {
+        let set = self.set_for(inode);
+        let _guard: MutexGuard<'_, ()> = set.serialize.lock().unwrap();
+        let entry = Self::entry_with_file(&set, owner, need_write, &open)?;
+        let file = Self::file_for(&entry)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EBADF))?;
+        op(&file)
+    }
+
+    /// The host fcntl and the shadow interval mutation are ONE critical
+    /// section: callers must hold `set.serialize`.  A concurrent same-owner
+    /// unlock (another worker thread, another open fd) is serialized against
+    /// this, so a successful syscall can never be followed by a stale shadow
+    /// insert after an intervening unlock (the v4 atomicity gap).  `unique`
+    /// identifies a blocking retry (None for one-shot F_SETLK); on EAGAIN the
+    /// waiter is registered/refreshed, on grant or fatal error it is removed.
+    #[allow(clippy::too_many_arguments)]
+    fn fcntl_and_shadow_locked(
+        &self,
+        set: &InodeLockSet,
+        inode: Inode,
+        unique: Option<u64>,
+        reuse_entry: Option<Arc<OwnerEntry>>,
+        owner: u64,
+        guest_pid: u32,
+        unlock: bool,
+        write: bool,
+        start: u64,
+        end: u64,
+        open: &impl Fn(bool) -> io::Result<File>,
+    ) -> io::Result<Arc<OwnerEntry>> {
+        let entry = match reuse_entry {
+            Some(entry) => entry,
+            None => Self::entry_with_file(set, owner, write, open)?,
+        };
+        let file = Self::file_for(&entry)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EBADF))?;
+        let flock_type = if unlock {
+            libc::F_UNLCK
+        } else if write {
+            libc::F_WRLCK
+        } else {
+            libc::F_RDLCK
+        };
+        let mut flock = libc::flock {
+            l_type: flock_type as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start as i64,
+            l_len: if end == i64::MAX as u64 {
+                0
+            } else {
+                (end - start + 1) as i64
+            },
+            l_pid: 0,
+        };
+        // Safe: nonblocking fcntl with a pointer to the local flock.
+        let ret = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_OFD_SETLK, &mut flock) };
+        if ret == 0 {
+            if let Some(unique) = unique {
+                self.waiters.lock().unwrap().remove(&unique);
+            }
+            if guest_pid != 0 {
+                entry.guest_pid.store(guest_pid, Ordering::Relaxed);
+            }
+            // Shadow mutation in the SAME critical section as the syscall.
+            {
+                let mut intervals = entry.intervals.lock().unwrap();
+                if unlock {
+                    interval_unlock(&mut intervals, start, end);
+                } else {
+                    interval_apply(&mut intervals, Interval { write, start, end });
+                }
+            }
+            return Ok(entry);
+        }
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() == Some(libc::EAGAIN) {
+            if let Some(unique) = unique {
+                self.waiters.lock().unwrap().insert(
+                    unique,
+                    Waiter {
+                        inode,
+                        entry: Arc::clone(&entry),
+                        owner,
+                        want_write: write,
+                        start,
+                        end,
+                    },
+                );
+            }
+        } else if let Some(unique) = unique {
+            self.waiters.lock().unwrap().remove(&unique);
+        }
+        Err(error)
+    }
+
+    /// One-shot nonblocking F_SETLK/F_UNLCK: syscall and shadow update under a
+    /// single teardown lock.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn attempt_once(
+        &self,
+        inode: Inode,
+        owner: u64,
+        guest_pid: u32,
+        unlock: bool,
+        write: bool,
+        start: u64,
+        end: u64,
+        open: impl Fn(bool) -> io::Result<File>,
+    ) -> io::Result<()> {
+        let set = self.set_for(inode);
+        let _guard: MutexGuard<'_, ()> = set.serialize.lock().unwrap();
+        self.fcntl_and_shadow_locked(
+            &set, inode, None, None, owner, guest_pid, unlock, write, start, end, &open,
+        )?;
+        Ok(())
+    }
+
+    /// Reachability restricted to LOCKED inode sets (same Arc identities that
+    /// the caller holds serialize on).  Waiters on unlocked inodes are never
+    /// traversed; their inodes are returned for deterministic expansion.
+    /// Caller holds global `waiters`; owners/intervals reads only happen on
+    /// sets present in `locked`, whose grants are frozen.
+    fn reach_with_locked(
+        locked: &BTreeMap<Inode, Arc<InodeLockSet>>,
+        waiters: &BTreeMap<u64, Waiter>,
+        root: u64,
+    ) -> CycleVerdict {
+        let mut needed = std::collections::BTreeSet::new();
+        let mut stack = vec![root];
+        let mut visited = std::collections::BTreeSet::new();
+        let mut took_an_edge = false;
+        while let Some(owner) = stack.pop() {
+            for w in waiters.values() {
+                if w.owner != owner || w.entry.is_dead() {
+                    continue;
+                }
+                let set = match locked.get(&w.inode) {
+                    Some(set) => set,
+                    None => {
+                        needed.insert(w.inode);
+                        continue;
+                    }
+                };
+                took_an_edge = true;
+                for blocker in set.blockers_of(w.want_write, w.start, w.end, owner) {
+                    if blocker == root && took_an_edge {
+                        return CycleVerdict::Cycle;
+                    }
+                    if visited.insert(blocker) {
+                        stack.push(blocker);
+                    }
+                }
+            }
+        }
+        if !needed.is_empty() {
+            CycleVerdict::NeedExpand(needed.into_iter().collect())
+        } else {
+            let _ = took_an_edge;
+            CycleVerdict::NoCycle
+        }
+    }
+
+    /// One nonblocking poll for a pending F_SETLKW, then an authoritative
+    /// cross-inode cycle verdict.  Returns:
+    /// * `Ok(())` granted (waiter removed, syscall+shadow were atomic);
+    /// * `Err(EAGAIN)` still blocked, no CURRENTLY PROVABLE cycle;
+    /// * `Err(EDEADLK)` the request closes a guest-owner wait cycle spanning
+    ///   any number of files, proven with every involved inode's grants
+    ///   frozen;
+    /// * `Err(EINTR)` the owner entry was flushed while waiting: it never
+    ///   acquired and cannot be resurrected by this retry.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn wait_attempt(
+        &self,
+        inode: Inode,
+        unique: u64,
+        owner: u64,
+        guest_pid: u32,
+        unlock: bool,
+        write: bool,
+        start: u64,
+        end: u64,
+        open: impl Fn(bool) -> io::Result<File>,
+    ) -> io::Result<()> {
+        let set = self.set_for(inode);
+        // Phase 1: one nonblocking fcntl with syscall+shadow under this
+        // inode's teardown lock.  The existing-waiter lookup guard is scoped
+        // so it cannot re-lock the global waiters mutex inside the block
+        // (v1 self-deadlock root cause).
+        let blocked = {
+            let _guard: MutexGuard<'_, ()> = set.serialize.lock().unwrap();
+            let existing = {
+                let waiters = self.waiters.lock().unwrap();
+                waiters.get(&unique).map(|w| {
+                    if w.entry.is_dead() {
+                        Err(io::Error::from_raw_os_error(libc::EINTR))
+                    } else {
+                        Ok(Arc::clone(&w.entry))
+                    }
+                })
+            };
+            match existing {
+                Some(Ok(entry)) => {
+                    match self.fcntl_and_shadow_locked(
+                        &set, inode, Some(unique), Some(entry), owner, guest_pid,
+                        unlock, write, start, end, &open,
+                    ) {
+                        Ok(_) => return Ok(()),
+                        Err(e) if e.raw_os_error() == Some(libc::EAGAIN) => true,
+                        Err(e) => return Err(e),
+                    }
+                }
+                Some(Err(ein)) => {
+                    self.waiters.lock().unwrap().remove(&unique);
+                    return Err(ein);
+                }
+                None => {
+                    match self.fcntl_and_shadow_locked(
+                        &set, inode, Some(unique), None, owner, guest_pid,
+                        unlock, write, start, end, &open,
+                    ) {
+                        Ok(_) => return Ok(()),
+                        Err(e) if e.raw_os_error() == Some(libc::EAGAIN) => true,
+                        Err(e) => return Err(e),
+                    }
+                }
+            }
+        };
+        let _ = blocked;
+
+        // Phase 2: authoritative cross-inode cycle verification.  Each pass
+        // freezes grants on a deterministically growing set of inodes (all
+        // serialize guards taken in ascending Inode order, never re-entrant)
+        // together with the global waiter registry; every wait edge in a
+        // confirmed cycle is read from one of those same locked Arc sets.
+        let mut targets: std::collections::BTreeSet<Inode> = std::collections::BTreeSet::new();
+        targets.insert(inode);
+        // Bounded by the finite number of inodes plus one safety iteration;
+        // every retry adds at least one new inode or terminates.
+        for _ in 0..1024 {
+            // Acquire ordered teardown guards, then the global waiter lock.
+            let mut ordered: Vec<(Inode, Arc<InodeLockSet>)> = {
+                let inodes = self.inodes.lock().unwrap();
+                targets
+                    .iter()
+                    .filter_map(|inode| inodes.get(inode).map(|s| (*inode, Arc::clone(s))))
+                    .collect()
+            };
+            ordered.sort_by_key(|(inode, _)| *inode);
+            let locked: BTreeMap<Inode, Arc<InodeLockSet>> =
+                ordered.iter().map(|(inode, s)| (*inode, Arc::clone(s))).collect();
+            let guards: Vec<_> = locked
+                .values()
+                .map(|s| s.serialize.lock().unwrap())
+                .collect();
+            let verdict = {
+                let waiters = self.waiters.lock().unwrap();
+                Self::reach_with_locked(&locked, &waiters, owner)
+            };
+            drop(guards);
+            match verdict {
+                CycleVerdict::Cycle => {
+                    // Remove only our own edge; other waiters must keep
+                    // failing until their holders unlock.
+                    let mut g = self.waiters.lock().unwrap();
+                    if let Some(w) = g.get(&unique) {
+                        if w.owner == owner && w.inode == inode {
+                            g.remove(&unique);
+                        }
+                    }
+                    return Err(io::Error::from_raw_os_error(libc::EDEADLK));
+                }
+                CycleVerdict::NoCycle => {
+                    return Err(io::Error::from_raw_os_error(libc::EAGAIN));
+                }
+                CycleVerdict::NeedExpand(more) => {
+                    let before = targets.len();
+                    targets.extend(more);
+                    // Inode sets that vanished (forget) cannot block anyone;
+                    // convergence is reached when no new lockable inode joins.
+                    if targets.len() == before {
+                        return Err(io::Error::from_raw_os_error(libc::EAGAIN));
+                    }
+                }
+            }
+        }
+        // Safety bound: never spin; the next retry-queue poll re-evaluates.
+        Err(io::Error::from_raw_os_error(libc::EAGAIN))
+    }
+
+    #[cfg(test)]
+    pub(super) fn is_waiting(&self, unique: u64) -> bool {
+        self.waiters.lock().unwrap().contains_key(&unique)
+    }
+
+    /// FUSE_INTERRUPT/teardown for a pending waiter: drop its registration so
+    /// a later grant cycle cannot treat it as live or form phantom edges.
+    pub(super) fn wait_cancel(&self, inode: Inode, unique: u64) {
+        let mut g = self.waiters.lock().unwrap();
+        if let Some(w) = g.get(&unique) {
+            if w.inode == inode {
+                g.remove(&unique);
+            }
+        }
+    }
+
+    /// Resolve the guest pid owning the OFD record the host reported for a
+    /// GETLK query.  The host returns the first conflicting lock (which may be
+    /// a fragment of the owner's shadow set), so match by the same conflict
+    /// rule rather than exact interval equality; shadow records are in start
+    /// order and the lowest-starting candidate wins, mirroring the kernel.
+    /// Returns 0 for unattributable (host-process) holders so a host pid can
+    /// never be confused with a coincidental guest pid.
+    pub(super) fn attribute(&self, inode: Inode, query_write: bool, start: u64, end: u64) -> u32 {
+        let set = match self.inodes.lock().unwrap().get(&inode) {
+            Some(set) => Arc::clone(set),
+            None => return 0,
+        };
+        let found_pid = {
+            let owners = set.owners.lock().unwrap();
+            let mut candidates: Vec<(u64, u32)> = Vec::new();
+            for entry in owners.values() {
+                if entry.is_dead() {
+                    continue;
+                }
+                let pid = entry.guest_pid.load(Ordering::Relaxed);
+                if pid == 0 {
+                    continue;
+                }
+                let intervals = entry.intervals.lock().unwrap();
+                if let Some(first) = intervals
+                    .iter()
+                    .filter(|it| it.conflicts(query_write, start, end))
+                    .map(|it| it.start)
+                    .min()
+                {
+                    candidates.push((first, pid));
+                }
+            }
+            candidates.sort_by_key(|(s, _)| *s);
+            candidates.first().map(|(_, pid)| *pid).unwrap_or(0)
+        };
+        found_pid
+    }
+
+    /// Close the fd carrying all host representation of `owner`'s locks on
+    /// `inode`; called from FUSE FLUSH (every guest close on that file).
+    /// POSIX record locks are per (process, file):
+    /// * the dead entry stops blocking anyone (removed from the owners map)
+    ///   and its pending waiters on THIS inode are excluded from the wait-for
+    ///   graph (`reach_self_locked` skips dead entries) and fail EINTR on their
+    ///   next poll, after which they are unregistered;
+    /// * a close on file X does not touch the same owner's pending wait on a
+    ///   different file Y, whose entry lives on Y.  Those die via
+    ///   FUSE_INTERRUPT, per-inode FLUSH when Y closes (process exit flushes
+    ///   every open file), forget, or DESTROY.
+    pub(super) fn flush_owner(&self, inode: Inode, owner: u64) {
+        let set = match self.inodes.lock().unwrap().get(&inode) {
+            Some(set) => Arc::clone(set),
+            None => return,
+        };
+        let _guard = set.serialize.lock().unwrap();
+        let removed = set.owners.lock().unwrap().remove(&owner);
+        if let Some(entry) = removed {
+            entry.dead.store(true, Ordering::SeqCst);
+            // Dropping the fd releases every OFD lock held through this entry.
+            *entry.file.lock().unwrap() = None;
+        }
+    }
+
+    /// Drop all owner fds for an inode when the guest forgets it, and purge any
+    /// waiters referencing it (a forgotten inode cannot block or be blocked).
+    /// Operations already in flight keep the `InodeLockSet` alive via Arc.
+    pub(super) fn forget_inode(&self, inode: Inode) {
+        self.inodes.lock().unwrap().remove(&inode);
+        let stale: Vec<u64> = self
+            .waiters
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(_, w)| w.inode == inode)
+            .map(|(unique, _)| *unique)
+            .collect();
+        if !stale.is_empty() {
+            let mut g = self.waiters.lock().unwrap();
+            for unique in stale {
+                g.remove(&unique);
+            }
+        }
+    }
+
+    /// Release every lock tracked by the table (DESTROY / re-init).
+    pub(super) fn clear(&self) {
+        self.inodes.lock().unwrap().clear();
+        self.waiters.lock().unwrap().clear();
+    }
+}
