+    // Raw host fcntl with explicit signed offsets; mirrors what the FUSE
+    // wire's inclusive start/end is translated into.
+    fn harddind_host_fcntl64(
+        path: &std::path::Path,
+        cmd: i32,
+        type_: i32,
+        start: i64,
+        len: i64,
+    ) -> (i32, Option<i32>) {
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(path)
+            .unwrap();
+        let mut lock = libc::flock64 {
+            l_type: type_ as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        let error = if rc < 0 {
+            io::Error::last_os_error().raw_os_error()
+        } else {
+            None
+        };
+        (rc, error)
+    }
