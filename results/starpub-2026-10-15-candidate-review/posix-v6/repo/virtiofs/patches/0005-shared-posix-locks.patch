+        let fs = harddind_posix_fs(&base);
+        let nx = CString::new("x").unwrap();
+        let ny = CString::new("y").unwrap();
+        let ix = fs.do_lookup(1, &nx).unwrap().inode;
+        let iy = fs.do_lookup(1, &ny).unwrap().inode;
+        assert_ne!(ix, iy);
+        // Two handles per inode emulate each guest process's open fds.
+        let ax = fs.do_open(ix, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let bx = fs.do_open(ix, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ay = fs.do_open(iy, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let by = fs.do_open(iy, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        const A: u64 = 0xD00A;
+        const B: u64 = 0xD00B;
+        let eagain = Some(libc::EAGAIN);
+
+        // Host fds confirm the real backing state at each step.
+        let hostx = std::fs::OpenOptions::new().read(true).write(true).open(&pathx).unwrap();
+        let hosty = std::fs::OpenOptions::new().read(true).write(true).open(&pathy).unwrap();
+
+        fs.setlk(ctx, ix, ax, A, 91, harddind_plock(libc::F_WRLCK, 0, 64)).unwrap();
+        fs.setlk(ctx, iy, by, B, 92, harddind_plock(libc::F_WRLCK, 0, 64)).unwrap();
+        assert_eq!(
+            harddind_host_fcntl64(&pathx, libc::F_SETLK, libc::F_WRLCK, 0, 64),
+            (-1, eagain)
+        );
+        assert_eq!(
+            harddind_host_fcntl64(&pathy, libc::F_SETLK, libc::F_WRLCK, 0, 64),
+            (-1, eagain)
+        );
+
+        // A waits on Y (poll #1, bounded: must return EAGAIN immediately).
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 3001, iy, ay, A, 91, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err().raw_os_error(),
+            eagain
+        );
+        // B closes the X->A edge by waiting on X: the daemon detects the
+        // two-file guest cycle and returns EDEADLK without a timeout.
+        assert_eq!(
+            fs.setlk_wait_attempt(ctx, 3002, ix, bx, B, 92, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err().raw_os_error(),
+            Some(libc::EDEADLK)
+        );
+        // No phantom grant: B never holds X.
+        assert_eq!(
+            harddind_host_fcntl64(&pathx, libc::F_SETLK, libc::F_WRLCK, 64, 64).0,
+            0
+        );
+
+        // B unlocks Y; A's still-pending waiter grants on the next bounded poll.
+        fs.setlk(ctx, iy, by, B, 92, harddind_plock(libc::F_UNLCK, 0, 64)).unwrap();
+        fs.setlk_wait_attempt(ctx, 3001, iy, ay, A, 91, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl64(&pathy, libc::F_SETLK, libc::F_WRLCK, 0, 64),
+            (-1, eagain)
+        );
+        fs.setlk(ctx, iy, ay, A, 91, harddind_plock(libc::F_UNLCK, 0, 64)).unwrap();
+        fs.setlk(ctx, ix, ax, A, 91, harddind_plock(libc::F_UNLCK, 0, 64)).unwrap();
+
+        // Non-cycle control: one waiting owner with no closing edge polls
+        // EAGAIN repeatedly and grants after unlock (never EDEADLK).
+        fs.setlk(ctx, iy, by, B, 92, harddind_plock(libc::F_WRLCK, 0, 64)).unwrap();
+        for _ in 0..3 {
+            assert_eq!(
+                fs.setlk_wait_attempt(ctx, 3005, iy, ay, A, 91,
+                    harddind_plock(libc::F_WRLCK, 0, 64))
+                    .unwrap_err().raw_os_error(),
+                eagain
+            );
+        }
+        fs.setlk(ctx, iy, by, B, 92, harddind_plock(libc::F_UNLCK, 0, 64)).unwrap();
+        fs.setlk_wait_attempt(ctx, 3005, iy, ay, A, 91, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        fs.setlk(ctx, iy, ay, A, 91, harddind_plock(libc::F_UNLCK, 0, 64)).unwrap();
+        std::fs::remove_dir_all(base).unwrap();
+    }
+
+    #[test]
+    fn harddind_posix_locks_require_negotiation_and_refuse_when_disabled() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-off-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        std::fs::write(base.join("f"), b"x").unwrap();
+        // Enabled in configuration but the client lacks POSIX_LOCKS: hard error
+        // instead of a silent fallback to local locking.
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(),
+            shared_posix_locks: true,
+            inode_file_handles: InodeFileHandlesMode::Never,
+            ..Default::default()
+        })
+        .unwrap();
+        assert_eq!(
+            fs.init(FsOptions::FLOCK_LOCKS)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EPROTO)
+        );
+        // Feature off: ENOSYS from the fs methods even with a capable client.
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(),
+            inode_file_handles: InodeFileHandlesMode::Never,
+            ..Default::default()
+        })
+        .unwrap();
+        fs.init(FsOptions::POSIX_LOCKS).unwrap();
+        let inode = fs.do_lookup(1, &CString::new("f").unwrap()).unwrap().inode;
+        let handle = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(
+            fs.setlk(ctx, inode, handle, 1, 1, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        std::fs::remove_dir_all(base).unwrap();
+    }
