+    #[test]
+    fn harddind_posix_one_byte_adjacent_large_offsets_and_eof() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-byte-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("lock");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let name = CString::new("lock").unwrap();
+        let inode = fs.do_lookup(1, &name).unwrap().inode;
+        let handle = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        const W: i32 = libc::F_WRLCK;
+        let eof = PosixLock::EOF;
+        assert_eq!(eof, i64::MAX as u64);
+
+        // Single byte at zero: FUSE start=0,end=0. Byte 0 is held, byte 1 is free.
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(W, 0, 1)).unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 0, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 1, 1), (0, None));
+        let one = fs
+            .getlk(ctx, inode, handle, 0x3002, harddind_plock(W, 0, 1))
+            .unwrap();
+        assert_eq!((one.type_ as i32, one.start, one.end, one.pid),
+                   (W, 0, 0, 3001));
+        // Unlock of exactly the single byte releases it and nothing else.
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(libc::F_UNLCK, 0, 1))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 0, 1), (0, None));
+
+        // Nonzero single byte with adjacent exclusion on both sides.
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(W, 100, 1))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 100, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 99, 1), (0, None));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 101, 1), (0, None));
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(libc::F_UNLCK, 100, 1))
+            .unwrap();
+
+        // Above the old wrong 2^62 bound: bounded locks and the final loff_t byte.
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(W, 1u64 << 62, 8))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 1i64 << 62, 8),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, (1i64 << 62) - 1, 1),
+                   (0, None));
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(libc::F_UNLCK, 1u64 << 62, 8))
+            .unwrap();
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(W, eof, 1)).unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX - 1, 1),
+                   (0, None));
+
+        // Unbounded range from 2^62: GETLK across the whole space reports it
+        // with host l_len 0 -> FUSE end OFFSET_MAX, and last-byte conflict.
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(W, 1u64 << 62, 0))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, (1i64 << 62) - 1, 1),
+                   (0, None));
+        let tail = fs
+            .getlk(ctx, inode, handle, 0x3002, harddind_plock(W, 0, 0))
+            .unwrap();
+        assert_eq!((tail.type_ as i32, tail.start, tail.end),
+                   (W, 1u64 << 62, PosixLock::EOF));
+        fs.setlk(ctx, inode, handle, 0x3001, 3001, harddind_plock(libc::F_UNLCK, 1u64 << 62, 0))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (0, None));
+        std::fs::remove_dir_all(base).unwrap();
+    }
