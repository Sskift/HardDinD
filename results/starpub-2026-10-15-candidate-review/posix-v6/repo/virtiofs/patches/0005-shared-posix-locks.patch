+    #[test]
+    fn harddind_posix_syscall_shadow_atomicity_race() {
+        // Regression for the v4 gap: syscall and shadow interval update were
+        // two separate teardown-locked sections (grant in with_owner_file,
+        // then note_grant).  A same-owner unlock on another thread could land
+        // between them and be overwritten by the stale grant note, leaving a
+        // phantom interval while the host lock was gone.  The fix makes the
+        // fcntl and the shadow mutation one critical section, so paired
+        // lock/unlock threads must always converge to shadow == host state.
+        //
+        // Real table, real F_OFD_SETLK fcntl; fixed bounded iterations with a
+        // start barrier maximizing overlap; invariants are asserted on every
+        // round (never a timeout-based or map-only PASS).
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-atomic-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("locks");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let table = Arc::new(PosixLockTable::new());
+        const OWNER: u64 = 0xA701;
+        for round in 0..400 {
+            // Baseline owner grant for this round.
+            {
+                let opener = |w: bool| File::options().read(true).write(w).open(&path);
+                table
+                    .attempt_once(41, OWNER, 71, false, true, 0, 63, opener)
+                    .unwrap();
+            }
+            let barrier = Arc::new(std::sync::Barrier::new(3));
+            let mut handles = Vec::new();
+            // Re-grant thread (the stale-note loser in the old interleaving).
+            {
+                let table = Arc::clone(&table);
+                let path = path.clone();
+                let barrier = Arc::clone(&barrier);
+                handles.push(std::thread::spawn(move || {
+                    let opener = move |w: bool| File::options().read(true).write(w).open(&path);
+                    barrier.wait();
+                    table
+                        .attempt_once(41, OWNER, 71, false, true, 0, 63, opener)
+                        .unwrap();
+                }));
+            }
+            // Unlock thread.
+            handles.push({
+                let table = Arc::clone(&table);
+                let path = path.clone();
+                let barrier = Arc::clone(&barrier);
+                std::thread::spawn(move || {
+                    let opener = move |w: bool| File::options().read(true).write(w).open(&path);
+                    barrier.wait();
+                    table
+                        .attempt_once(41, OWNER, 71, true, true, 0, 63, opener)
+                        .unwrap();
+                })
+            });
+            barrier.wait();
+            for h in handles {
+                h.join().unwrap();
+            }
+            // Invariant after every round: whichever syscall happened last,
+            // the shadow MUST equal host state.  Authoritative host F_OFD_GETLK
+            // says either free or held (pid -1) by the table owner fd.
+            let host = File::options().read(true).write(true).open(&path).unwrap();
+            let mut q = libc::flock {
+                l_type: libc::F_WRLCK as i16, l_whence: libc::SEEK_SET as i16,
+                l_start: 0, l_len: 64, l_pid: 0,
+            };
+            let host_free = unsafe {
+                if libc::fcntl(host.as_raw_fd(), libc::F_OFD_GETLK, &mut q) < 0 {
+                    panic!("getlk failed");
+                }
+                q.l_type == libc::F_UNLCK as i16
+            };
+            let pid = table.attribute(41, true, 0, 63);
+            if host_free {
+                // The v4 stale-note race left pid 71 here while the host was free.
+                assert_eq!(pid, 0, "round {round}: phantom same-owner interval after host unlock");
+            } else {
+                assert_eq!(pid, 71, "round {round}: host holds but shadow lost the interval");
+            }
+        }
+        std::fs::remove_dir_all(base).unwrap();
+    }
