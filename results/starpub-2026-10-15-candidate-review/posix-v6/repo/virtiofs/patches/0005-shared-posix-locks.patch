+/// Decode a POSIX (non-flock) FUSE lock request into an absolute range.
+///
+/// FUSE endpoints are inclusive (`fuse_lk_in.lk.start`, `.lk.end`).  The Linux
+/// client resolves `SEEK_CUR`/`SEEK_END` and signed lengths into an absolute
+/// range before sending (`flock64_to_posix_lock`), and rejects its own
+/// overflows (`EOVERFLOW`/`EINVAL`), but the server validates again:
+///
+/// * `end == OFFSET_MAX` (`2^63 - 1`) encodes an unbounded "to end of file"
+///   lock, represented on the host with `l_len == 0`.
+/// * `end == 0` is the single byte at offset zero.  It is NOT a synonym for
+///   end-of-file; `start > 0, end == 0` is invalid.
+/// * any other request requires `start <= end <= OFFSET_MAX`; the resulting
+///   length must fit a positive signed `off_t`.
+fn harddind_parse_posix_lock(
+    header: InHeader,
+    request: &LkIn,
+) -> io::Result<(u64, u64, u32, PosixLock)> {
+    if header.len as usize != size_of::<InHeader>() + size_of::<LkIn>() {
+        return Err(io::Error::from_raw_os_error(libc::EINVAL));
+    }
+    if request.lk_flags & LK_FLOCK != 0 {
+        return Err(io::Error::from_raw_os_error(libc::EINVAL));
+    }
+    let lk_type = match request.lk.type_ as i32 {
+        libc::F_RDLCK | libc::F_WRLCK | libc::F_UNLCK => request.lk.type_,
+        _ => return Err(io::Error::from_raw_os_error(libc::EINVAL)),
+    };
+    if request.lk.start > PosixLock::EOF {
+        return Err(io::Error::from_raw_os_error(libc::EINVAL));
+    }
+    let len = match request.lk.end {
+        PosixLock::EOF => 0,
+        0 => {
+            if request.lk.start != 0 {
+                return Err(io::Error::from_raw_os_error(libc::EINVAL));
+            }
+            1
+        }
+        end if end < request.lk.start || end > PosixLock::EOF => {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        end => {
+            let len = end - request.lk.start + 1;
+            // The host struct flock uses signed off_t; the client cannot
+            // produce such a bounded request, reject rather than wrap negative.
+            if len > i64::MAX as u64 {
+                return Err(io::Error::from_raw_os_error(libc::EINVAL));
+            }
+            len
+        }
+    };
+    Ok((
+        request.fh,
+        request.owner,
+        request.lk.pid,
+        PosixLock {
+            lk_type,
+            start: request.lk.start,
+            len,
+        },
+    ))
+}
