+/* NV_ESC_RM_ALLOC (0x2b): only root-client allocation is exposed.  Every
+ * other hClass carries a class-specific pAllocParms block (and possibly a
+ * nested rights mask), so it is rejected rather than forwarding an
+ * untranslated guest pointer to the host driver. */
+static long gpu_rm_alloc(struct gpu_file *state, unsigned int command,
+			 unsigned long arg, size_t size)
+{
