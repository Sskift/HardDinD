+static void virtio_fs_interrupt_work(struct work_struct *work)
+{
+	struct fuse_req *original = container_of(work, struct fuse_req, intr_work);
+	struct virtio_fs *fs = original->chan->iq.priv;
+	struct virtio_fs_vq *fsvq = &fs->vqs[VQ_HIPRIO];
+	struct virtio_fs_hiprio *msg;
+
+	/* Submission can hold a spinlock. Allocate here without losing a signal
+	 * on allocation failure. The in-flight count protects the transport.
+	 */
+	msg = kzalloc_obj(*msg, GFP_NOFS | __GFP_NOFAIL);
+	msg->original = original;
+	msg->req.ih = (struct fuse_in_header) {
+		.opcode = FUSE_INTERRUPT,
+		.unique = original->in.h.unique | FUSE_INT_REQ_BIT,
+		.len = sizeof(struct virtio_fs_hiprio_req),
+	};
+	msg->req.arg.interrupt.unique = original->in.h.unique;
+	if (test_bit(FR_FINISHED, &original->flags)) {
+		virtio_fs_free_hiprio(msg);
+		spin_lock(&fsvq->lock);
+		dec_in_flight_req(fsvq);
+		spin_unlock(&fsvq->lock);
+		return;
+	}
+	send_hiprio_request(fsvq, msg, true);
+}
+
 static void virtio_fs_send_interrupt(struct fuse_iqueue *fiq, struct fuse_req *req)
 {
-	/*
-	 * TODO interrupts.
-	 *
-	 * Normal fs operations on a local filesystems aren't interruptible.
-	 * Exceptions are blocking lock operations; for example fcntl(F_SETLKW)
-	 * with shared lock between host and guest.
+	struct virtio_fs *fs = fiq->priv;
+	struct virtio_fs_vq *fsvq = &fs->vqs[VQ_HIPRIO];
+
+	if (!test_bit(FR_SENT, &req->flags) || test_bit(FR_FINISHED, &req->flags))
+		return;
+	/* One work item for the whole lifetime. EAGAIN retries reuse its message,
+	 * so the embedded work item can never be initialized while still running.
 	 */
+	if (test_and_set_bit(FR_VIRTIO_INTR, &req->flags))
+		return;
+	fuse_request_get(req);
+	INIT_WORK(&req->intr_work, virtio_fs_interrupt_work);
+	spin_lock(&fsvq->lock);
+	inc_in_flight_req(fsvq);
+	spin_unlock(&fsvq->lock);
+	schedule_work(&req->intr_work);
 }
 
 /* Count number of scatter-gather elements required */
@@ -1473,6 +1550,11 @@
 	set_bit(FR_SENT, &req->flags);
 	/* matches barrier in request_wait_answer() */
 	smp_mb__after_atomic();
+	/* Cover a signal observed before FR_SENT became visible. The queue lock
+	 * keeps the request alive until its asynchronous reference is taken.
+	 */
+	if (test_bit(FR_INTERRUPTED, &req->flags))
+		virtio_fs_send_interrupt(&req->chan->iq, req);
 
 	if (!in_flight)
 		inc_in_flight_req(fsvq);
