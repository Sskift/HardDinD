+		fuse_request_put(msg->original);
+	kfree(msg);
+}
+
+/* Complete FORGET and INTERRUPT requests on the priority queue. */
 static void virtio_fs_hiprio_done_work(struct work_struct *work)
 {
 	struct virtio_fs_vq *fsvq = container_of(work, struct virtio_fs_vq,
 						 done_work);
 	struct virtqueue *vq = fsvq->vq;
-
-	/* Free completed FUSE_FORGET requests */
+	struct virtio_fs_hiprio *msg, *next;
+	LIST_HEAD(completed);
+
 	spin_lock(&fsvq->lock);
 	do {
 		unsigned int len;
-		void *req;
 
 		virtqueue_disable_cb(vq);
-
-		while ((req = virtqueue_get_buf(vq, &len)) != NULL) {
-			kfree(req);
+		while ((msg = virtqueue_get_buf(vq, &len)) != NULL) {
+			if (msg->original && len) {
+				if (len != sizeof(msg->oh) || msg->oh.len != len ||
+				    msg->oh.unique != msg->req.ih.unique) {
+					pr_warn_ratelimited("virtio-fs: invalid interrupt reply\n");
+				} else if (msg->oh.error == -EAGAIN &&
+					   !test_bit(FR_FINISHED, &msg->original->flags) &&
+					   test_bit(FR_SENT, &msg->original->flags)) {
+					/* The interrupt may have arrived before the original. */
+					list_add_tail(&msg->list, &fsvq->queued_reqs);
+					continue;
+				} else if (msg->oh.error == -ENOSYS) {
+					WRITE_ONCE(msg->original->chan->no_interrupt, 1);
+				}
+			}
+			list_add_tail(&msg->list, &completed);
 			dec_in_flight_req(fsvq);
 		}
 	} while (!virtqueue_enable_cb(vq));
-
 	if (!list_empty(&fsvq->queued_reqs))
 		schedule_work(&fsvq->dispatch_work);
-
 	spin_unlock(&fsvq->lock);
+
+	/* Dropping the last original-request reference can release channel state. */
+	list_for_each_entry_safe(msg, next, &completed, list) {
+		list_del(&msg->list);
+		virtio_fs_free_hiprio(msg);
+	}
 }
 
