Subject: [PATCH] fuse: deliver cancellable virtiofs requests on the priority queue

Send FUSE_INTERRUPT with a reply buffer, retain the original request until
completion, retry EAGAIN, and close the signal-before-FR_SENT race.

--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -173,6 +173,18 @@
 		fuse_request_free(req);
 	}
 }
+
+void fuse_request_get(struct fuse_req *req)
+{
+	__fuse_get_request(req);
+}
+EXPORT_SYMBOL_GPL(fuse_request_get);
+
+void fuse_request_put(struct fuse_req *req)
+{
+	fuse_put_request(req);
+}
+EXPORT_SYMBOL_GPL(fuse_request_put);
 
