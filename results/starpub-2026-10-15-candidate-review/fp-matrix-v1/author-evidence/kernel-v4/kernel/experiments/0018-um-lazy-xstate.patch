diff --git a/arch/x86/um/fp_lazy.c b/arch/x86/um/fp_lazy.c
--- /dev/null
+++ b/arch/x86/um/fp_lazy.c
@@ -0,0 +1,554 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lazy XSTATE handoff for the UML SECCOMP syscall path (experiment 0018).
+ *
+ * In SECCOMP mode every guest syscall traps through a host SIGSYS. The host
+ * saves the guest XSTATE into the parked signal frame on the runner's stub
+ * stack and reloads it on rt_sigreturn. Without laziness the UML kernel also
+ * memcpys the whole image out of the frame into current->...regs.fp on entry
+ * and back into the same frame on exit: roughly two full-XSTATE copies per
+ * guest syscall, even though the overwhelming majority of syscalls never
+ * touch FP state.
+ *
+ * This file keeps the parked frame authoritative and moves only ownership
+ * bookkeeping. There is no heap allocation on any path and no OOM handling.
+ *
+ * States (descriptor in struct uml_pt_regs):
+ *
+ *   UML_FP_EAGER (0): regs->fp is authoritative (historical behaviour; the
+ *                     state at boot and after materialise/discard/fork).
+ *   UML_FP_LIVE:     the authoritative bytes sit in the parked frame
+ *                     fp_frame on runner fp_home; fp[] is stale.
+ *
+ *   entry  uml_fp_enter(): host just wrote frame F on runner R -> arm LIVE
+ *   exit   uml_fp_leave(): same task still owns the same frame -> skip the
+ *                          write-back so rt_sigreturn reloads it verbatim
+ *                          (fast path); otherwise collect the task's own
+ *                          bytes (cross-CPU migration), push the bytes of
+ *                          the frame's previous owner into that owner's own
+ *                          regs->fp buffer, then write the frame.
+ *   reader uml_fp_materialize(): signal delivery, FP/XSTATE regsets
+ *                          (ptrace and coredumps), fork -> frame into fp[]
+ *   writer uml_fp_discard(): sigreturn/exec overwrite fp[] wholesale ->
+ *                          drop ownership without copying
+ *   teardown uml_fp_handoff_reset(): mm destruction / broker cache recycle
+ *
+ * Lifetime protocol (revision 3):
+ *
+ *   A non-empty runner slot (struct um_fp_handoff.owner) holds ONE strong
+ *   reference to the owner task_struct (get at arm, exactly one put on every
+ *   clear via fp_put_task()). There is one such reference per runner slot,
+ *   so retained references are bounded by the slot count (broker +
+ *   cpu_ids[] + GPU worker), never by the dead-task count, and no heap nodes
+ *   exist.
+ *
+ *   put_task_struct() has no NULL guard in the kernel; every slot drop goes
+ *   through fp_put_task() which does. The captured pointer is put AFTER
+ *   releasing both locks, in process context with interrupts enabled.
+ *
+ *   Task exit deliberately does NOT touch the slot: do_exit() runs after
+ *   exit_mm(), at which point the mm_id embedded in the dying mm may already
+ *   be freed, so the descriptor's fp_home must not be dereferenced from the
+ *   exit path. A task that exits while LIVE is simply kept alive by the
+ *   slot reference; the very next frame write on that runner pushes the
+ *   image into the (dead but allocated) task's fp buffer, flips the
+ *   descriptor to EAGER and drops the reference; mm teardown drops it if the
+ *   slot was never reused. Storage retained for exited tasks is therefore at
+ *   most one task_struct per runner slot. The dying task dropped its mm in
+ *   exit_mm(), so no task->mm reference cycle is created.
+ *
+ *   mm teardown additionally clears the descriptor of a slot owner it
+ *   reaps (the strong reference keeps that storage valid), so nothing is
+ *   left LIVE pointing at the freed runner.
+ *
+ * Locking: one handoff lock per runner and one lock per task descriptor.
+ * The ONLY nesting order is handoff lock -> descriptor lock; the two are
+ * never held in the opposite order and two handoff locks are never held
+ * together. All transitions run in process context; UML IRQ handlers
+ * (SIGCHLD, GPU completion, IPI, timer) never touch handoff state.
+ *
+ * Default off (lazyxstate=0): behaviour is the old eager copy. i386 always
+ * uses the eager path because it additionally converts the legacy i387
+ * image on every transition.
+ */
+
+#include <linux/atomic.h>
+#include <linux/build_bug.h>
+#include <linux/irqflags.h>
+#include <linux/kernel.h>
+#include <linux/panic.h>
+#include <linux/processor.h>
+#include <linux/sched/task.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <asm/current.h>
+#include <registers.h>
+#include <skas/mm_id.h>
+#include <init.h>
+
+unsigned int uml_lazy_xstate;
+
+#ifdef __x86_64__
+/* LP64: pointer 8 + token 8 + lock 4, naturally packed = 24 bytes. */
+static_assert(sizeof(struct um_fp_handoff) == 24);
+
+/* ---- tiny IRQ-safe test-and-set locks over embedded lock words ---- */
+
+static __always_inline void handoff_lock(struct um_fp_handoff *handoff,
+					 unsigned long *flags)
+{
+	local_irq_save(*flags);
+	if (unlikely(cmpxchg(&handoff->lock, 0, 1) != 0)) {
+		do {
+			cpu_relax();
+		} while (READ_ONCE(handoff->lock) ||
+			 cmpxchg(&handoff->lock, 0, 1) != 0);
+	}
+}
+
+static __always_inline void handoff_unlock(struct um_fp_handoff *handoff,
+					   unsigned long flags)
+{
+	smp_store_release(&handoff->lock, 0);
+	local_irq_restore(flags);
+}
+
+static __always_inline void desc_lock(struct uml_pt_regs *regs)
+{
+	if (unlikely(cmpxchg(&regs->fp_lock, 0, 1) != 0)) {
+		do {
+			cpu_relax();
+		} while (READ_ONCE(regs->fp_lock) ||
+			 cmpxchg(&regs->fp_lock, 0, 1) != 0);
+	}
+}
+
+static __always_inline void desc_unlock(struct uml_pt_regs *regs)
+{
+	smp_store_release(&regs->fp_lock, 0);
+}
+
+/*
+ * The kernel put_task_struct() dereferences t->usage unconditionally; every
+ * slot drop in this file may legitimately carry NULL (empty slot, EAGER
+ * descriptor), so route them through this guard. Caller must be in process
+ * context with IRQs enabled (the final put may free the task struct).
+ */
+static void fp_put_task(struct task_struct *task)
+{
+	if (task)
+		put_task_struct(task);
+}
+
+/* Descriptor identity test usable for non-current (e.g. ptraced) tasks. */
+static __always_inline bool fp_regs_is_task(struct uml_pt_regs *regs,
+					   struct task_struct *task)
+{
+	return task && &task->thread.regs.regs == regs;
+}
+
+/* ---- entry -------------------------------------------------------------- */
+
+int uml_fp_enter(struct uml_pt_regs *regs, struct mm_id *runner,
+		 void *frame, unsigned int size)
+{
+	struct um_fp_handoff *handoff = &runner->fp_handoff;
+	unsigned long flags;
+
+	if (!uml_lazy_xstate)
+		goto eager;
+
+	handoff_lock(handoff, &flags);
+	if (unlikely(handoff->owner != NULL)) {
+		/*
+		 * Every frame write clears its slot, so an armed owner here
+		 * means a missing set/get round; refuse the frame rather
+		 * than overwrite an image whose owner expects it.
+		 */
+		handoff_unlock(handoff, flags);
+		return -EINVAL;
+	}
+
+	/* The slot now keeps the owner alive until the next clear. */
+	get_task_struct(current);
+	handoff->owner = current;
+	regs->fp_token = ++handoff->token;
+	regs->fp_home = runner;
+	regs->fp_frame = frame;
+	regs->fp_size = size;
+	smp_store_release(&regs->fp_state, UML_FP_LIVE);
+	handoff_unlock(handoff, flags);
+	return 1;
+
+eager:
+	uml_fp_reset(regs);
+	memcpy(regs->fp, frame, size);
+	return 0;
+}
+
+/*
+ * Coherent snapshot of the descriptor's (state, home) pair.
+ *
+ * A remote relinquish updates both fields UNDER the descriptor lock
+ * (push the frame bytes, clear fp_home, release fp_state=EAGER), while an
+ * arm publishes them in the opposite order without this lock. Reading the
+ * pair locklessly could therefore observe a torn intermediate state
+ * (fp_state=LIVE with fp_home already NULL) on a weakly ordered host; acting
+ * on that snapshot with an unlocked EAGER store could also let a reader use
+ * regs->fp before the remote push is visible.
+ *
+ * Taking the descriptor lock pairs with the remote release: when EAGER is
+ * observed here, the relinquish's frame->fp memcpy has completed. Returns
+ * true when the descriptor is LIVE (with a home captured coherently).
+ */
+static bool fp_read_coherent(struct uml_pt_regs *regs, struct mm_id **home)
+{
+	bool live;
+
+	desc_lock(regs);
+	live = smp_load_acquire(&regs->fp_state) == UML_FP_LIVE;
+	*home = live ? READ_ONCE(regs->fp_home) : NULL;
+	desc_unlock(regs);
+	return live;
+}
+
+/*
+ * Resolve the current task's own image before frame on runner is written.
+ * Returns 1 when the frame must be left untouched (fast path), 0 when
+ * regs->fp is ready to copy, -EINVAL on protocol corruption.
+ *
+ * Every decision is made while holding the descriptor lock plus, when a home
+ * exists, the home handoff lock (handoff -> descriptor order): the lockless
+ * fp_home hint alone could be observed torn against a remote relinquish. On
+ * clear *put receives the strong reference the slot held; the caller drops
+ * it via fp_put_task() after unlocking.
+ */
+static int fp_resolve_self(struct uml_pt_regs *regs, struct mm_id *runner,
+			   void *frame, struct task_struct **put)
+{
+	struct um_fp_handoff *handoff;
+	struct mm_id *home;
+	unsigned long flags;
+
+	*put = NULL;
+
+	/* Coherent snapshot: EAGER here includes a completed remote push. */
+	if (!fp_read_coherent(regs, &home))
+		return 0;
+	if (WARN_ONCE(!home,
+		      "lazy xstate: live state without a home runner\n"))
+		return -EINVAL;
+
+	handoff = &home->fp_handoff;
+	handoff_lock(handoff, &flags);
+	desc_lock(regs);
+	if (smp_load_acquire(&regs->fp_state) != UML_FP_LIVE) {
+		/*
+		 * A remote runner pushed the image into regs->fp between the
+		 * coherent snapshot and locking the slot; the descriptor
+		 * release pairs with that copy.
+		 */
+		desc_unlock(regs);
+		handoff_unlock(handoff, flags);
+		return 0;
+	}
+	if (WARN_ONCE(!fp_regs_is_task(regs, handoff->owner) ||
+		      regs->fp_token != handoff->token,
+		      "lazy xstate: live state without frame owner\n")) {
+		desc_unlock(regs);
+		handoff_unlock(handoff, flags);
+		return -EINVAL;
+	}
+	if (home == runner && regs->fp_frame == frame) {
+		/* Fast path: host reloads its own saved frame. */
+		handoff->owner = NULL;
+		regs->fp_home = NULL;
+		smp_store_release(&regs->fp_state, UML_FP_EAGER);
+		*put = current;
+		desc_unlock(regs);
+		handoff_unlock(handoff, flags);
+		return 1;
+	}
+	/* Cross-CPU migration or a moved nested frame slot. */
+	memcpy(regs->fp, regs->fp_frame, regs->fp_size);
+	handoff->owner = NULL;
+	regs->fp_home = NULL;
+	smp_store_release(&regs->fp_state, UML_FP_EAGER);
+	*put = current;
+	desc_unlock(regs);
+	handoff_unlock(handoff, flags);
+	return 0;
+}
+
+int uml_fp_leave(struct uml_pt_regs *regs, struct mm_id *runner,
+		 void *frame, unsigned int size)
+{
+	struct um_fp_handoff *handoff;
+	struct task_struct *put_home, *put_owner;
+	struct uml_pt_regs *owner_regs;
+	unsigned long flags;
+	int lazy;
+
+	if (!uml_lazy_xstate)
+		return 0;
+
+	put_home = put_owner = NULL;
+	lazy = fp_resolve_self(regs, runner, frame, &put_home);
+	if (lazy < 0)
+		return lazy;
+
+	/*
+	 * Preserve a previous owner of the frame we are about to overwrite:
+	 * push its image into that owner's own regs->fp buffer. The slot's
+	 * strong reference guarantees that owner storage is valid here; this
+	 * is also how an exited-but-retained owner is released.
+	 */
+	handoff = &runner->fp_handoff;
+	handoff_lock(handoff, &flags);
+	if (lazy == 1) {
+		/*
+		 * Fast path: this slot was this task's home and is already
+		 * cleared; one arm/leave round per runner guarantees no
+		 * foreign owner. Leave the frame bytes for rt_sigreturn.
+		 */
+		if (WARN_ONCE(handoff->owner != NULL,
+			      "lazy xstate: fast path with a foreign owner\n")) {
+			put_owner = handoff->owner;
+			handoff->owner = NULL;
+		}
+		handoff_unlock(handoff, flags);
+		fp_put_task(put_home);
+		fp_put_task(put_owner);
+		return 1;
+	}
+
+	if (fp_regs_is_task(regs, handoff->owner)) {
+		/* Live on this runner but a different frame slot (nested
+		 * signal); the image was collected above. */
+		put_owner = handoff->owner;
+		handoff->owner = NULL;
+	} else if (handoff->owner) {
+		struct task_struct *owner = handoff->owner;
+
+		owner_regs = &owner->thread.regs.regs;
+		desc_lock(owner_regs);
+		if (smp_load_acquire(&owner_regs->fp_state) == UML_FP_LIVE &&
+		    owner_regs->fp_home == runner &&
+		    owner_regs->fp_token == handoff->token &&
+		    owner_regs->fp_frame == frame) {
+			memcpy(owner_regs->fp, frame, owner_regs->fp_size);
+			owner_regs->fp_home = NULL;
+			smp_store_release(&owner_regs->fp_state, UML_FP_EAGER);
+		} else {
+			/* Stale record (cannot happen by construction). */
+			WARN_ONCE(1, "lazy xstate: stale frame owner\n");
+		}
+		put_owner = owner;
+		handoff->owner = NULL;
+		desc_unlock(owner_regs);
+	}
+	/*
+	 * Publish this task's image into the frame OURSELVES, under the
+	 * handoff lock. Returning 0 here would make set_stub_state_core copy
+	 * the full XSTATE a second time after unlock; returning 1 tells the
+	 * caller the frame is final and it must not copy.
+	 */
+	memcpy(frame, regs->fp, size);
+	handoff_unlock(handoff, flags);
+
+	/* Process context, locks released, IRQs enabled: safe final puts. */
+	fp_put_task(put_home);
+	fp_put_task(put_owner);
+	return 1;
+}
+
+/* ---- genuine FP consumers ---------------------------------------------- */
+
+void uml_fp_materialize(struct uml_pt_regs *regs)
+{
+	struct um_fp_handoff *handoff;
+	struct mm_id *home;
+	struct task_struct *put = NULL;
+	unsigned long flags;
+
+	/* Coherent snapshot; pairs with a remote relinquish's release. */
+	if (!fp_read_coherent(regs, &home))
+		return;
+	if (WARN_ONCE(!home,
+		      "lazy xstate: live state without a home runner\n"))
+		return;
+
+	handoff = &home->fp_handoff;
+	handoff_lock(handoff, &flags);
+	desc_lock(regs);
+	if (smp_load_acquire(&regs->fp_state) == UML_FP_LIVE) {
+		struct task_struct *owner = handoff->owner;
+
+		if (fp_regs_is_task(regs, owner) &&
+		    regs->fp_token == handoff->token) {
+			memcpy(regs->fp, regs->fp_frame, regs->fp_size);
+		} else {
+			/*
+			 * Live descriptor claiming a slot owned by another
+			 * task is a protocol violation; the slot reference
+			 * is still released with the clear below.
+			 */
+			WARN_ONCE(1, "lazy xstate: live state without frame owner\n");
+		}
+		handoff->owner = NULL;
+		regs->fp_home = NULL;
+		smp_store_release(&regs->fp_state, UML_FP_EAGER);
+		put = owner;
+	}
+	desc_unlock(regs);
+	handoff_unlock(handoff, flags);
+	fp_put_task(put);
+}
+
+void uml_fp_discard(struct uml_pt_regs *regs)
+{
+	struct um_fp_handoff *handoff;
+	struct mm_id *home;
+	struct task_struct *put = NULL;
+	unsigned long flags;
+
+	/* Coherent snapshot; pairs with a remote relinquish's release. */
+	if (!fp_read_coherent(regs, &home))
+		return;
+	if (WARN_ONCE(!home,
+		      "lazy xstate: discard of live state without a home\n"))
+		return;
+
+	handoff = &home->fp_handoff;
+	handoff_lock(handoff, &flags);
+	desc_lock(regs);
+	if (smp_load_acquire(&regs->fp_state) == UML_FP_LIVE) {
+		put = handoff->owner;
+		if (!fp_regs_is_task(regs, put))
+			WARN_ONCE(1, "lazy xstate: discard with foreign slot owner\n");
+		handoff->owner = NULL;
+		/* The caller overwrites fp[] wholesale. */
+		regs->fp_home = NULL;
+		smp_store_release(&regs->fp_state, UML_FP_EAGER);
+	}
+	desc_unlock(regs);
+	handoff_unlock(handoff, flags);
+	fp_put_task(put);
+}
+
+/* ---- lifetime ----------------------------------------------------------- */
+
+void uml_fp_reset(struct uml_pt_regs *regs)
+{
+	/*
+	 * New tasks (fork child, kernel thread) start EAGER and never inherit
+	 * a runner slot; no strong reference is released here.
+	 */
+	regs->fp_home = NULL;
+	regs->fp_frame = NULL;
+	regs->fp_size = 0;
+	regs->fp_token = 0;
+	WRITE_ONCE(regs->fp_lock, 0);
+	smp_store_release(&regs->fp_state, UML_FP_EAGER);
+}
+
+void uml_fp_handoff_reset(struct mm_id *runner)
+{
+	struct um_fp_handoff *handoff = &runner->fp_handoff;
+	struct task_struct *put;
+	struct uml_pt_regs *owner_regs;
+	unsigned long flags;
+
+	/*
+	 * mm destruction (broker, every cpu_ids[] slot and the GPU worker)
+	 * and broker-cache recycling. Runs in process context when no guest
+	 * task can be mid-round on the runner (mm teardown holds mm_users at
+	 * zero; cache recycling parks the broker). Clear the owner
+	 * descriptor while its storage is pinned by the slot reference, then
+	 * release that reference after unlocking.
+	 */
+	handoff_lock(handoff, &flags);
+	put = handoff->owner;
+	handoff->owner = NULL;
+	handoff->token = 0;
+	if (put) {
+		owner_regs = &put->thread.regs.regs;
+		desc_lock(owner_regs);
+		owner_regs->fp_home = NULL;
+		smp_store_release(&owner_regs->fp_state, UML_FP_EAGER);
+		desc_unlock(owner_regs);
+	}
+	handoff_unlock(handoff, flags);
+	fp_put_task(put);
+}
+
+static int __init uml_lazy_xstate_setup(char *line, int *add)
+{
+	*add = 0;
+	if (!strcmp(line, "0")) {
+		uml_lazy_xstate = 0;
+		return 0;
+	}
+	if (!strcmp(line, "1")) {
+		uml_lazy_xstate = 1;
+		return 0;
+	}
+	panic("Invalid lazyxstate value, expected 0 or 1\n");
+}
+__uml_setup("lazyxstate=", uml_lazy_xstate_setup,
+"lazyxstate=<0|1>\n"
+"    Keep guest XSTATE in the parked SECCOMP signal frame until a real\n"
+"    consumer (guest signal, ptrace/coredump, fork, exec) needs it.\n"
+"    Experimental, default 0, x86_64 only. Validate with the FP lifecycle\n"
+"    regression probes and the parallel-runner/GPU kernels.\n"
+);
+
+#else /* !__x86_64__ */
+
+/*
+ * i386 converts the legacy i387 image on every transition; keep the eager
+ * copies and provide no-op bookkeeping. Slots never hold references. The
+ * handoff record is still embedded in mm_id for layout; ILP32 packs it to
+ * 16 bytes (pointer 4 + token 8 + lock 4).
+ */
+static_assert(sizeof(struct um_fp_handoff) == 16);
+int uml_fp_enter(struct uml_pt_regs *regs, struct mm_id *runner,
+		 void *frame, unsigned int size)
+{
+	uml_fp_reset(regs);
+	memcpy(regs->fp, frame, size);
+	return 0;
+}
+
+int uml_fp_leave(struct uml_pt_regs *regs, struct mm_id *runner,
+		 void *frame, unsigned int size)
+{
+	return 0;
+}
+
+void uml_fp_materialize(struct uml_pt_regs *regs)
+{
+}
+
+void uml_fp_discard(struct uml_pt_regs *regs)
+{
+}
+
+void uml_fp_reset(struct uml_pt_regs *regs)
+{
+	regs->fp_home = NULL;
+	regs->fp_frame = NULL;
+	regs->fp_size = 0;
+	regs->fp_token = 0;
+	WRITE_ONCE(regs->fp_lock, 0);
+	smp_store_release(&regs->fp_state, UML_FP_EAGER);
+}
+
+void uml_fp_handoff_reset(struct mm_id *runner)
+{
+	runner->fp_handoff.owner = NULL;
+	runner->fp_handoff.token = 0;
+	runner->fp_handoff.lock = 0;
+}
+
+#endif
