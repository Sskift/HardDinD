+#[cfg(test)]
+mod harddind_tests {
+    use super::*;
+
+    fn header_with(len: u32) -> InHeader {
+        InHeader {
+            len,
+            ..Default::default()
+        }
+    }
+
+    fn lk(type_: u32, start: u64, end: u64, flags: u32) -> LkIn {
+        LkIn {
+            fh: 9,
+            owner: 0x1234_5678_9abc_def0,
+            lk: FileLock {
+                start,
+                end,
+                type_,
+                pid: 42,
+            },
+            lk_flags: flags,
+            padding: 0,
+        }
+    }
+
+#[test]
+    fn harddind_parse_posix_lock_inclusive_ends_and_boundaries() {
+        let len = (size_of::<InHeader>() + size_of::<LkIn>()) as u32;
+        let decode = |start, end| {
+            harddind_parse_posix_lock(header_with(len), &lk(libc::F_WRLCK as u32, start, end, 0))
+                .map(|(_, _, pid, parsed)| (pid, parsed.start, parsed.len, PosixLock::end_of(parsed)))
+        };
+
+        // Basic inclusive range: bytes 10..=73 -> length 64.
+        assert_eq!(decode(10, 73).unwrap(), (42, 10, 64, 73));
+
+        // end == 0 at start 0 is ONE BYTE, never whole-file.
+        assert_eq!(decode(0, 0).unwrap(), (42, 0, 1, 0));
+        // A nonzero start with end 0 is invalid (inverted single byte).
+        assert_eq!(decode(1, 0).unwrap_err().raw_os_error(), Some(libc::EINVAL));
+
+        // Exact single byte at a nonzero offset and adjacent pairs.
+        assert_eq!(decode(64, 64).unwrap(), (42, 64, 1, 64));
+        assert_eq!(decode(63, 64).unwrap(), (42, 63, 2, 64));
+
+        // OFFSET_MAX (2^63 - 1, NOT 2^62 - 1) is the unbounded end; host l_len 0.
+        assert_eq!(decode(0, PosixLock::EOF).unwrap(),
+                   (42, 0, 0, PosixLock::EOF));
+        assert_eq!(decode(1 << 62, PosixLock::EOF).unwrap(),
+                   (42, 1 << 62, 0, PosixLock::EOF));
+        // Values above the old 2^62 bound must now be accepted as bounded locks.
+        assert_eq!(decode(1 << 62, (1 << 62) + 63).unwrap(),
+                   (42, 1 << 62, 64, (1 << 62) + 63));
+        // The final byte at OFFSET_MAX is wire-identical to an unbounded lock
+        // starting there: both encode end=OFFSET_MAX and cover exactly that
+        // one byte (l_len 0 and l_len 1 at i64::MAX are the same range).
+        assert_eq!(decode(PosixLock::EOF, PosixLock::EOF).unwrap(),
+                   (42, PosixLock::EOF, 0, PosixLock::EOF));
+
+        // Inverted, above-OFFSET_MAX and truncated requests fail.
+        assert_eq!(decode(64, 63).unwrap_err().raw_os_error(), Some(libc::EINVAL));
+        assert_eq!(decode(0, PosixLock::EOF + 1).unwrap_err().raw_os_error(),
+                   Some(libc::EINVAL));
+        assert_eq!(decode(0, u64::MAX).unwrap_err().raw_os_error(),
+                   Some(libc::EINVAL));
+        assert_eq!(
+            harddind_parse_posix_lock(header_with(len), &lk(libc::F_WRLCK as u32, 0, 0, LK_FLOCK))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            harddind_parse_posix_lock(header_with(len), &lk(99, 0, 0, 0))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINVAL)
+        );
+        assert!(harddind_parse_posix_lock(header_with(len - 1),
+                &lk(libc::F_WRLCK as u32, 0, 0, 0)).is_err());
+        // Unlock of the single zero byte is valid for FUSE_SETLK; GETLK forbids F_UNLCK
+        // one layer up.
+        assert!(harddind_parse_posix_lock(header_with(len),
+                &lk(libc::F_UNLCK as u32, 0, 0, 0)).is_ok());
+        // The sender pid is carried through unchanged for later GETLK attribution.
+        assert_eq!(decode(5, 5).unwrap().0, 42);
+    }
