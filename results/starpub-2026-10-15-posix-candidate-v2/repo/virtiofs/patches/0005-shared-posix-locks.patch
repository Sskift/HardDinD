+    // Traditional host-process fcntl against the exported path.
+    fn harddind_host_fcntl(path: &std::path::Path, cmd: i32, type_: i16, start: i64, len: i64)
+        -> (i32, Option<i32>) {
+        let file = std::fs::OpenOptions::new().read(true).write(true).open(path).unwrap();
+        let mut lock = libc::flock {
+            l_type: type_,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        if cmd == libc::F_GETLK {
+            (
+                rc,
+                Some(lock.l_pid),
+            )
+        } else if rc < 0 {
+            (rc, io::Error::last_os_error().raw_os_error())
+        } else {
+            (rc, Some(0))
+        }
+    }
+
