+impl PosixLock {
+    /// Inclusive end used by the FUSE wire format for an unbounded range.
+    ///
+    /// The client (Linux `flock64_to_posix_lock`) sets `fl_end = OFFSET_MAX`,
+    /// where `OFFSET_MAX` is `type_max(loff_t)` = `2^63 - 1`, for `l_len == 0`
+    /// locks ("through end of file").  Must match the guest value exactly.
+    pub const EOF: u64 = i64::MAX as u64;
+
+    /// Inclusive end used by the FUSE wire format for this range.
+    pub fn end_of(lk: PosixLock) -> u64 {
+        if lk.len == 0 {
+            PosixLock::EOF
+        } else {
+            lk.start + lk.len - 1
+        }
+    }
+}
