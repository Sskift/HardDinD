+        assert_eq!(holder.start, 256);
+        assert_eq!(holder.end, 319);
+        assert_eq!(holder.pid, std::process::id() as u32);
+        drop(host);
+
+        // Explicit unlock releases only the requested owner range.
+        fs.setlk(ctx, inode, handle, a, harddind_plock(libc::F_UNLCK, 0, 64))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 0, 64),
+            (0, Some(0))
+        );
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 64, 64),
+            (-1, Some(libc::EAGAIN))
+        );
+
+        // Any close (FLUSH) releases all of that owner's locks on the inode,
+        // including its read lock and locks it held on ranges taken elsewhere.
+        fs.flush(ctx, inode, handle, b).unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 64, 128),
+            (0, Some(0))
+        );
+
+        // To-EOF lock (len 0) blocks a writer far past EOF and round-trips via GETLK.
+        fs.setlk(ctx, inode, handle, a, harddind_plock(libc::F_WRLCK, 1000, 0))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 5000, 1),
+            (-1, Some(libc::EAGAIN))
+        );
+        let (_, far_pid) =
+            harddind_host_fcntl(&path, libc::F_GETLK, libc::F_WRLCK as i16, 5000, 1);
+        assert_eq!(far_pid, Some(-1));
+        fs.setlk(ctx, inode, handle, a, harddind_plock(libc::F_UNLCK, 1000, 0))
+            .unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 5000, 1),
+            (0, Some(0))
+        );
+        std::fs::remove_dir_all(base).unwrap();
+    }
+
+    #[test]
+    fn harddind_posix_locks_multi_open_rename_unlink_and_retry_grant() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-life-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("life");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        let inode = fs.do_lookup(1, &CString::new("life").unwrap()).unwrap().inode;
+        let handle1 = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let handle2 = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+
+        // Two guest opens by one owner share the owner fd: the second lock does
+        // not conflict, and FLUSH on either open releases the owner's locks.
+        let owner = 0x2001u64;
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_WRLCK, 10, 10))
+            .unwrap();
+        fs.setlk(ctx, inode, handle2, owner, harddind_plock(libc::F_WRLCK, 10, 10))
+            .unwrap();
+        fs.flush(ctx, inode, handle1, owner).unwrap();
+        assert_eq!(
+            harddind_host_fcntl(&path, libc::F_SETLK, libc::F_WRLCK as i16, 10, 10),
+            (0, Some(0))
+        );
+
+        // The retry worker's nonblocking poll sees EAGAIN then grants after unlock.
+        let other = 0x2002u64;
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        assert_eq!(
+            fs.setlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EAGAIN)
+        );
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_UNLCK, 0, 64))
+            .unwrap();
+        fs.setlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        fs.flush(ctx, inode, handle2, other).unwrap();
+
+        // Inode identity follows rename and unlink; locks keep working on the
+        // same nodeid and are releasable after the name disappears.
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_WRLCK, 0, 64))
+            .unwrap();
+        std::fs::rename(&path, base.join("life-moved")).unwrap();
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_WRLCK, 64, 64))
+            .unwrap();
+        let found = fs
+            .getlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!(found.type_ as i32, libc::F_WRLCK);
+        std::fs::remove_file(base.join("life-moved")).unwrap();
+        fs.setlk(ctx, inode, handle1, owner, harddind_plock(libc::F_WRLCK, 128, 64))
+            .unwrap();
+        // `other`'s owner fd was flushed earlier, so GETLK lazily reopens the
+        // inode through /proc/self/fd even though the last name is gone.
+        let unlinked = fs
+            .getlk(ctx, inode, handle2, other, harddind_plock(libc::F_WRLCK, 0, 4096))
+            .unwrap();
+        assert_eq!(unlinked.type_ as i32, libc::F_WRLCK);
+        fs.flush(ctx, inode, handle1, owner).unwrap();
+        fs.flush(ctx, inode, handle2, other).unwrap();
+        std::fs::remove_dir_all(base).unwrap();
+    }
+
+    // Raw host fcntl with explicit signed offsets; mirrors what the FUSE
+    // wire's inclusive start/end is translated into.
+    fn harddind_host_fcntl64(
+        path: &std::path::Path,
+        cmd: i32,
+        type_: i32,
+        start: i64,
+        len: i64,
+    ) -> (i32, Option<i32>) {
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(path)
+            .unwrap();
+        let mut lock = libc::flock64 {
+            l_type: type_ as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        let error = if rc < 0 {
+            io::Error::last_os_error().raw_os_error()
+        } else {
+            None
+        };
+        (rc, error)
+    }
+
+    #[test]
+    fn harddind_posix_one_byte_adjacent_large_offsets_and_eof() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-byte-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("lock");
+        std::fs::write(&path, vec![0u8; 4096]).unwrap();
+        let fs = harddind_posix_fs(&base);
+        let name = CString::new("lock").unwrap();
+        let inode = fs.do_lookup(1, &name).unwrap().inode;
+        let handle = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        const W: i32 = libc::F_WRLCK;
+        let eof = PosixLock::EOF;
+        assert_eq!(eof, i64::MAX as u64);
+
+        // Single byte at zero: FUSE start=0,end=0. Byte 0 is held, byte 1 is free.
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(W, 0, 1)).unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 0, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 1, 1), (0, None));
+        let one = fs
+            .getlk(ctx, inode, handle, 0x3002, harddind_plock(W, 0, 1))
+            .unwrap();
+        assert_eq!((one.type_ as i32, one.start, one.end, one.pid),
+                   (W, 0, 0, u32::MAX));
+        // Unlock of exactly the single byte releases it and nothing else.
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(libc::F_UNLCK, 0, 1))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 0, 1), (0, None));
+
+        // Nonzero single byte with adjacent exclusion on both sides.
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(W, 100, 1))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 100, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 99, 1), (0, None));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 101, 1), (0, None));
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(libc::F_UNLCK, 100, 1))
+            .unwrap();
+
+        // Above the old wrong 2^62 bound: bounded locks and the final loff_t byte.
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(W, 1u64 << 62, 8))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, 1i64 << 62, 8),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, (1i64 << 62) - 1, 1),
+                   (0, None));
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(libc::F_UNLCK, 1u64 << 62, 8))
+            .unwrap();
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(W, eof, 1)).unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX - 1, 1),
+                   (0, None));
+
+        // Unbounded range from 2^62: GETLK across the whole space reports it
+        // with host l_len 0 -> FUSE end OFFSET_MAX, and last-byte conflict.
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(W, 1u64 << 62, 0))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (-1, Some(libc::EAGAIN)));
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, (1i64 << 62) - 1, 1),
+                   (0, None));
+        let tail = fs
+            .getlk(ctx, inode, handle, 0x3002, harddind_plock(W, 0, 0))
+            .unwrap();
+        assert_eq!((tail.type_ as i32, tail.start, tail.end),
+                   (W, 1u64 << 62, PosixLock::EOF));
+        fs.setlk(ctx, inode, handle, 0x3001, harddind_plock(libc::F_UNLCK, 1u64 << 62, 0))
+            .unwrap();
+        assert_eq!(harddind_host_fcntl64(&path, libc::F_SETLK, W, i64::MAX, 1),
+                   (0, None));
+        std::fs::remove_dir_all(base).unwrap();
+    }
+
+    #[test]
+    fn harddind_posix_locks_require_negotiation_and_refuse_when_disabled() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-off-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        std::fs::write(base.join("f"), b"x").unwrap();
+        // Enabled in configuration but the client lacks POSIX_LOCKS: hard error
+        // instead of a silent fallback to local locking.
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(),
+            shared_posix_locks: true,
+            inode_file_handles: InodeFileHandlesMode::Never,
+            ..Default::default()
+        })
+        .unwrap();
+        assert_eq!(
+            fs.init(FsOptions::FLOCK_LOCKS)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EPROTO)
+        );
+        // Feature off: ENOSYS from the fs methods even with a capable client.
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(),
+            inode_file_handles: InodeFileHandlesMode::Never,
+            ..Default::default()
+        })
+        .unwrap();
+        fs.init(FsOptions::POSIX_LOCKS).unwrap();
+        let inode = fs.do_lookup(1, &CString::new("f").unwrap()).unwrap().inode;
+        let handle = fs.do_open(inode, false, libc::O_RDWR as u32).unwrap().0.unwrap();
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: std::process::id() as i32,
+        };
+        assert_eq!(
+            fs.setlk(ctx, inode, handle, 1, harddind_plock(libc::F_WRLCK, 0, 64))
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        std::fs::remove_dir_all(base).unwrap();
+    }
