+    // Build a passthrough fs rooted at a unique temp dir with shared POSIX locks.
+    fn harddind_posix_fs(base: &std::path::Path) -> PassthroughFs {
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(),
+            shared_flock: true,
+            shared_posix_locks: true,
