+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+
+//! Per-guest-owner host file descriptors for POSIX byte-range locks.
+//!
+//! Linux POSIX record locks (`fcntl(2)` `F_SETLK`) are owned by the process's
+//! `struct files_struct`.  The FUSE protocol identifies that owner with the
+//! per-mount scrambled 64-bit value carried in `fuse_lk_in::owner` and
+//! `fuse_flush_in::lock_owner`; threads and `dup(2)` share it, `fork(2)`
+//! without `CLONE_FILES` produces a new one.
+//!
+//! Traditional host locks cannot distinguish between guest owners because all
+//! requests run in one virtiofsd process.  Per-open `F_OFD_SETLK` is not
+//! sufficient either: two opens by the same guest process would then conflict
+//! with each other, while locks taken through one fd would survive the close
+//! of another fd (both contradict POSIX semantics).  Instead this table keeps
+//! exactly one host open file description per `(inode, owner)` and issues all
+//! of that owner's lock operations with `F_OFD_SETLK`/`F_OFD_GETLK` on it:
+//!
+//! * different owners use different fds, so their locks conflict on the host
+//!   exactly like locks of independent host processes, in both directions
+//!   with host-native POSIX locks;
+//! * repeated operations on the owner's fd reproduce one owner's split/merge
+//!   behavior and never conflict with the owner itself;
+//! * `FLUSH` is sent by the guest for every `close(2)`, and POSIX semantics
+//!   release all of that owner's record locks on the inode on any close, so
+//!   `flush_owner` simply removes and closes the fd.
+//!
+//! All fcntl operations issued through this module are nonblocking.  Blocking
+//! `F_SETLKW` requests are retried by the asynchronous lock wait queue.
+
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::io;
+use std::sync::{Arc, Mutex, MutexGuard};
+
+use super::inode_store::Inode;
+
+pub(super) struct InodeLockSet {
+    /// Held across the nonblocking fcntl and owner-table updates, never across
+    /// a blocking wait.  Orders lock attempts against `FLUSH`/forget teardown
+    /// for this inode so a granted lock cannot outlive the fd close that was
+    /// supposed to release it.
+    serialize: Arc<Mutex<()>>,
+
+    owners: Mutex<BTreeMap<u64, Arc<File>>>,
+}
+
+impl InodeLockSet {
+    fn new() -> Self {
+        InodeLockSet {
+            serialize: Arc::new(Mutex::new(())),
+            owners: Mutex::new(BTreeMap::new()),
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct PosixLockTable {
+    inodes: Mutex<BTreeMap<Inode, Arc<InodeLockSet>>>,
+}
+
+impl PosixLockTable {
+    pub(super) fn new() -> Self {
+        PosixLockTable::default()
+    }
+
+    /// Run `op` against the shared host fd carrying `owner`'s locks on
+    /// `inode`, creating that fd lazily with `open`.  The inode's teardown
+    /// lock is held for the duration of `op`, so FLUSH/forget cannot close the
+    /// fd while the nonblocking fcntl is in flight.
+    pub(super) fn with_owner_file<OpenFn, R>(
+        &self,
+        inode: Inode,
+        owner: u64,
+        open: OpenFn,
+        op: impl FnOnce(&File) -> io::Result<R>,
+    ) -> io::Result<R>
+    where
+        OpenFn: FnOnce() -> io::Result<File>,
+    {
+        let set = {
+            let mut inodes = self.inodes.lock().unwrap();
+            Arc::clone(
+                inodes
+                    .entry(inode)
+                    .or_insert_with(|| Arc::new(InodeLockSet::new())),
+            )
+        };
+        // Acquired before touching `owners`, so no lock can be granted on an fd
+        // while a concurrent FLUSH is closing it.
+        let _guard: MutexGuard<'_, ()> = set.serialize.lock().unwrap();
+        let file = {
+            let mut owners = set.owners.lock().unwrap();
+            if let Some(file) = owners.get(&owner) {
+                Arc::clone(file)
+            } else {
+                // The open goes through /proc/self/fd and must not hold table
+                // locks; insert on return. FLUSH cannot run while `_guard` is
+                // held, so the slot cannot have been removed in between.
+                drop(owners);
+                let opened = Arc::new(open()?);
+                let mut owners = set.owners.lock().unwrap();
+                Arc::clone(owners.entry(owner).or_insert(opened))
+            }
+        };
+        op(&file)
+    }
+
+    /// Close the fd carrying all host representation of `owner`'s locks on
+    /// `inode`; called from FUSE FLUSH.  A no-op when the owner never locked.
+    pub(super) fn flush_owner(&self, inode: Inode, owner: u64) {
+        let set = match self.inodes.lock().unwrap().get(&inode) {
+            Some(set) => Arc::clone(set),
+            None => return,
+        };
+        let _guard = set.serialize.lock().unwrap();
+        // Dropping the last Arc closes the fd and releases every OFD lock held
+        // through it.  Outstanding borrows delay only the close.
+        set.owners.lock().unwrap().remove(&owner);
+    }
+
+    /// Drop all owner fds for an inode when the guest forgets it.  Operations
+    /// already in flight keep the `InodeLockSet` alive until they complete.
+    pub(super) fn forget_inode(&self, inode: Inode) {
+        self.inodes.lock().unwrap().remove(&inode);
+    }
+
+    /// Release every lock tracked by the table (DESTROY / re-init).
+    pub(super) fn clear(&self) {
+        self.inodes.lock().unwrap().clear();
+    }
+}
+
+#[cfg(test)]
+mod harddind_tests {
+    use super::*;
+    use std::os::unix::io::AsRawFd;
+
+    fn ofd(file: &File, cmd: i32, type_: i32, start: i64, len: i64) -> (i32, Option<i32>) {
+        let mut lock = libc::flock {
+            l_type: type_ as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        let error = if rc < 0 {
+            io::Error::last_os_error().raw_os_error()
+        } else {
+            None
+        };
+        (rc, error)
+    }
+
+    fn posix(file: &File, cmd: i32, type_: i32, start: i64, len: i64) -> (i32, Option<i32>) {
+        let mut lock = libc::flock {
+            l_type: type_ as i16,
+            l_whence: libc::SEEK_SET as i16,
+            l_start: start,
+            l_len: len,
+            l_pid: 0,
+        };
+        let rc = unsafe { libc::fcntl(file.as_raw_fd(), cmd, &mut lock) };
+        let error = if rc < 0 {
+            io::Error::last_os_error().raw_os_error()
+        } else {
+            None
+        };
+        (rc, error)
+    }
+
+    #[test]
+    fn harddind_posix_table_owner_isolation_flush_and_forget() {
+        let base = std::env::temp_dir().join(format!("virtiofs-posix-table-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let path = base.join("locks");
+        std::fs::write(&path, b"data").unwrap();
+
+        let table = PosixLockTable::new();
+        let opener = || File::options().read(true).write(true).open(&path);
+
+        // Owner A takes a write lock; distinct owner B must be refused.
+        table
+            .with_owner_file(7, 0x1111, opener, |f| {
+                assert_eq!(ofd(f, libc::F_OFD_SETLK, libc::F_WRLCK, 0, 64).0, 0);
+                io::Result::Ok(())
+            })
+            .unwrap();
+        table
+            .with_owner_file(7, 0x2222, opener, |f| {
+                assert_eq!(ofd(f, libc::F_OFD_SETLK, libc::F_WRLCK, 0, 64),
+                           (-1, Some(libc::EAGAIN)));
+                // B may lock a disjoint range on its own fd.
+                assert_eq!(ofd(f, libc::F_OFD_SETLK, libc::F_WRLCK, 64, 64).0, 0);
+                io::Result::Ok(())
+            })
+            .unwrap();
+
+        // FLUSH for A closes A's fd, releasing A's range; B's survives.
+        table.flush_owner(7, 0x1111);
+        let host = File::options().read(true).write(true).open(&path).unwrap();
+        assert_eq!(posix(&host, libc::F_SETLK, libc::F_WRLCK, 0, 64), (0, None));
+        assert_eq!(posix(&host, libc::F_SETLK, libc::F_WRLCK, 64, 64), (-1, Some(libc::EAGAIN)));
+        assert_eq!(posix(&host, libc::F_SETLK, libc::F_UNLCK, 0, 64), (0, None));
+        // Recreated A fd behaves as a fresh owner after FLUSH.
+        table
+            .with_owner_file(7, 0x1111, opener, |f| {
+                assert_eq!(ofd(f, libc::F_OFD_SETLK, libc::F_WRLCK, 0, 64).0, 0);
+                io::Result::Ok(())
+            })
+            .unwrap();
+
+        // Forget closes the inode's remaining fds (A re-acquired and B's).
+        table.forget_inode(7);
+        assert_eq!(posix(&host, libc::F_SETLK, libc::F_WRLCK, 0, 64), (0, None));
+        assert_eq!(posix(&host, libc::F_SETLK, libc::F_WRLCK, 64, 64), (0, None));
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
