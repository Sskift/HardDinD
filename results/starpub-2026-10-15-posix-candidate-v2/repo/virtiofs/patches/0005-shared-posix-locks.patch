+/// Normalized POSIX byte-range lock request.
+///
+/// Both offsets are absolute (`SEEK_SET`); the FUSE client resolves `SEEK_CUR`
+/// and `SEEK_END` (including signed deltas) before sending the request, and
+/// rejects negative results itself.  `len == 0` means "through end of file".
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub struct PosixLock {
+    /// One of `libc::F_RDLCK`, `libc::F_WRLCK`, `libc::F_UNLCK`.
+    pub lk_type: u32,
+    pub start: u64,
+    pub len: u64,
