      "#if BITS_PER_LONG==32",
      "#define MAX_LFS_FILESIZE\t((loff_t)ULONG_MAX << PAGE_SHIFT)",
      "#elif BITS_PER_LONG==64",
      "#define MAX_LFS_FILESIZE \t((loff_t)LLONG_MAX)",
      "#endif",
      "",
