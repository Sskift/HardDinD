  "fs/fuse/file.c": {
    "sha256": "1893208ecbe5e64fd7adf91aabcc37e5669fef66031877fed36acdd41f04752a",
    "start": 2458,
    "end": 2514,
    "lines": [
      "static int convert_fuse_file_lock(struct fuse_conn *fc,",
      "\t\t\t\t  const struct fuse_file_lock *ffl,",
      "\t\t\t\t  struct file_lock *fl)",
      "{",
      "\tswitch (ffl->type) {",
      "\tcase F_UNLCK:",
      "\t\tbreak;",
      "",
      "\tcase F_RDLCK:",
      "\tcase F_WRLCK:",
      "\t\tif (ffl->start > OFFSET_MAX || ffl->end > OFFSET_MAX ||",
      "\t\t    ffl->end < ffl->start)",
      "\t\t\treturn -EIO;",
      "",
      "\t\tfl->fl_start = ffl->start;",
      "\t\tfl->fl_end = ffl->end;",
      "",
      "\t\t/*",
      "\t\t * Convert pid into init's pid namespace.  The locks API will",
      "\t\t * translate it into the caller's pid namespace.",
      "\t\t */",
      "\t\trcu_read_lock();",
      "\t\tfl->c.flc_pid = pid_nr_ns(find_pid_ns(ffl->pid, fc->pid_ns), &init_pid_ns);",
      "\t\trcu_read_unlock();",
      "\t\tbreak;",
      "",
      "\tdefault:",
      "\t\treturn -EIO;",
      "\t}",
      "\tfl->c.flc_type = ffl->type;",
      "\treturn 0;",
      "}",
      "",
      "static void fuse_lk_fill(struct fuse_args *args, struct file *file,",
      "\t\t\t const struct file_lock *fl, int opcode, pid_t pid,",
      "\t\t\t int flock, struct fuse_lk_in *inarg)",
      "{",
      "\tstruct inode *inode = file_inode(file);",
      "\tstruct fuse_conn *fc = get_fuse_conn(inode);",
      "\tstruct fuse_file *ff = file->private_data;",
      "",
      "\tmemset(inarg, 0, sizeof(*inarg));",
      "\tinarg->fh = ff->fh;",
      "\tinarg->owner = fuse_lock_owner_id(fc, fl->c.flc_owner);",
      "\tinarg->lk.start = fl->fl_start;",
      "\tinarg->lk.end = fl->fl_end;",
      "\tinarg->lk.type = fl->c.flc_type;",
      "\tinarg->lk.pid = pid;",
      "\tif (flock)",
      "\t\tinarg->lk_flags |= FUSE_LK_FLOCK;",
      "\targs->opcode = opcode;",
      "\targs->nodeid = get_node_id(inode);",
      "\targs->in_numargs = 1;",
      "\targs->in_args[0].size = sizeof(*inarg);",
      "\targs->in_args[0].value = inarg;",
      "}",
      ""
    ]
  },
