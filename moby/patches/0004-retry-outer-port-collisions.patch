+	"testing"
+
+	"gotest.tools/v3/assert"
+)
+
+func TestHardDinDPortError(t *testing.T) {
+	for _, driver := range []string{"harddind-slirp", "builtin"} {
+		c := &PortDriverClient{portDriverName: driver}
+		for _, message := range []string{"host port unavailable: Address already in use", "host port already allocated", "host port unavailable: Permission denied", "unexpected address already in use"} {
+			input := errors.New(message)
+			err := c.portError(input)
+			want := driver == "harddind-slirp" && (message == "host port unavailable: Address already in use" || message == "host port already allocated")
+			assert.Equal(t, errors.Is(err, syscall.EADDRINUSE), want)
+			assert.Equal(t, err.Error(), message)
+			assert.Check(t, errors.Is(err, input))
+		}
+	}
+}
