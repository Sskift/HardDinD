+// RootlessKit's API carries a message, not an errno. Classify only our two
+// explicit collision replies; permission, transport and cleanup errors stay fatal.
+func (c *PortDriverClient) portError(err error) error {
+	if c.portDriverName == "harddind-slirp" {
+		switch strings.ToLower(err.Error()) {
+		case "host port unavailable: address already in use", "host port already allocated":
+			return &portInUseError{err}
+		}
+	}
+	return err
+}
+
+type portInUseError struct{ error }
+
+func (e *portInUseError) Is(target error) bool { return target == syscall.EADDRINUSE }
+func (e *portInUseError) Unwrap() error        { return e.error }
