+package nat
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"syscall"
+	"testing"
+
+	"github.com/moby/moby/v2/daemon/libnetwork/portmapperapi"
+	"gotest.tools/v3/assert"
+)
+
+type retryPDC struct {
+	*fakeAliasPDC
+	calls, removed int
+	fail           error
+	failUntil      int
+	cleanupError   error
+	ports          []int
+}
+
+func (p *retryPDC) AddPort(_ context.Context, _ string, hostIP, _ netip.Addr, port int) (func() error, error) {
+	p.calls++
+	p.ports = append(p.ports, port)
+	// First address succeeds, second fails: every retry must remove the first.
+	if hostIP == netip.MustParseAddr("127.0.0.2") && p.calls <= p.failUntil {
+		return nil, p.fail
+	}
+	return func() error { p.removed++; return p.cleanupError }, nil
+}
+
+func freeRange(t *testing.T, count uint16) uint16 {
+	t.Helper()
+	for attempt := 0; attempt < 32; attempt++ {
+		first, err := net.Listen("tcp4", "127.0.0.1:0")
+		assert.NilError(t, err)
+		port := first.Addr().(*net.TCPAddr).Port
+		listeners := []net.Listener{first}
+		if port+int(count)-1 <= 65535 {
+			for _, ip := range []string{"127.0.0.1", "127.0.0.2"} {
+				for offset := 0; offset < int(count); offset++ {
+					if ip == "127.0.0.1" && offset == 0 {
+						continue
+					}
+					listener, listenErr := net.Listen("tcp4", fmt.Sprintf("%s:%d", ip, port+offset))
+					if listenErr == nil {
+						listeners = append(listeners, listener)
+					}
+				}
+			}
+		}
+		for _, listener := range listeners {
+			listener.Close()
+		}
+		if len(listeners) == 2*int(count) {
+			return uint16(port)
+		}
+	}
+	t.Fatal("no free port range")
+	return 0
+}
+
+func TestHardDinDPortRetry(t *testing.T) {
+	for _, tc := range []struct {
+		name                   string
+		ports                  uint16
+		failUntil              int
+		failure, cleanup       error
+		wantCalls, wantRemoved int
+		success                bool
+	}{
+		{"automatic", 0, 2, syscall.EADDRINUSE, nil, 4, 3, true},
+		{"range", 3, 2, syscall.EADDRINUSE, nil, 4, 3, true},
+		{"fixed", 1, 2, syscall.EADDRINUSE, nil, 2, 1, false},
+		{"exhausted", 2, 1000, syscall.EADDRINUSE, nil, 4, 2, false},
+		{"bounded", 0, 1000, syscall.EADDRINUSE, nil, 128, 64, false},
+		{"other error", 0, 2, syscall.EACCES, nil, 2, 1, false},
+		{"cleanup error", 0, 2, syscall.EADDRINUSE, fmt.Errorf("remove failed"), 2, 1, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var start, end uint16
+			if tc.ports != 0 {
+				start = freeRange(t, tc.ports)
+				end = start + tc.ports - 1
+			}
+			pdc := &retryPDC{fakeAliasPDC: newFakeAliasPDC(), fail: tc.failure,
+				failUntil: tc.failUntil, cleanupError: tc.cleanup}
+			pm := NewPortMapper(Config{RlkClient: pdc})
+			cfg := []portmapperapi.PortBindingReq{reqFor("127.0.0.1"), reqFor("127.0.0.2")}
+			for i := range cfg {
+				cfg[i].HostPort = start
+				cfg[i].HostPortEnd = end
+			}
+			bindings, err := pm.MapPorts(context.Background(), cfg)
+			if tc.success {
+				assert.NilError(t, err)
+				assert.Check(t, pdc.ports[0] != pdc.ports[2], "retry must choose another port")
+				assert.Equal(t, pdc.outstanding(), 2, "aliases retained once across retries")
+				assert.NilError(t, pm.UnmapPorts(context.Background(), bindings))
+			} else {
+				assert.Check(t, errors.Is(err, tc.failure))
+			}
+			assert.Equal(t, pdc.calls, tc.wantCalls)
+			assert.Equal(t, pdc.removed, tc.wantRemoved)
+			assert.Equal(t, pdc.outstanding(), 0)
+			// A fixed reallocation proves guest reservation/socket rollback.
+			pdc.failUntil = 0
+			pdc.cleanupError = nil
+			for i := range cfg {
+				cfg[i].HostPort = uint16(pdc.ports[0])
+				cfg[i].HostPortEnd = cfg[i].HostPort
+			}
+			bindings, err = pm.MapPorts(context.Background(), cfg)
+			assert.NilError(t, err)
+			assert.NilError(t, pm.UnmapPorts(context.Background(), bindings))
+			assert.Equal(t, pdc.outstanding(), 0)
+		})
+	}
+}
