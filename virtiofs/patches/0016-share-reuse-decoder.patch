+#[cfg(test)]
+mod harddind_decoded_tests {
+    use super::*;
+    use crate::passthrough::{Config, PassthroughFs};
+    use vhost_user_backend::bitmap::BitmapMmapRegion;
+    use virtio_queue::{Queue, QueueOwnedT, QueueT};
+    use vm_memory::{Bytes, GuestAddress, GuestMemoryMmap};
+
+    #[repr(C)]
+    #[derive(Clone, Copy, Default)]
+    struct Desc { addr: u64, len: u32, flags: u16, next: u16 }
+    unsafe impl ByteValued for Desc {}
+
+    fn dispatch(header: InHeader, body: &[u8], decoded: bool) -> (String, Vec<u8>) {
+        let mem = GuestMemoryMmap::<BitmapMmapRegion>::from_ranges(&[(GuestAddress(0), 0x10000)]).unwrap();
+        let input = [header.as_slice(), body].concat();
+        mem.write_slice(&input, GuestAddress(0x2000)).unwrap();
+        mem.write_obj(Desc { addr: 0x2000, len: input.len() as u32, flags: 1, next: 1 }, GuestAddress(0x1000)).unwrap();
+        mem.write_obj(Desc { addr: 0x3000, len: 512, flags: 2, next: 0 }, GuestAddress(0x1010)).unwrap();
+        mem.write_obj(1u16, GuestAddress(0x1102)).unwrap();
+        let mut queue = Queue::new(4).unwrap();
+        queue.try_set_desc_table_address(GuestAddress(0x1000)).unwrap();
+        queue.try_set_avail_ring_address(GuestAddress(0x1100)).unwrap();
+        queue.set_ready(true);
+        let desc = queue.iter(&mem).unwrap().next().unwrap();
+        let mut r = Reader::new(&mem, desc.clone()).unwrap();
+        let w = Writer::new(&mem, desc).unwrap();
+        let server = Server::new(PassthroughFs::new(Config::default()).unwrap());
+        let result = if decoded {
+            let h = r.read_obj().unwrap();
+            server.handle_decoded_message::<()>(h, r, w, None)
+        } else { server.handle_message::<()>(r, w, None) };
+        let mut output = vec![0; 512];
+        mem.read_slice(&mut output, GuestAddress(0x3000)).unwrap();
+        (format!("{:?}", result), output)
+    }
+
+    #[test]
+    fn harddind_decoded_dispatch_preserves_errors_and_payload_position() {
+        for (opcode, len, body) in [
+            (65535, 40, vec![]),
+            (Opcode::Getattr as u32, MAX_BUFFER_SIZE + FUSE_BUFFER_HEADER_SIZE + 1, vec![]),
+            (Opcode::Getattr as u32, 56, vec![0; 16]),
+            (Opcode::Getattr as u32, 40, vec![]),
+            (Opcode::Lookup as u32, 42, b"x\0".to_vec()),
+            (Opcode::Lookup as u32, 20, vec![]),
+        ] {
+            let header = InHeader { opcode, len, unique: 42, nodeid: 99999, ..Default::default() };
+            let a = dispatch(header, &body, false);
+            let b = dispatch(header, &body, true);
+            assert_eq!(a, b, "opcode={opcode} len={len}");
+            if a.0.starts_with("Ok(") {
+                assert_ne!(i32::from_ne_bytes(a.1[4..8].try_into().unwrap()), 0);
+                assert_eq!(u64::from_ne_bytes(a.1[8..16].try_into().unwrap()), 42);
+            }
+        }
+    }
+}
