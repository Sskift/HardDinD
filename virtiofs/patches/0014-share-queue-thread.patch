+#[cfg(test)]
+mod harddind_queue_tests {
+    use super::*;
+    use crate::passthrough::{Config, PassthroughFs};
+
+    #[test]
+    fn harddind_zero_workers_preserves_async_locks_and_profiling() {
+        let fs = PassthroughFs::new(Config {
+            shared_flock: true, shared_posix_locks: true, ..Default::default()
+        }).unwrap();
+        let queue = VhostUserFsThread::new(fs, 0, true, false, false).unwrap();
+        assert!(queue.pool.is_none());
+        assert!(queue.profile.is_some());
+        let (tx, rx) = std::sync::mpsc::channel();
+        queue.retries.handle().submit(1, Box::new(move |cancelled| {
+            if cancelled { tx.send(()).unwrap(); }
+            cancelled
+        })).unwrap();
+        queue.retries.cancel_all();
+        rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    }
+}
