         );
         std::fs::remove_dir_all(base).unwrap();
     }
+
+#[cfg(test)]
+mod harddind_negative_tests {
+    use super::*;
+
+    #[test]
+    fn harddind_negative_cache_requires_watch_and_preserves_other_errors() {
+        let base = std::env::temp_dir().join(format!("virtiofs-negative-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        let name = CString::new("missing").unwrap();
+        let ctx = Context { uid: 0.into(), gid: 0.into(), pid: std::process::id() as i32 };
+        for enabled in [false, true] {
+            let changes = if enabled {
+                Some(Arc::new(crate::change_notify::ChangeNotify::new(1001).unwrap()))
+            } else { None };
+            let fs = PassthroughFs::new(Config {
+                root_dir: base.to_str().unwrap().into(), changes: changes.clone(),
+                negative_timeout: Duration::from_secs(60),
+                inode_file_handles: InodeFileHandlesMode::Never, ..Default::default()
+            }).unwrap();
+            fs.init(FsOptions::empty()).unwrap();
+            let result = fs.lookup(ctx, 1, &name);
+            if let Some(changes) = changes {
+                let entry = result.unwrap();
+                assert_eq!(entry.inode, 0);
+                assert_eq!(entry.entry_timeout, Duration::from_secs(60));
+                assert!(changes.watched(1));
+            } else {
+                assert_eq!(result.err().unwrap().raw_os_error(), Some(libc::ENOENT));
+            }
+            assert_eq!(fs.lookup(ctx, u64::MAX, &name).err().unwrap().raw_os_error(), Some(libc::EBADF));
+            // Creation helpers must never turn a failed post-create lookup into a negative entry.
+            assert_eq!(fs.do_lookup(1, &name).err().unwrap().raw_os_error(), Some(libc::ENOENT));
+            std::fs::write(base.join("missing"), b"value").unwrap();
+            assert_ne!(fs.lookup(ctx, 1, &name).unwrap().inode, 0);
+            std::fs::remove_file(base.join("missing")).unwrap();
+        }
+        std::fs::remove_dir(base).unwrap();
+    }
+}
