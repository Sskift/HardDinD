Subject: [PATCH] Allow opt-in negative entry caching with watched parents

--negative-timeout is zero by default and requires --notify-changes.
Only LOOKUP ENOENT is cached; permission and transport errors propagate.

--- a/src/main.rs
+++ b/src/main.rs
@@ -172,6 +172,10 @@
     /// Experimental outer change notifications (requires matching guest driver).
     #[arg(long)]
     notify_changes: bool,
+
+    /// Cache missing names for this many seconds; requires change notifications.
+    #[arg(long, default_value_t = 0, requires = "notify_changes")]
+    negative_timeout: u64,
 
     /// UID accounting for notification watches when started as root.
     #[arg(long, default_value_t = 1001)]
@@ -854,6 +858,7 @@
     let fs_cfg = passthrough::Config {
         changes: changes.clone(),
         entry_timeout: timeout,
+        negative_timeout: Duration::from_secs(opt.negative_timeout),
         attr_timeout: timeout,
         cache_policy: opt.cache,
         root_dir: sandbox.get_root_dir(),
--- a/src/passthrough/mod.rs
+++ b/src/passthrough/mod.rs
@@ -227,6 +227,9 @@
     /// The default value for this option is 5 seconds.
     pub entry_timeout: Duration,
 
+    /// Negative entries need a watched parent; disabled by default.
+    pub negative_timeout: Duration,
+
     /// How long the FUSE client should consider file and directory attributes to be valid. If the
     /// attributes of a file or directory can only be modified by the FUSE client (i.e., the file
     /// system has exclusive access), then this should be set to a large value.
@@ -415,6 +418,7 @@
     fn default() -> Self {
         Config {
             entry_timeout: Duration::from_secs(5),
+            negative_timeout: Duration::ZERO,
             attr_timeout: Duration::from_secs(5),
             cache_policy: Default::default(),
             changes: None,
@@ -1771,7 +1775,16 @@
     }
 
     fn lookup(&self, _ctx: Context, parent: Inode, name: &CStr) -> io::Result<Entry> {
-        self.do_lookup(parent, name)
+        match self.do_lookup(parent, name) {
+            Err(e) if e.raw_os_error() == Some(libc::ENOENT)
+                && self.cfg.changes.is_some() && !self.cfg.negative_timeout.is_zero() => {
+                Ok(Entry {
+                    inode: 0, generation: 0, attr: Default::default(),
+                    attr_timeout: Duration::ZERO, entry_timeout: self.cfg.negative_timeout,
+                })
+            }
+            result => result,
+        }
     }
 
     fn forget(&self, _ctx: Context, inode: Inode, count: u64) {
