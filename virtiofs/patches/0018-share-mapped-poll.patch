+#[cfg(test)]
+mod coherence_tests {
+    use super::*;
+    #[test]
+    fn harddind_overflow_recovers_all_watches_and_expires_names() {
+        let mut state = State { recovery: true, ..Default::default() };
+        state.inodes.insert(1, 11);
+        state.inodes.insert(2, 12);
+        state.pending.push_back(vec![99]);
+        let mut event = (-1i32).to_ne_bytes().to_vec();
+        event.extend_from_slice(&libc::IN_Q_OVERFLOW.to_ne_bytes());
+        event.extend_from_slice(&[0; 8]);
+        state.events(&event).unwrap();
+        assert!(!state.failed);
+        assert_eq!(state.pending.len(), 3);
+        assert_eq!(state.pending[0], packet(RESET, &[]));
+        assert_eq!(&state.pending[1][16..24], &1u64.to_ne_bytes());
+        assert_eq!(&state.pending[2][16..24], &2u64.to_ne_bytes());
+        assert_eq!(state.inodes.len(), 2);
+        state.watches.insert(11, BTreeSet::from([1]));
+        state.pending.clear();
+        event[..4].copy_from_slice(&11i32.to_ne_bytes());
+        event[4..8].copy_from_slice(&libc::IN_MODIFY.to_ne_bytes());
+        state.events(&event).unwrap();
+        assert_eq!(state.pending.len(), 2);
+        assert_eq!(&state.pending[0][16..24], &1u64.to_ne_bytes());
+    }
+
+    #[test]
+    fn harddind_mapped_content_detects_repeated_dirty_stores_and_limits() {
+        let path = std::env::temp_dir().join(format!("harddind-map-{}", std::process::id()));
+        let file = std::fs::OpenOptions::new().create_new(true).read(true).write(true).open(&path).unwrap();
+        file.set_len(8192).unwrap();
+        let changes = ChangeNotify::new(1001).unwrap();
+        assert!(changes.track_mapping(7, 3, &file, 0, 0, 2).is_err());
+        assert!(changes.track_mapping(7, 3, &file, u64::MAX, 8192, 2).is_err());
+        assert!(changes.track_mapping(7, 3, &file, 0, POLL_BUDGET as u64 + 1, 2).is_err());
+        changes.track_mapping(7, 3, &file, 0, 8192, 2).unwrap();
+        let addr = unsafe { libc::mmap(std::ptr::null_mut(), 8192, libc::PROT_READ | libc::PROT_WRITE,
+                                      libc::MAP_SHARED, file.as_raw_fd(), 0) };
+        assert_ne!(addr, libc::MAP_FAILED);
+        for byte in 1..=32u8 {
+            unsafe { std::ptr::write_volatile(addr.cast::<u8>().add(4096), byte); }
+            let mut state = changes.state.lock().unwrap();
+            let mapping = state.mapped.values_mut().next().unwrap();
+            let packet = mapping.poll().unwrap().unwrap();
+            assert_eq!(&packet[24..32], &4096i64.to_ne_bytes());
+            assert_eq!(&packet[32..40], &4096i64.to_ne_bytes());
+            assert!(mapping.poll().unwrap().is_none());
+        }
+        unsafe { libc::munmap(addr, 8192); }
+        changes.track_mapping(7, 4, &file, 4096, 4096, 2).unwrap();
+        assert_eq!(changes.state.lock().unwrap().mapped.len(), 1);
+        changes.release_mapping(3);
+        assert_eq!(changes.state.lock().unwrap().mapped.len(), 1);
+        changes.release_mapping(4);
+        assert!(changes.state.lock().unwrap().mapped.is_empty());
+        std::fs::remove_file(path).unwrap();
+    }
+}
