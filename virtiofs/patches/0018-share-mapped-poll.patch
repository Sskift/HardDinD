+        payload.extend_from_slice(&(offset as i64).to_ne_bytes());
+        payload.extend_from_slice(&(length as i64).to_ne_bytes());
+        state.pending.push_back(packet(2, &payload));
+        self.wake.write(1)?;
+        Ok(())
+    }
