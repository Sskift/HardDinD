+impl MappedRange {
+    fn stamp(file: &std::fs::File) -> io::Result<(u64, i64, i64, i64, i64)> {
+        use std::os::unix::fs::MetadataExt;
+        let st = file.metadata()?;
+        Ok((st.len(), st.mtime(), st.mtime_nsec(), st.ctime(), st.ctime_nsec()))
+    }
+
+    fn read(file: &std::fs::File, offset: u64, length: usize, mut data: Vec<u8>) -> io::Result<Vec<u8>> {
+        use std::os::unix::fs::FileExt;
+        data.resize(length, 0);
+        let mut done = 0;
+        while done < data.len() {
+            match file.read_at(&mut data[done..], offset + done as u64) {
+                Ok(0) => break,
+                Ok(n) => done += n,
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                Err(e) => return Err(e),
+            }
+        }
+        data.truncate(done);
+        Ok(data)
+    }
+
+    fn poll(&mut self) -> io::Result<Option<Vec<u8>>> {
+        let started = std::time::Instant::now();
+        let cpu_started = thread_cpu_ns();
+        let stamp = Self::stamp(&self.file)?;
+        let mut changed = stamp != self.stamp;
+        let mut range = (self.offset as i64, self.length as i64);
+        if let Some(previous) = &mut self.contents {
+            let data = Self::read(&self.file, self.offset, self.length, std::mem::take(&mut self.scratch))?;
+            if data == *previous {
+                range = (-1, 0); // Attribute-only change.
+            } else {
+                changed = true;
+                if data.len() == previous.len() {
+                    let first = data.chunks(4096).zip(previous.chunks(4096)).position(|(a, b)| a != b).unwrap();
+                    let last = data.chunks(4096).zip(previous.chunks(4096)).rposition(|(a, b)| a != b).unwrap();
+                    range = ((self.offset + (first * 4096) as u64) as i64, ((last - first + 1) * 4096) as i64);
+                }
+            }
+            self.scratch = std::mem::replace(previous, data);
+        }
+        self.stamp = stamp;
+        self.scans += 1;
+        self.scan_cpu_ns += thread_cpu_ns().saturating_sub(cpu_started);
+        self.scan_ns += started.elapsed().as_nanos();
+        if !changed { return Ok(None); }
+        let mut payload = self.inode.to_ne_bytes().to_vec();
+        payload.extend_from_slice(&range.0.to_ne_bytes());
+        payload.extend_from_slice(&range.1.to_ne_bytes());
+        Ok(Some(packet(2, &payload)))
+    }
+}
