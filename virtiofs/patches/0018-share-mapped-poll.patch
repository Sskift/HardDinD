+        fs.init(FsOptions::empty()).unwrap();
+        let ctx = Context { uid: 0.into(), gid: 0.into(), pid: std::process::id() as i32 };
+        assert_eq!(fs.getattr(ctx, 1, None).unwrap().1, Duration::ZERO);
