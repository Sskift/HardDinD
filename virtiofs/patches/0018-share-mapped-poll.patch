+    pub fn fault(&self, action: u64) -> io::Result<()> {
+        let mut state = self.state.lock().unwrap();
+        if !state.recovery { return Err(io::Error::from_raw_os_error(libc::EOPNOTSUPP)); }
+        match action {
+            0 => {
+                state.watch_exhausted = false;
+                if state.drop_events { state.drop_events = false; state.recover(); }
+            },
+            1 => state.watch_exhausted = true,
+            2 => {
+                // Simulate the lost records preceding a real queue overflow.
+                let mut buf = [0u8; 65536];
+                loop {
+                    let n = unsafe { libc::read(self.fd.as_raw_fd(), buf.as_mut_ptr().cast(), buf.len()) };
+                    if n < 0 && io::Error::last_os_error().kind() == io::ErrorKind::WouldBlock { break; }
+                    if n <= 0 { return Err(io::Error::last_os_error()); }
+                    state.events(&buf[..n as usize])?;
+                }
+                state.drop_events = false;
+                eprintln!("HARDDIND_NOTIFY_TEST_DROP {}", state.dropped_events);
+                let mut event = (-1i32).to_ne_bytes().to_vec();
+                event.extend_from_slice(&libc::IN_Q_OVERFLOW.to_ne_bytes());
+                event.extend_from_slice(&[0; 8]);
+                state.events(&event)?;
+            },
+            3 => { state.drop_events = true; state.dropped_events = 0; },
+            _ => return Err(io::Error::from_raw_os_error(libc::EINVAL)),
+        }
+        self.wake.write(1)?;
+        Ok(())
+    }
