+    fn harddind_exhausted_watch_leaves_every_response_uncached() {
+        let base = std::env::temp_dir().join(format!("virtiofs-watch-full-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        std::fs::write(base.join("file"), b"one").unwrap();
+        let changes = Arc::new(crate::change_notify::ChangeNotify::new(1001).unwrap());
+        changes.negotiated(crate::change_notify::RECOVERY_FEATURE);
+        changes.fault(1).unwrap();
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(), changes: Some(changes.clone()),
+            entry_timeout: Duration::from_secs(86400), attr_timeout: Duration::from_secs(86400),
+            negative_timeout: Duration::from_secs(86400), cache_policy: CachePolicy::Always,
+            inode_file_handles: InodeFileHandlesMode::Never, ..Default::default()
