+                return Ok(());
+            }
+        }
+        let covered: Vec<_> = state.mapped.keys().filter(|(id, start, len)| *id == inode
+            && offset <= *start && offset + length as u64 >= *start + *len as u64).copied().collect();
+        let bytes: usize = state.mapped.iter().filter(|(key, m)| m.contents.is_some() && !covered.contains(key))
+            .map(|(_, m)| m.length).sum();
+        if mode == 2 && bytes + length > POLL_BUDGET { return Err(io::Error::from_raw_os_error(libc::ENOMEM)); }
+        let stamp = MappedRange::stamp(file)?;
+        let contents = if mode == 2 { Some(MappedRange::read(file, offset, length, Vec::new())?) } else { None };
+        let file = file.try_clone()?;
+        let mut handles = BTreeSet::from([handle]);
+        for key in covered {
+            handles.extend(state.mapped.remove(&key).unwrap().handles);
+        }
+        state.mapped.insert(key, MappedRange {
+            inode, handles, file, offset, length, contents, stamp, scratch: Vec::new(),
+            scans: 0, scan_ns: 0, scan_cpu_ns: 0,
+        });
