+    let changes = ChangeNotify::new(if uid == 0 { 1001 } else { uid }).unwrap();
+    changes.allow_uncached_recovery(true);
+    changes.fault(1).unwrap();
+    assert!(changes.state.lock().unwrap().watch_exhausted);
+    changes.fault(0).unwrap();
+    assert!(!changes.state.lock().unwrap().watch_exhausted);
+}
