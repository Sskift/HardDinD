 mod harddind_tests {
     use super::*;
     #[test]
+    fn harddind_profile_clock_samples_are_bounded_and_ordered() {
+        let profile = Arc::new(RequestProfile::default());
+        for unique in 1..=4100 {
+            let mut sample = profile.begin(1, u32::MAX, unique);
+            let start = sample.start();
+            sample.end_service(start);
+            sample.returning();
+            sample.finish(Instant::now());
+        }
+        let rows = profile.0.lock().unwrap();
+        let traces = &rows[&(1, u32::MAX)].traces;
+        assert_eq!(traces.len(), 4096);
+        assert_eq!(traces.front().unwrap()[0], 5);
+        assert_eq!(traces.back().unwrap()[0], 4100);
+        for trace in traces { assert!(trace[1..].windows(2).all(|t| t[0] <= t[1])); }
+    }
+
