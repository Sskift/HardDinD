Subject: [PATCH] Record bounded host-clock request latency samples when profiling

Only --profile-requests enables collection. Match unique IDs with the UML
share-profile candidate to distinguish queueing, service, reply publication
and guest completion. Keep the last 4096 LOOKUP and GETATTR samples.

--- a/src/request_profile.rs
+++ b/src/request_profile.rs
@@ -1,11 +1,18 @@
 // SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
 //! Optional aggregate diagnostics. No timing or mutex updates when disabled.
-use std::collections::BTreeMap;
+use std::collections::{BTreeMap, VecDeque};
 use std::sync::{Arc, Mutex};
 use std::time::{Duration, Instant};
 
+fn host_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    assert_eq!(unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) }, 0);
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
