+#[cfg(test)]
+mod getattr_cache_tests {
+    use super::*;
+
+    #[test]
+    fn harddind_getattr_cache_leaves_initial_entries_uncached() {
+        let base = std::env::temp_dir().join(format!("virtiofs-attrs-{}", std::process::id()));
+        std::fs::create_dir(&base).unwrap();
+        std::fs::write(base.join("file"), b"one").unwrap();
+        let changes = Arc::new(crate::change_notify::ChangeNotify::new(1001).unwrap());
+        let fs = PassthroughFs::new(Config {
+            root_dir: base.to_str().unwrap().into(), changes: Some(changes.clone()),
+            entry_timeout: Duration::ZERO, attr_timeout: Duration::from_secs(60),
+            cache_policy: CachePolicy::Never, getattr_cache_only: true,
+            inode_file_handles: InodeFileHandlesMode::Never, ..Default::default()
+        }).unwrap();
+        fs.init(FsOptions::empty()).unwrap();
+        let ctx = Context { uid: 0.into(), gid: 0.into(), pid: std::process::id() as i32 };
+        assert_eq!(fs.getattr(ctx, 1, None).unwrap().1, Duration::from_secs(60));
+        assert!(changes.watched(1));
+        let name = CString::new("file").unwrap();
+        let entry = fs.lookup(ctx, 1, &name).unwrap();
+        assert_eq!(entry.entry_timeout, Duration::ZERO);
+        assert_eq!(entry.attr_timeout, Duration::ZERO);
+        assert!(changes.watched(entry.inode));
+        std::fs::write(base.join("file"), b"changed").unwrap();
+        let (attr, timeout) = fs.getattr(ctx, entry.inode, None).unwrap();
+        assert_eq!(attr.size, 7);
+        assert_eq!(timeout, Duration::from_secs(60));
+        std::os::unix::fs::symlink("file", base.join("link")).unwrap();
+        let link = fs.lookup(ctx, 1, &CString::new("link").unwrap()).unwrap();
+        assert_eq!(fs.getattr(ctx, link.inode, None).unwrap().1, Duration::ZERO);
+        assert!(PassthroughFs::new(Config { getattr_cache_only: true, ..Default::default() }).is_err());
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
