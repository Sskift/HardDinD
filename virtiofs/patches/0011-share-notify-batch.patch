+#[cfg(test)]
+mod batch_tests {
+    use super::*;
+
+    #[test]
+    fn harddind_notify_batch_preserves_order_under_partial_delivery() {
+        let mut state = State { batch: true, ..Default::default() };
+        let received = Arc::new(Mutex::new(Vec::new()));
+        let out = received.clone();
+        state.sink = Some(Box::new(move |messages| {
+            assert!(messages.len() <= 32);
+            let sent = messages.len().min(7);
+            out.lock().unwrap().extend_from_slice(&messages[..sent]);
+            Ok(sent)
+        }));
+        let expected: Vec<_> = (0u64..1000).map(|i| i.to_ne_bytes().to_vec()).collect();
+        state.pending.extend(expected.clone());
+        state.flush().unwrap();
+        assert_eq!(*received.lock().unwrap(), expected);
+        assert!(state.pending.is_empty());
+        state.pending.push_back(vec![1]);
+        state.sink = Some(Box::new(|_| Ok(2)));
+        assert!(state.flush().is_err());
+        assert_eq!(state.pending.len(), 1);
+    }
+}
